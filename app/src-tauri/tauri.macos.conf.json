{
  "build": {
    "beforeDevCommand": "bash scripts/stage-sidecars-mac.sh && npm run dev",
    "beforeBuildCommand": "bash scripts/stage-sidecars-mac.sh && npm run build"
  },
  "bundle": {
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "resources": {
      "../sandbox/target/release/draggy-sandbox.exe": null,
      "binaries/node-res/node": "node/node",
      "binaries/npm/": "npm/"
    },
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "windows": null
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Lucki74/draggy/releases/latest/download/latest-macos.json"
      ]
    }
  }
}
