{
  "build": {
    "beforeDevCommand": "bash scripts/stage-sidecars-linux.sh && npm run dev",
    "beforeBuildCommand": "bash scripts/stage-sidecars-linux.sh && npm run build"
  },
  "bundle": {
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "resources": {
      "../sandbox/target/release/draggy-sandbox.exe": null
    },
    "windows": null
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Lucki74/draggy/releases/latest/download/latest-linux.json"
      ]
    }
  }
}
