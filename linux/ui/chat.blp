using Gtk 4.0;
using Adw 1;

template $DraggyChat: Gtk.Box {
  orientation: vertical;

  Gtk.ScrolledWindow scroller {
    vexpand: true;
    hscrollbar-policy: never;

    Adw.Clamp {
      maximum-size: 760;
      tightening-threshold: 560;

      Gtk.Box transcript {
        orientation: vertical;
        spacing: 16;
        margin-top: 16;
        margin-bottom: 16;
        margin-start: 16;
        margin-end: 16;
      }
    }
  }

  Adw.Clamp {
    maximum-size: 760;
    tightening-threshold: 560;

    Gtk.Box plan {
      orientation: vertical;
      spacing: 2;
      visible: false;
      margin-start: 16;
      margin-end: 16;
      styles ["card"]

      Gtk.Box {
        margin-top: 6;
        margin-start: 10;
        margin-end: 6;

        Gtk.Label plan_title {
          label: "Plan";
          hexpand: true;
          xalign: 0;
          styles ["heading"]
        }

        Gtk.Button plan_clear {
          icon-name: "edit-clear-symbolic";
          tooltip-text: "Clear plan";
          styles ["flat", "circular"]
        }
      }

      Gtk.Box plan_steps {
        orientation: vertical;
        spacing: 2;
        margin-start: 10;
        margin-end: 10;
        margin-bottom: 8;
      }
    }
  }

  Adw.Clamp {
    maximum-size: 760;
    tightening-threshold: 560;

    Gtk.Box {
      spacing: 8;
      margin-top: 8;
      margin-bottom: 12;
      margin-start: 16;
      margin-end: 16;
      styles ["composer"]

      Gtk.Button attach {
        icon-name: "mail-attachment-symbolic";
        tooltip-text: "Attach a Word, PowerPoint, Excel or PDF file";
        valign: end;
        styles ["flat", "circular"]
      }

      Gtk.ToggleButton speak {
        icon-name: "audio-speakers-symbolic";
        tooltip-text: "Read replies aloud";
        valign: end;
        styles ["flat", "circular"]
      }

      Gtk.ScrolledWindow {
        hexpand: true;
        propagate-natural-height: true;
        max-content-height: 160;
        hscrollbar-policy: never;

        Gtk.TextView input {
          wrap-mode: word_char;
          accepts-tab: false;
          top-margin: 8;
          bottom-margin: 8;
          left-margin: 10;
          right-margin: 10;

          accessibility {
            label: "Message";
          }
        }
      }

      Gtk.Button send {
        icon-name: "mail-send-symbolic";
        tooltip-text: "Send (Enter)";
        valign: end;
        styles ["suggested-action", "circular"]
      }

      Gtk.Button stop {
        icon-name: "media-playback-stop-symbolic";
        tooltip-text: "Stop";
        valign: end;
        visible: false;
        styles ["destructive-action", "circular"]
      }
    }
  }
}
