using Gtk 4.0;
using Adw 1;

template $DraggyWindow: Adw.ApplicationWindow {
  title: "Draggy";
  default-width: 1100;
  default-height: 720;
  width-request: 360;
  height-request: 400;

  Adw.Breakpoint {
    condition ("max-width: 640sp")

    setters {
      split.collapsed: true;
    }
  }

  content: Adw.ToastOverlay toasts {
    Adw.NavigationSplitView split {
      min-sidebar-width: 220;
      max-sidebar-width: 280;

      sidebar: Adw.NavigationPage {
        title: "Draggy";

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {
            [start]
            Gtk.Button {
              icon-name: "list-add-symbolic";
              tooltip-text: "New conversation";
              action-name: "win.new-conversation";
            }

            title-widget: Adw.WindowTitle {
              title: "Draggy";
            };

            [end]
            Gtk.Button {
              icon-name: "emblem-system-symbolic";
              tooltip-text: "Settings";
              action-name: "win.settings";
            }
          }

          content: Gtk.Box {
            orientation: vertical;

            Gtk.ListBox sections {
              selection-mode: single;
              styles ["navigation-sidebar"]

              Gtk.ListBoxRow {
                name: "chat";

                Gtk.Label {
                  label: "Chat";
                  xalign: 0;
                }
              }

              Gtk.ListBoxRow {
                name: "code";

                Gtk.Label {
                  label: "Code";
                  xalign: 0;
                }
              }

              Gtk.ListBoxRow {
                name: "talk";

                Gtk.Label {
                  label: "Talk";
                  xalign: 0;
                }
              }

              Gtk.ListBoxRow {
                name: "models";

                Gtk.Label {
                  label: "Models";
                  xalign: 0;
                }
              }

              Gtk.ListBoxRow {
                name: "browser";

                Gtk.Label {
                  label: "Browser";
                  xalign: 0;
                }
              }

              Gtk.ListBoxRow {
                name: "google";

                Gtk.Label {
                  label: "Google";
                  xalign: 0;
                }
              }

              Gtk.ListBoxRow {
                name: "skills";

                Gtk.Label {
                  label: "Skills";
                  xalign: 0;
                }
              }

              Gtk.ListBoxRow {
                name: "servers";

                Gtk.Label {
                  label: "Servers";
                  xalign: 0;
                }
              }

              Gtk.ListBoxRow {
                name: "terminal";

                Gtk.Label {
                  label: "Terminal";
                  xalign: 0;
                }
              }

              Gtk.ListBoxRow {
                name: "files";

                Gtk.Label {
                  label: "Files";
                  xalign: 0;
                }
              }

              Gtk.ListBoxRow {
                name: "search";

                Gtk.Label {
                  label: "Search";
                  xalign: 0;
                }
              }

              Gtk.ListBoxRow {
                name: "diff";

                Gtk.Label {
                  label: "Diff";
                  xalign: 0;
                }
              }

              Gtk.ListBoxRow {
                name: "stats";

                Gtk.Label {
                  label: "Stats";
                  xalign: 0;
                }
              }

              Gtk.ListBoxRow {
                name: "canvas";

                Gtk.Label {
                  label: "Canvas";
                  xalign: 0;
                }
              }

              Gtk.ListBoxRow {
                name: "images";

                Gtk.Label {
                  label: "Images";
                  xalign: 0;
                }
              }

              Gtk.ListBoxRow {
                name: "diagnostics";

                Gtk.Label {
                  label: "Diagnostics";
                  xalign: 0;
                }
              }
            }

            Gtk.Label {
              label: "History";
              xalign: 0;
              margin-top: 16;
              margin-bottom: 4;
              margin-start: 16;
              margin-end: 16;
              styles ["caption-heading", "dim-label"]
            }

            Gtk.ScrolledWindow {
              vexpand: true;
              hscrollbar-policy: never;

              Gtk.ListBox history {
                selection-mode: single;
                styles ["navigation-sidebar"]
              }
            }
          };
        };
      };

      content: Adw.NavigationPage {
        title: "Chat";

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {}

          content: Gtk.Stack pages {
            Gtk.StackPage {
              name: "chat";

              child: $DraggyChat chat {};
            }

            Gtk.StackPage {
              name: "code";

              child: Adw.StatusPage {
                title: "Code";
                description: "Work on a folder with a model.";
              };
            }

            Gtk.StackPage {
              name: "talk";

              child: Adw.StatusPage {
                title: "Talk";
                description: "Voice is not available yet.";
              };
            }
          };
        };
      };
    }
  };
}
