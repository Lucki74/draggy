        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте OpenAI, Anthropic, Google и других со своим API-ключом или сервер, который уже запущен у вас, например Ollama или LM Studio."
          }
        }
      }
    },
    "A cloud provider receives your conversations and the files the model reads.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
