    "Use OpenAI, Anthropic, Google and others with your own API key, or a server you already run, such as Ollama or LM Studio.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez OpenAI, Anthropic, Google et d'autres avec votre propre clé d'API, ou un serveur que vous faites déjà tourner, comme Ollama ou LM Studio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa OpenAI, Anthropic, Google y otros con tu propia clave de API, o un servidor que ya tengas en marcha, como Ollama o LM Studio."
