    "Pick a folder that holds a SKILL.md. The model loads a skill when a request matches its description.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un dossier contenant un SKILL.md. Le modèle charge une compétence lorsqu’une demande correspond à sa description."
