{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "What the main window may call. The browser pane webview gets no capability at all.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-ipc-invoke",
    "allow-ipc-send",
    "opener:default",
    "dialog:default"
  ]
}
