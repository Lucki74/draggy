{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "What the main webview may call. Matched by webview label only, so the browser pane webviews never get it.",
  "webviews": ["main"],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-ipc-invoke",
    "allow-ipc-send",
    "allow-gateway-info",
    "opener:default",
    "dialog:default"
  ]
}
