{
  "name": "draggy",
  "author": "The Draggy authors",
  "description": "A desktop AI assistant that talks, browses and works with your files all on local models.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "homepage": "https://draggy.org",
  "private": true,
  "version": "3.0.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/main-licenses.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "npm run stage:sidecars && tauri build --config src-tauri/tauri.release.conf.json",
    "fetch:python": "node scripts/fetch-python.cjs",
    "stage:sidecars": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stage-sidecars.ps1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "logs": "node scripts/logs.cjs",
    "logs:turn": "node scripts/logs.cjs --turn",
    "check": "npm run typecheck && npm run lint && npm run test",
    "icons": "node scripts/make-icons.mjs",
    "skills:lint": "node scripts/skills/lint.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geologica": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "docx": "^9.15.1",
    "docx-preview": "0.4.1"
  },
  "overrides": {
    "image-size": "^2.0.3",
    "uuid": "^11.1.1",
    "sharp": "$sharp",
    "katex": "$katex",
    "shell-quote": "^1.12.0",
    "source-map-js": "^1.2.2",
    "onnxruntime-web": "$onnxruntime-web"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@huggingface/transformers": "^4.3.2",
    "@jitsi/rnnoise-wasm": "0.2.1",
    "@phosphor-icons/core": "^2.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.6.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "framer-motion": "^14.9.0",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "katex": "^0.19.1",
    "license-checker-rseidelsohn": "^5.0.1",
    "onnxruntime-web": "1.31.1",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "rollup-plugin-license": "^3.7.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  }
}
