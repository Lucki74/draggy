{
  "name": "draggy",
  "author": "The Draggy authors",
  "description": "A desktop AI assistant that talks, browses and works with your files all on local models.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "homepage": "https://draggy.org",
  "private": true,
  "version": "3.0.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/main-licenses.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "electron:build": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --publish never",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "logs": "node scripts/logs.cjs",
    "logs:turn": "node scripts/logs.cjs --turn",
    "check": "npm run typecheck && npm run lint && npm run test",
    "electron:build:mac": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --publish never",
    "electron:build:linux": "npm run build && electron-builder --linux --publish never",
    "electron:build:all": "npm run build && electron-builder -mwl --publish never",
    "icons": "node scripts/make-icons.mjs",
    "bench:engine": "node scripts/bench-engine.cjs"
  },
  "build": {
    "appId": "com.draggy.app",
    "productName": "Draggy",
    "copyright": "Copyright © 2026 The Draggy authors",
    "directories": {
      "output": "dist-electron"
    },
    "icon": "electron/icon.ico",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/**/*.test.js",
      "package.json",
      "LICENSE",
      "NOTICE",
      "src/providers/icons/LICENSE",
      "src/ui/fonts/LICENSE",
      "src/ui/icons/LICENSE",
      "!node_modules/pdfjs-dist/build/**",
      "!node_modules/pdfjs-dist/web/**",
      "!node_modules/pdfjs-dist/image_decoders/**",
      "!node_modules/pdfjs-dist/types/**",
      "!node_modules/pdfjs-dist/**/*.map"
    ],
    "asarUnpack": [
      "node_modules/pdfjs-dist/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "draggy_setup.exe",
      "icon": "electron/icon.ico",
      "legalTrademarks": "",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "artifactName": "draggy_setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "artifactName": "Draggy-${arch}.${ext}",
      "darkModeSupport": true,
      "icon": "build/icon.icns",
      "identity": "-",
      "notarize": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "artifactName": "Draggy-${arch}.${ext}",
      "maintainer": "The Draggy authors <215649322+Lucki74@users.noreply.github.com>",
      "icon": "build/icons"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Lucki74",
        "repo": "draggy"
      }
    ],
    "detectUpdateChannel": false
  },
  "dependencies": {
    "@fontsource-variable/geologica": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@ghostery/adblocker-electron": "^2.18.2",
    "docx": "^9.9.0",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "pdfjs-dist": "^6.4.299",
    "pptxgenjs": "^4.0.1",
    "semver": "^7.8.5"
  },
  "overrides": {
    "image-size": "^2.0.3",
    "uuid": "^11.1.1",
    "sharp": "$sharp",
    "katex": "$katex",
    "shell-quote": "^1.12.0",
    "source-map-js": "^1.2.2",
    "global-agent": "^4.1.3",
    "onnxruntime-web": "$onnxruntime-web",
    "exceljs": {
      "unzipper": "^0.12.5"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@huggingface/transformers": "^3.8.1",
    "@jitsi/rnnoise-wasm": "0.2.1",
    "@phosphor-icons/core": "^2.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^42.11.10",
    "electron-builder": "^26.8.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "framer-motion": "^14.0.0",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "katex": "^0.19.0",
    "license-checker-rseidelsohn": "^5.0.1",
    "onnxruntime-web": "1.30.0",
    "postcss": "^8.5.29",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "rollup-plugin-license": "^3.7.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^4.1.11",
    "wait-on": "^9.5.1"
  }
}
