{
  "area": "agentLoop",
  "description": "Skill helpers of skills/skills.ts: slash commands, the loaded set and the text the model is given.",
  "cases": [
    {
      "name": "a slash command starts its skill with the request after it",
      "input": {
        "op": "skillInvocation",
        "text": "/docx a packing list",
        "skills": [
          {
            "id": "docx",
            "name": "docx",
            "description": "Creates Word documents."
          },
          {
            "id": "code-review",
            "name": "Code review",
            "description": "Reviews code changes.",
            "modelInvocable": false
          },
          {
            "id": "Dock-Ops",
            "name": "Dock Ops",
            "description": "Operates docks."
          }
        ]
      },
      "expected": {
        "id": "docx",
        "request": "a packing list"
      }
    },
    {
      "name": "a command alone has an empty request",
      "input": {
        "op": "skillInvocation",
        "text": "/docx",
        "skills": [
          {
            "id": "docx",
            "name": "docx",
            "description": "Creates Word documents."
          },
          {
            "id": "code-review",
            "name": "Code review",
            "description": "Reviews code changes.",
            "modelInvocable": false
          },
          {
            "id": "Dock-Ops",
            "name": "Dock Ops",
            "description": "Operates docks."
          }
        ]
      },
      "expected": {
        "id": "docx",
        "request": ""
      }
    },
    {
      "name": "the command ignores case and keeps inner spacing",
      "input": {
        "op": "skillInvocation",
        "text": "/DOCX  spaced  out ",
        "skills": [
          {
            "id": "docx",
            "name": "docx",
            "description": "Creates Word documents."
          },
          {
            "id": "code-review",
            "name": "Code review",
            "description": "Reviews code changes.",
            "modelInvocable": false
          },
          {
            "id": "Dock-Ops",
            "name": "Dock Ops",
            "description": "Operates docks."
          }
        ]
      },
      "expected": {
        "id": "docx",
        "request": "spaced  out"
      }
    },
    {
      "name": "a mixed case id is matched in lower case",
      "input": {
        "op": "skillInvocation",
        "text": "/dock-ops go",
        "skills": [
          {
            "id": "docx",
            "name": "docx",
            "description": "Creates Word documents."
          },
          {
            "id": "code-review",
            "name": "Code review",
            "description": "Reviews code changes.",
            "modelInvocable": false
          },
          {
            "id": "Dock-Ops",
            "name": "Dock Ops",
            "description": "Operates docks."
          }
        ]
      },
      "expected": {
        "id": "Dock-Ops",
        "request": "go"
      }
    },
    {
      "name": "a message that only mentions a skill is not a command",
      "input": {
        "op": "skillInvocation",
        "text": "make a docx for me",
