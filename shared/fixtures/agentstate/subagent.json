{
  "area": "subagent",
  "description": "Subagent: choosing the smaller explorer model and the outcome of one exploration (answer, empty answer, failure, timeout). Pure choice in src/agent/subagent.ts; explore is driven with the nested turn stubbed, and a timeout uses fake timers.",
  "cases": [
    {
      "name": "a much smaller model is chosen over the loaded one",
      "input": {
        "op": "pickExploreModel",
        "installed": [
          {
            "name": "qwen3:30b",
            "size": 30,
            "capabilities": [
              "tools"
            ]
          },
          {
            "name": "qwen3:4b",
            "size": 4,
            "capabilities": [
              "tools"
            ]
          }
        ],
        "current": "qwen3:30b"
      },
      "expected": "qwen3:4b"
    },
    {
      "name": "the loaded model is kept when the alternative is barely smaller",
      "input": {
        "op": "pickExploreModel",
        "installed": [
          {
            "name": "qwen3:8b",
            "size": 8,
            "capabilities": [
              "tools"
            ]
          },
          {
            "name": "qwen3:7b",
            "size": 7,
            "capabilities": [
              "tools"
            ]
          }
        ],
        "current": "qwen3:8b"
      },
      "expected": "qwen3:8b"
    },
    {
      "name": "a model that cannot call tools is ignored",
      "input": {
        "op": "pickExploreModel",
        "installed": [
          {
            "name": "qwen3:8b",
            "size": 8,
            "capabilities": [
              "tools"
            ]
          },
          {
            "name": "tiny:1b",
            "size": 1,
            "capabilities": []
          }
        ],
        "current": "qwen3:8b"
      },
      "expected": "qwen3:8b"
    },
    {
      "name": "an embedding model is ignored",
      "input": {
        "op": "pickExploreModel",
        "installed": [
          {
            "name": "qwen3:8b",
            "size": 8,
            "capabilities": [
              "tools"
            ]
          },
          {
            "name": "nomic-embed-text",
            "size": 1,
            "capabilities": [
              "tools",
              "embedding"
            ]
          }
        ],
        "current": "qwen3:8b"
      },
      "expected": "qwen3:8b"
    },
    {
      "name": "the current model is kept when nothing else is installed",
      "input": {
        "op": "pickExploreModel",
        "installed": [],
        "current": "qwen3:8b"
      },
      "expected": "qwen3:8b"
    },
    {
      "name": "a model with no size is ignored",
      "input": {
        "op": "pickExploreModel",
        "installed": [
          {
            "name": "qwen3:8b",
            "size": 8,
            "capabilities": [
              "tools"
            ]
          },
          {
            "name": "empty",
            "size": 0,
            "capabilities": [
              "tools"
            ]
          }
        ],
        "current": "qwen3:8b"
      },
      "expected": "qwen3:8b"
    },
    {
      "name": "an unloaded smallest model is chosen when the current one is not installed",
      "input": {
        "op": "pickExploreModel",
        "installed": [
          {
            "name": "qwen3:8b",
            "size": 8,
            "capabilities": [
              "tools"
            ]
          },
          {
            "name": "qwen3:2b",
            "size": 2,
            "capabilities": [
              "tools"
            ]
          }
        ],
        "current": "other"
      },
      "expected": "qwen3:2b"
    },
    {
      "name": "a tie goes to the first model listed",
      "input": {
        "op": "pickExploreModel",
        "installed": [
          {
            "name": "a",
            "size": 3,
            "capabilities": [
              "tools"
            ]
          },
          {
            "name": "b",
            "size": 3,
            "capabilities": [
              "tools"
            ]
          }
        ],
        "current": "x"
      },
      "expected": "a"
    },
    {
      "name": "the explore timeout is two minutes",
      "input": {
        "op": "constants"
      },
      "expected": {
        "EXPLORE_TIMEOUT_MS": 120000
      }
    },
    {
      "name": "an answer is trimmed",
      "input": {
        "op": "explore",
        "mode": "answer",
        "question": "where is it?",
        "text": "  found it in a.ts  "
      },
      "expected": "found it in a.ts"
    },
    {
      "name": "an empty answer says nothing came back",
      "input": {
        "op": "explore",
        "mode": "answer",
        "question": "where is it?",
        "text": "   "
      },
      "expected": "That search came back with nothing."
    },
    {
      "name": "a failure is reported with its message",
      "input": {
        "op": "explore",
        "mode": "error",
        "question": "where is it?",
        "message": "boom"
      },
      "expected": "That search failed: boom"
    },
    {
      "name": "a search past its timeout is stopped",
      "input": {
        "op": "explore",
        "mode": "timeout",
        "question": "where is it?"
      },
      "expected": "That search took too long and was stopped. Ask something narrower."
    }
  ]
}
