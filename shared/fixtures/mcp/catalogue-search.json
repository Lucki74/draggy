{
  "area": "mcp",
  "description": "searchCatalogue: entries whose id, name or description contains the term, ignoring case. Blank or missing terms list everything.",
  "cases": [
    {
      "name": "matches on name",
      "input": {
        "term": "github"
      },
      "expected": [
        "github",
        "composio",
        "bounty-guard"
      ]
    },
    {
      "name": "matches on what a server does",
      "input": {
        "term": "transcript"
      },
      "expected": [
        "youtube-transcript"
      ]
    },
    {
      "name": "matches on the id",
      "input": {
        "term": "supabase"
      },
      "expected": [
        "supabase"
      ]
    },
    {
      "name": "matches a part of a word",
      "input": {
        "term": "sql"
      },
      "expected": [
        "postgres",
        "sqlite",
        "mysql",
        "snowflake"
      ]
    },
    {
      "name": "ignores case",
      "input": {
        "term": "SLACK"
      },
      "expected": [
        "composio",
        "slack"
      ]
    },
    {
      "name": "matches on the description",
      "input": {
        "term": "payments"
      },
      "expected": [
        "stripe"
      ]
