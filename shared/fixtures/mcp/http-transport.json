{
  "area": "mcp",
  "description": "createHttpTransport: one POST per message over a fake fetch. Records each request (method, url, headers, JSON body), the results of each op, and the session id. A 401 is retried once when a refresh is available, and the goodbye after a session is a DELETE with no token.",
  "cases": [
    {
      "name": "carries a call through and hands back the result",
      "input": {
        "responses": [
          {
            "status": 200,
            "headers": {
              "content-type": "application/json"
            },
            "body": {
              "jsonrpc": "2.0",
              "id": 1,
              "result": {
                "tools": [
                  {
                    "name": "search"
                  }
                ]
              }
            }
          }
        ],
        "ops": [
          {
            "op": "send",
            "method": "tools/list",
            "params": {}
          }
        ]
      },
      "expected": {
        "results": [
          {
            "ok": {
              "tools": [
                {
                  "name": "search"
                }
              ]
            }
          }
        ],
        "requests": [
          {
            "method": "POST",
            "url": "https://tools.example/mcp",
            "headers": {
              "Content-Type": "application/json",
              "Accept": "application/json, text/event-stream",
              "MCP-Protocol-Version": "2025-06-18"
            },
            "body": {
              "jsonrpc": "2.0",
              "id": 1,
              "method": "tools/list",
              "params": {}
            }
          }
        ],
        "sessionId": null
      }
    },
    {
      "name": "sends a call with no params without a params field",
      "input": {
