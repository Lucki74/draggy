{
  "area": "mcp",
  "description": "Recorded JSON-RPC sessions over streamable HTTP, driven through a scripted fetch. Each start takes the next session; replies are taken in request order, and notifications get 202. Expected: one result per op, the wire (each POST and DELETE with the two API-key headers when sent), and the log lines. Transport-internal lines (http answered, session reset) are left out on both sides; the wire shows the session behavior. An object {\"repeat\": text, \"count\": n} stands for its text repeated n times, as in the stdio file.",
  "cases": [
    {
      "name": "a remote server is reached over HTTP, listed, and sent a goodbye when stopped",
      "input": {
        "sessions": [
          {
            "replies": [
              {
                "method": "initialize",
                "result": {
                  "protocolVersion": "2025-06-18",
                  "capabilities": {
                    "tools": {}
                  },
                  "serverInfo": {
                    "name": "docs",
                    "version": "0.6.3"
                  }
                },
                "headers": {
                  "mcp-session-id": "s-1"
                }
              },
              {
                "method": "tools/list",
                "result": {
                  "tools": [
                    {
                      "name": "search_nodes",
                      "description": "Search the graph",
                      "inputSchema": {
                        "type": "object",
                        "properties": {}
                      }
                    }
                  ]
                }
              }
            ],
            "stop_code": 0
          }
        ],
        "ops": [
          {
            "op": "start",
            "id": "remote-docs",
            "config": {
              "url": "https://tools.example/mcp"
            }
          },
          {
            "op": "list"
          },
          {
            "op": "stop",
            "id": "remote-docs"
          }
        ]
      },
      "expected": {
        "results": [
          {
            "id": "remote-docs",
            "status": "ready",
            "error": null,
            "tools": [
              {
                "name": "search_nodes",
                "qualifiedName": "remote_docs__search_nodes",
                "description": "Search the graph",
                "inputSchema": {
                  "type": "object",
                  "properties": {}
                }
              }
            ]
          },
          [
            {
              "id": "remote-docs",
              "status": "ready",
              "error": null,
              "tools": [
                {
                  "name": "search_nodes",
                  "qualifiedName": "remote_docs__search_nodes",
                  "description": "Search the graph",
                  "inputSchema": {
                    "type": "object",
                    "properties": {}
                  }
                }
              ]
            }
          ],
          {
            "success": true
          }
        ],
        "wire": [
          {
            "http": "POST",
            "headers": {},
            "message": {
              "jsonrpc": "2.0",
              "id": 1,
              "method": "initialize",
              "params": {
                "protocolVersion": "2025-06-18",
                "capabilities": {},
                "clientInfo": {
                  "name": "Draggy",
                  "version": "2.0.0"
                }
              }
            }
          },
          {
            "http": "POST",
            "headers": {},
            "message": {
              "jsonrpc": "2.0",
              "method": "notifications/initialized",
              "params": {}
            }
          },
          {
            "http": "POST",
            "headers": {},
            "message": {
              "jsonrpc": "2.0",
              "id": 2,
              "method": "tools/list",
              "params": {}
            }
          },
          {
            "http": "DELETE",
            "headers": {},
            "message": null
          }
        ],
        "logs": [
          {
            "level": "info",
            "scope": "mcp.remote-docs",
            "msg": "connected",
            "data": {
              "transport": "http",
              "protocol": "2025-06-18",
              "server": "remote-docs",
              "serverVersion": "0.6.3",
              "capabilities": [
                "tools"
              ],
              "tools": 1,
              "serverName": "docs"
            }
          }
        ]
      }
    },
