{
  "area": "mcp",
  "description": "parseServers: the registry's answer as installable and callable entries. Drops what needs uvx and what Draggy already ships.",
  "cases": [
    {
      "name": "takes a server it can install and one it can call, and drops a Python one",
      "input": {
        "payload": {
          "servers": [
            {
              "name": "io.github.someone/weather",
              "description": "Weather for anywhere.",
              "repository": {
                "url": "https://github.com/someone/weather"
              },
              "packages": [
                {
                  "registry_name": "npm",
                  "name": "@someone/weather-mcp"
                }
              ]
            },
            {
              "name": "com.example/tickets",
              "description": "Our ticket system.",
              "remotes": [
                {
                  "type": "streamable-http",
                  "url": "https://tickets.example/mcp"
                }
              ]
            },
            {
              "name": "com.example/python-only",
              "description": "Needs uvx, which Draggy does not have.",
              "packages": [
                {
                  "registry_name": "pypi",
                  "name": "python-thing"
                }
              ]
            }
          ]
        }
      },
      "expected": [
        {
          "id": "weather",
          "name": "io.github.someone/weather",
          "description": "Weather for anywhere.",
          "source": "registry",
          "docs": "https://github.com/someone/weather",
          "package": "@someone/weather-mcp",
          "args": [],
          "env": []
        },
        {
          "id": "tickets",
          "name": "com.example/tickets",
          "description": "Our ticket system.",
          "source": "registry",
          "docs": "",
          "url": "https://tickets.example/mcp",
          "transport": "http",
          "remote": true
        }
      ]
    },
    {
      "name": "takes a server it can call",
      "input": {
        "payload": {
          "servers": [
            {
              "name": "com.example/tickets",
              "description": "Our ticket system.",
              "remotes": [
                {
                  "type": "streamable-http",
                  "url": "https://tickets.example/mcp"
                }
              ]
            }
          ]
        }
      },
      "expected": [
        {
          "id": "tickets",
          "name": "com.example/tickets",
          "description": "Our ticket system.",
          "source": "registry",
          "docs": "",
          "url": "https://tickets.example/mcp",
          "transport": "http",
          "remote": true
        }
      ]
    },
    {
      "name": "leaves out anything it could not run",
      "input": {
        "payload": {
          "servers": [
            {
              "name": "com.example/python-only",
              "description": "Needs uvx, which Draggy does not have.",
              "packages": [
                {
                  "registry_name": "pypi",
                  "name": "python-thing"
                }
              ]
            }
          ]
        }
      },
      "expected": []
    },
    {
      "name": "leaves out what Draggy already ships",
      "input": {
        "payload": {
          "servers": [
            {
              "name": "io.github.modelcontextprotocol/github",
              "packages": [
                {
                  "registry_name": "npm",
                  "name": "someone-elses-github"
                }
              ]
            }
          ]
        }
      },
      "expected": []
    },
    {
      "name": "survives a shape it has never seen",
      "input": {
        "payload": null
      },
      "expected": []
    },
    {
      "name": "survives servers that are empty or null",
      "input": {
        "payload": {
          "servers": [
            {},
            null
          ]
        }
      },
      "expected": []
    },
    {
      "name": "accepts a bare list of servers",
      "input": {
        "payload": [
          {
            "name": "io.github.someone/weather",
            "description": "Weather for anywhere.",
            "repository": {
              "url": "https://github.com/someone/weather"
