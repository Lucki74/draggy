        "debug": [
          "2026-01-01T00:00:00.123Z INFO a1b2c3d4.2 [system] [renderer.chat] 12",
          "2026-01-01T00:00:00.123Z INFO a1b2c3d4.3 [system] [renderer.chat] true",
          "2026-01-01T00:00:00.123Z INFO a1b2c3d4.4 [system] [renderer.chat] a,b",
