    {
      "name": "an error object keeps its name and stack; app.log keeps only the frames",
      "input": {
        "clock": 1767225600123,
        "session": "a1b2c3d4",
        "pid": 4242,
        "env": {},
        "ops": [
          {
            "op": "ingest",
            "entry": {
              "level": "error",
              "context": "chat",
              "message": "render failed",
              "error": {
                "name": "TypeError",
                "message": "x is undefined",
                "stack": "TypeError: x is undefined\n    at render (chat.js:10:5)\n    at run (chat.js:3:1)"
              }
            }
          }
        ]
      },
      "expected": {
        "app": [
          "2026-01-01T00:00:00.123Z ERROR a1b2c3d4.2 [system] [renderer.chat] render failed",
          "TypeError: x is undefined",
          "    at render (chat.js:10:5)",
          "    at run (chat.js:3:1)"
        ],
        "debug": [
          "2026-01-01T00:00:00.123Z ERROR a1b2c3d4.2 [system] [renderer.chat] render failed",
          "TypeError: x is undefined",
          "    at render (chat.js:10:5)",
          "    at run (chat.js:3:1)"
        ],
        "events": [
          "{\"ts\":\"2026-01-01T00:00:00.123Z\",\"seq\":2,\"level\":\"ERROR\",\"session\":\"a1b2c3d4\",\"proc\":\"renderer\",\"pid\":4242,\"scope\":\"renderer.chat\",\"msg\":\"render failed\",\"err\":{\"name\":\"TypeError\",\"message\":\"x is undefined\",\"stack\":\"TypeError: x is undefined\\n    at render (chat.js:10:5)\\n    at run (chat.js:3:1)\"}}"
        ]
      }
    },
    {
      "name": "an error without a name or stack gets name and message",
      "input": {
        "clock": 1767225600123,
        "session": "a1b2c3d4",
        "pid": 4242,
