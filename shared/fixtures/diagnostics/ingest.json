          "{\"ts\":\"2026-01-01T00:00:00.123Z\",\"seq\":3,\"level\":\"INFO\",\"session\":\"a1b2c3d4\",\"proc\":\"renderer\",\"pid\":4242,\"scope\":\"renderer.chat\",\"msg\":\"true\"}",
          "{\"ts\":\"2026-01-01T00:00:00.123Z\",\"seq\":4,\"level\":\"INFO\",\"session\":\"a1b2c3d4\",\"proc\":\"renderer\",\"pid\":4242,\"scope\":\"renderer.chat\",\"msg\":\"a,b\"}",
          "{\"ts\":\"2026-01-01T00:00:00.123Z\",\"seq\":5,\"level\":\"INFO\",\"session\":\"a1b2c3d4\",\"proc\":\"renderer\",\"pid\":4242,\"scope\":\"renderer.chat\",\"msg\":\"[object Object]\"}",
          "{\"ts\":\"2026-01-01T00:00:00.123Z\",\"seq\":6,\"level\":\"INFO\",\"session\":\"a1b2c3d4\",\"proc\":\"renderer\",\"pid\":4242,\"scope\":\"renderer.chat\",\"msg\":\"\"}"
        ]
