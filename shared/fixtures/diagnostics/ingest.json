{
  "area": "diagnostics",
  "description": "Renderer log entries as written after the boot line. Covers context prefixing, correlation ids, level names, clamps, error objects, the message and data fallbacks, and an entries field that is null.",
  "cases": [
    {
      "name": "an entry is filed under renderer with its context",
      "input": {
        "clock": 1767225600123,
        "session": "a1b2c3d4",
        "pid": 4242,
        "env": {},
        "ops": [
          {
            "op": "ingest",
            "entry": {
              "level": "info",
              "context": "chat",
              "message": "opened",
              "data": {
                "tab": 1
              }
            }
          }
        ]
      },
      "expected": {
        "app": [
          "2026-01-01T00:00:00.123Z INFO a1b2c3d4.2 [system] [renderer.chat] opened {\"tab\":1}"
        ],
        "debug": [
          "2026-01-01T00:00:00.123Z INFO a1b2c3d4.2 [system] [renderer.chat] opened {\"tab\":1}"
        ],
        "events": [
          "{\"ts\":\"2026-01-01T00:00:00.123Z\",\"seq\":2,\"level\":\"INFO\",\"session\":\"a1b2c3d4\",\"proc\":\"renderer\",\"pid\":4242,\"scope\":\"renderer.chat\",\"msg\":\"opened\",\"data\":{\"tab\":1}}"
        ]
      }
    },
    {
      "name": "a context already carrying renderer is not doubled",
      "input": {
        "clock": 1767225600123,
        "session": "a1b2c3d4",
        "pid": 4242,
        "env": {},
        "ops": [
          {
            "op": "ingest",
            "entry": {
              "level": "info",
              "context": "renderer.editor",
              "message": "a"
            }
          },
          {
            "op": "ingest",
            "entry": {
              "level": "info",
              "context": "renderer",
              "message": "b"
            }
          },
          {
            "op": "ingest",
            "entry": {
              "level": "info",
              "context": "renderer.",
              "message": "c"
            }
          }
        ]
      },
      "expected": {
        "app": [
          "2026-01-01T00:00:00.123Z INFO a1b2c3d4.2 [system] [renderer.editor] a",
          "2026-01-01T00:00:00.123Z INFO a1b2c3d4.3 [system] [renderer.app] b",
          "2026-01-01T00:00:00.123Z INFO a1b2c3d4.4 [system] [renderer.app] c"
        ],
        "debug": [
          "2026-01-01T00:00:00.123Z INFO a1b2c3d4.2 [system] [renderer.editor] a",
          "2026-01-01T00:00:00.123Z INFO a1b2c3d4.3 [system] [renderer.app] b",
          "2026-01-01T00:00:00.123Z INFO a1b2c3d4.4 [system] [renderer.app] c"
        ],
        "events": [
          "{\"ts\":\"2026-01-01T00:00:00.123Z\",\"seq\":2,\"level\":\"INFO\",\"session\":\"a1b2c3d4\",\"proc\":\"renderer\",\"pid\":4242,\"scope\":\"renderer.editor\",\"msg\":\"a\"}",
          "{\"ts\":\"2026-01-01T00:00:00.123Z\",\"seq\":3,\"level\":\"INFO\",\"session\":\"a1b2c3d4\",\"proc\":\"renderer\",\"pid\":4242,\"scope\":\"renderer.app\",\"msg\":\"b\"}",
          "{\"ts\":\"2026-01-01T00:00:00.123Z\",\"seq\":4,\"level\":\"INFO\",\"session\":\"a1b2c3d4\",\"proc\":\"renderer\",\"pid\":4242,\"scope\":\"renderer.app\",\"msg\":\"c\"}"
        ]
      }
    },
    {
      "name": "a missing or non-string context lands under renderer.app",
      "input": {
        "clock": 1767225600123,
        "session": "a1b2c3d4",
        "pid": 4242,
        "env": {},
        "ops": [
          {
            "op": "ingest",
            "entry": {
              "level": "info",
              "message": "no context"
            }
          },
          {
            "op": "ingest",
            "entry": {
              "level": "info",
              "context": 42,
              "message": "number context"
            }
          }
        ]
      },
      "expected": {
        "app": [
          "2026-01-01T00:00:00.123Z INFO a1b2c3d4.2 [system] [renderer.app] no context",
          "2026-01-01T00:00:00.123Z INFO a1b2c3d4.3 [system] [renderer.app] number context"
        ],
        "debug": [
          "2026-01-01T00:00:00.123Z INFO a1b2c3d4.2 [system] [renderer.app] no context",
          "2026-01-01T00:00:00.123Z INFO a1b2c3d4.3 [system] [renderer.app] number context"
        ],
        "events": [
          "{\"ts\":\"2026-01-01T00:00:00.123Z\",\"seq\":2,\"level\":\"INFO\",\"session\":\"a1b2c3d4\",\"proc\":\"renderer\",\"pid\":4242,\"scope\":\"renderer.app\",\"msg\":\"no context\"}",
          "{\"ts\":\"2026-01-01T00:00:00.123Z\",\"seq\":3,\"level\":\"INFO\",\"session\":\"a1b2c3d4\",\"proc\":\"renderer\",\"pid\":4242,\"scope\":\"renderer.app\",\"msg\":\"number context\"}"
        ]
      }
    },
    {
      "name": "an unknown level name is written as INFO",
      "input": {
        "clock": 1767225600123,
        "session": "a1b2c3d4",
        "pid": 4242,
        "env": {},
        "ops": [
          {
            "op": "ingest",
            "entry": {
              "level": "loud",
              "message": "word"
            }
          },
          {
            "op": "ingest",
            "entry": {
              "level": 5,
              "message": "number"
            }
          },
          {
            "op": "ingest",
            "entry": {
              "message": "no level"
            }
          }
        ]
      },
      "expected": {
        "app": [
          "2026-01-01T00:00:00.123Z INFO a1b2c3d4.2 [system] [renderer.app] word",
          "2026-01-01T00:00:00.123Z INFO a1b2c3d4.3 [system] [renderer.app] number",
          "2026-01-01T00:00:00.123Z INFO a1b2c3d4.4 [system] [renderer.app] no level"
        ],
        "debug": [
          "2026-01-01T00:00:00.123Z INFO a1b2c3d4.2 [system] [renderer.app] word",
          "2026-01-01T00:00:00.123Z INFO a1b2c3d4.3 [system] [renderer.app] number",
          "2026-01-01T00:00:00.123Z INFO a1b2c3d4.4 [system] [renderer.app] no level"
        ],
        "events": [
          "{\"ts\":\"2026-01-01T00:00:00.123Z\",\"seq\":2,\"level\":\"INFO\",\"session\":\"a1b2c3d4\",\"proc\":\"renderer\",\"pid\":4242,\"scope\":\"renderer.app\",\"msg\":\"word\"}",
          "{\"ts\":\"2026-01-01T00:00:00.123Z\",\"seq\":3,\"level\":\"INFO\",\"session\":\"a1b2c3d4\",\"proc\":\"renderer\",\"pid\":4242,\"scope\":\"renderer.app\",\"msg\":\"number\"}",
          "{\"ts\":\"2026-01-01T00:00:00.123Z\",\"seq\":4,\"level\":\"INFO\",\"session\":\"a1b2c3d4\",\"proc\":\"renderer\",\"pid\":4242,\"scope\":\"renderer.app\",\"msg\":\"no level\"}"
        ]
      }
    },
    {
      "name": "lower-case level names are accepted",
      "input": {
        "clock": 1767225600123,
        "session": "a1b2c3d4",
        "pid": 4242,
        "env": {},
        "ops": [
          {
            "op": "ingest",
            "entry": {
              "level": "warn",
              "context": "chat",
              "message": "careful"
            }
          },
          {
            "op": "ingest",
            "entry": {
              "level": "error",
              "context": "chat",
              "message": "broke"
            }
          }
        ]
      },
      "expected": {
        "app": [
          "2026-01-01T00:00:00.123Z WARN a1b2c3d4.2 [system] [renderer.chat] careful",
          "2026-01-01T00:00:00.123Z ERROR a1b2c3d4.3 [system] [renderer.chat] broke"
        ],
        "debug": [
          "2026-01-01T00:00:00.123Z WARN a1b2c3d4.2 [system] [renderer.chat] careful",
          "2026-01-01T00:00:00.123Z ERROR a1b2c3d4.3 [system] [renderer.chat] broke"
        ],
        "events": [
          "{\"ts\":\"2026-01-01T00:00:00.123Z\",\"seq\":2,\"level\":\"WARN\",\"session\":\"a1b2c3d4\",\"proc\":\"renderer\",\"pid\":4242,\"scope\":\"renderer.chat\",\"msg\":\"careful\"}",
          "{\"ts\":\"2026-01-01T00:00:00.123Z\",\"seq\":3,\"level\":\"ERROR\",\"session\":\"a1b2c3d4\",\"proc\":\"renderer\",\"pid\":4242,\"scope\":\"renderer.chat\",\"msg\":\"broke\"}"
        ]
      }
    },
    {
      "name": "a correlation id from the entry tags the line",
      "input": {
        "clock": 1767225600123,
        "session": "a1b2c3d4",
        "pid": 4242,
        "env": {},
        "ops": [
          {
            "op": "ingest",
            "entry": {
              "level": "info",
              "context": "chat",
              "message": "turn",
              "correlationId": "turn-9",
              "data": {
                "model": "m"
              }
            }
          }
        ]
      },
      "expected": {
        "app": [
          "2026-01-01T00:00:00.123Z INFO a1b2c3d4.2 [turn-9] [renderer.chat] turn {\"model\":\"m\"}"
        ],
        "debug": [
          "2026-01-01T00:00:00.123Z INFO a1b2c3d4.2 [turn-9] [renderer.chat] turn {\"model\":\"m\"}"
        ],
        "events": [
          "{\"ts\":\"2026-01-01T00:00:00.123Z\",\"seq\":2,\"level\":\"INFO\",\"session\":\"a1b2c3d4\",\"proc\":\"renderer\",\"pid\":4242,\"scope\":\"renderer.chat\",\"msg\":\"turn\",\"cid\":\"turn-9\",\"data\":{\"model\":\"m\"}}"
        ]
      }
    },
    {
      "name": "an empty correlation id counts as none",
      "input": {
        "clock": 1767225600123,
        "session": "a1b2c3d4",
        "pid": 4242,
        "env": {},
        "ops": [
          {
            "op": "ingest",
            "entry": {
              "level": "info",
              "context": "chat",
              "message": "x",
              "correlationId": ""
            }
          }
        ]
      },
      "expected": {
        "app": [
          "2026-01-01T00:00:00.123Z INFO a1b2c3d4.2 [system] [renderer.chat] x"
        ],
        "debug": [
          "2026-01-01T00:00:00.123Z INFO a1b2c3d4.2 [system] [renderer.chat] x"
        ],
        "events": [
          "{\"ts\":\"2026-01-01T00:00:00.123Z\",\"seq\":2,\"level\":\"INFO\",\"session\":\"a1b2c3d4\",\"proc\":\"renderer\",\"pid\":4242,\"scope\":\"renderer.chat\",\"msg\":\"x\"}"
        ]
      }
    },
    {
      "name": "a cid in the data is used when the entry sends no correlation id",
      "input": {
        "clock": 1767225600123,
        "session": "a1b2c3d4",
        "pid": 4242,
        "env": {},
        "ops": [
          {
            "op": "ingest",
            "entry": {
              "level": "info",
              "context": "chat",
              "message": "turn",
              "data": {
                "cid": "t2"
              }
            }
          }
        ]
      },
      "expected": {
        "app": [
          "2026-01-01T00:00:00.123Z INFO a1b2c3d4.2 [t2] [renderer.chat] turn {\"cid\":\"t2\"}"
        ],
        "debug": [
          "2026-01-01T00:00:00.123Z INFO a1b2c3d4.2 [t2] [renderer.chat] turn {\"cid\":\"t2\"}"
        ],
        "events": [
          "{\"ts\":\"2026-01-01T00:00:00.123Z\",\"seq\":2,\"level\":\"INFO\",\"session\":\"a1b2c3d4\",\"proc\":\"renderer\",\"pid\":4242,\"scope\":\"renderer.chat\",\"msg\":\"turn\",\"cid\":\"t2\",\"data\":{\"cid\":\"t2\"}}"
        ]
      }
    },
    {
