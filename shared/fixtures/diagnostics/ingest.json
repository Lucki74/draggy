        "ops": [
          {
            "op": "ingest",
            "entry": {
              "context": "chat",
              "message": 12
            }
          },
          {
            "op": "ingest",
            "entry": {
              "context": "chat",
              "message": true
            }
          },
          {
            "op": "ingest",
            "entry": {
              "context": "chat",
              "message": [
                "a",
                "b"
              ]
            }
          },
          {
            "op": "ingest",
            "entry": {
              "context": "chat",
              "message": {
                "x": 1
