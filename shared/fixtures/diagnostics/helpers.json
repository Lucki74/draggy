        "debug": [
          "2026-01-01T00:00:00.123Z INFO a1b2c3d4.2 [system] [ipc.poll] poll {\"n\":1}",
          "2026-01-01T00:00:10.123Z INFO a1b2c3d4.3 [system] [ipc.poll] poll repeated 2 times in 10 s {\"n\":1}"
        ],
        "events": [
          "{\"ts\":\"2026-01-01T00:00:00.123Z\",\"seq\":2,\"level\":\"INFO\",\"session\":\"a1b2c3d4\",\"proc\":\"main\",\"pid\":4242,\"scope\":\"ipc.poll\",\"msg\":\"poll\",\"data\":{\"n\":1}}",
          "{\"ts\":\"2026-01-01T00:00:10.123Z\",\"seq\":3,\"level\":\"INFO\",\"session\":\"a1b2c3d4\",\"proc\":\"main\",\"pid\":4242,\"scope\":\"ipc.poll\",\"msg\":\"poll repeated 2 times in 10 s\",\"data\":{\"n\":1}}"
        ],
        "tail": null
      }
    },
