{
  "area": "diagnostics",
  "description": "The writer's helpers: once (first time a key is seen), limited (first call logs, repeats in the window are counted and summed when the window closes), swallowed and readTail. Format lines after the boot line. Expected `tail` is readTail's text, or with `summary` its length and both ends, or null when the case reads none. Advance ops fire the window timers.",
  "cases": [
    {
      "name": "once logs the first time a key is seen",
      "input": {
        "clock": 1767225600123,
        "session": "a1b2c3d4",
        "pid": 4242,
        "env": {},
        "ops": [
          {
            "op": "once",
            "key": "k1",
            "scope": "providers",
            "message": "fallback in use",
            "data": {
              "model": "m"
            }
          },
          {
            "op": "once",
            "key": "k1",
            "scope": "providers",
            "message": "fallback in use",
            "data": {
              "model": "m"
            }
          }
        ]
      },
      "expected": {
        "app": [
          "2026-01-01T00:00:00.123Z WARN a1b2c3d4.2 [system] [providers] fallback in use {\"model\":\"m\"}"
        ],
        "debug": [
          "2026-01-01T00:00:00.123Z WARN a1b2c3d4.2 [system] [providers] fallback in use {\"model\":\"m\"}"
        ],
        "events": [
          "{\"ts\":\"2026-01-01T00:00:00.123Z\",\"seq\":2,\"level\":\"WARN\",\"session\":\"a1b2c3d4\",\"proc\":\"main\",\"pid\":4242,\"scope\":\"providers\",\"msg\":\"fallback in use\",\"data\":{\"model\":\"m\"}}"
        ],
        "tail": null
      }
    },
