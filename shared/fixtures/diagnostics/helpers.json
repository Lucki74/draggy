          "{\"ts\":\"2026-01-01T00:00:00.123Z\",\"seq\":3,\"level\":\"WARN\",\"session\":\"a1b2c3d4\",\"proc\":\"main\",\"pid\":4242,\"scope\":\"p\",\"msg\":\"two\"}"
