{
  "area": "diagnostics",
  "description": "Renderer ingestion caps. Ops run on a fixed clock. Expected: `rendered` is how many renderer.* lines reached events.jsonl, `dropped` is the count each `renderer entries dropped` warning reported. Batches cap at 200 entries; a second's window admits 1000 valid entries, and invalid entries do not use the window.",
  "cases": [
    {
      "name": "a batch over 200 keeps 200 and reports the rest",
      "input": {
        "clock": 1767225600123,
        "session": "a1b2c3d4",
        "pid": 4242,
        "env": {},
        "ops": [
          {
            "op": "ingest",
            "entry": {
              "level": "info",
              "context": "chat",
              "message": "tick"
            },
            "repeat": 250
          }
        ]
      },
      "expected": {
        "rendered": 200,
        "dropped": [
          50
        ]
      }
    },
    {
