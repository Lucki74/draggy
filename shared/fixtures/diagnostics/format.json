        ],
        "events": [
          "{\"ts\":\"2026-01-01T00:00:00.123Z\",\"seq\":2,\"level\":\"DEBUG\",\"session\":\"a1b2c3d4\",\"proc\":\"main\",\"pid\":4242,\"scope\":\"proc.command\",\"msg\":\"stdout chunk\",\"data\":{\"bytes\":42,\"rawChunk\":\"[21 chars, sha256:aab962a4]\"}}"
        ]
