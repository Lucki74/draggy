          "2026-01-01T00:00:00.123Z INFO a1b2c3d4.2 [system] [tools] readFile:start {\"path\":\"C:/nested/nested/nested/nested/nested/nested/nested/nested/nested/nested/file.txt\"}"
        ],
        "events": [
