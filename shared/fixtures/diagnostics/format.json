{
  "area": "diagnostics",
  "description": "Log lines one call writes, after the boot line: app.log cut, debug.log and events.jsonl in full. Covers levels, hashing of sensitive text, secret key names (any letter case, any depth, and the look-alikes that stay), cuts, numbers, depth, error chains, timers and how their data spreads, swallow, and keystore values.",
  "cases": [
    {
      "name": "info line: stamp, tag, system id, context and data",
      "input": {
        "clock": 1767225600123,
        "session": "a1b2c3d4",
        "pid": 4242,
        "env": {},
        "ops": [
          {
            "op": "info",
            "scope": "engine.llama",
            "message": "ready",
            "data": {
              "port": 8080,
              "model": "llama3"
            }
          }
        ]
      },
      "expected": {
        "app": [
          "2026-01-01T00:00:00.123Z INFO a1b2c3d4.2 [system] [engine.llama] ready {\"port\":8080,\"model\":\"llama3\"}"
        ],
        "debug": [
          "2026-01-01T00:00:00.123Z INFO a1b2c3d4.2 [system] [engine.llama] ready {\"port\":8080,\"model\":\"llama3\"}"
        ],
        "events": [
          "{\"ts\":\"2026-01-01T00:00:00.123Z\",\"seq\":2,\"level\":\"INFO\",\"session\":\"a1b2c3d4\",\"proc\":\"engine\",\"pid\":4242,\"scope\":\"engine.llama\",\"msg\":\"ready\",\"data\":{\"port\":8080,\"model\":\"llama3\"}}"
        ]
      }
    },
    {
      "name": "correlation id from data replaces the system id",
      "input": {
        "clock": 1767225600123,
        "session": "a1b2c3d4",
        "pid": 4242,
        "env": {},
        "ops": [
          {
            "op": "info",
            "scope": "agent",
            "message": "turn start",
            "data": {
              "cid": "turn-1",
              "model": "llama3"
            }
          }
        ]
      },
      "expected": {
        "app": [
          "2026-01-01T00:00:00.123Z INFO a1b2c3d4.2 [turn-1] [agent] turn start {\"cid\":\"turn-1\",\"model\":\"llama3\"}"
        ],
        "debug": [
          "2026-01-01T00:00:00.123Z INFO a1b2c3d4.2 [turn-1] [agent] turn start {\"cid\":\"turn-1\",\"model\":\"llama3\"}"
        ],
        "events": [
          "{\"ts\":\"2026-01-01T00:00:00.123Z\",\"seq\":2,\"level\":\"INFO\",\"session\":\"a1b2c3d4\",\"proc\":\"main\",\"pid\":4242,\"scope\":\"agent\",\"msg\":\"turn start\",\"cid\":\"turn-1\",\"data\":{\"cid\":\"turn-1\",\"model\":\"llama3\"}}"
        ]
      }
    },
    {
      "name": "debug stays out of app.log and reaches debug.log and events",
      "input": {
        "clock": 1767225600123,
        "session": "a1b2c3d4",
        "pid": 4242,
        "env": {},
        "ops": [
          {
            "op": "debug",
            "scope": "providers",
            "message": "retry scheduled",
            "data": {
              "attempt": 2
            }
          }
        ]
      },
      "expected": {
        "app": [],
        "debug": [
          "2026-01-01T00:00:00.123Z DEBUG a1b2c3d4.2 [system] [providers] retry scheduled {\"attempt\":2}"
        ],
        "events": [
          "{\"ts\":\"2026-01-01T00:00:00.123Z\",\"seq\":2,\"level\":\"DEBUG\",\"session\":\"a1b2c3d4\",\"proc\":\"main\",\"pid\":4242,\"scope\":\"providers\",\"msg\":\"retry scheduled\",\"data\":{\"attempt\":2}}"
        ]
      }
    },
    {
      "name": "app level WARN hides info from app.log only",
      "input": {
        "clock": 1767225600123,
        "session": "a1b2c3d4",
        "pid": 4242,
        "env": {
          "APP_LOG_LEVEL": "WARN"
        },
        "ops": [
          {
            "op": "info",
            "scope": "engine",
            "message": "hidden info"
          },
          {
            "op": "warn",
            "scope": "engine",
            "message": "visible warn"
          }
        ]
      },
      "expected": {
        "app": [
          "2026-01-01T00:00:00.123Z WARN a1b2c3d4.3 [system] [engine] visible warn"
        ],
        "debug": [
          "2026-01-01T00:00:00.123Z INFO a1b2c3d4.2 [system] [engine] hidden info",
          "2026-01-01T00:00:00.123Z WARN a1b2c3d4.3 [system] [engine] visible warn"
        ],
        "events": [
          "{\"ts\":\"2026-01-01T00:00:00.123Z\",\"seq\":2,\"level\":\"INFO\",\"session\":\"a1b2c3d4\",\"proc\":\"engine\",\"pid\":4242,\"scope\":\"engine\",\"msg\":\"hidden info\"}",
          "{\"ts\":\"2026-01-01T00:00:00.123Z\",\"seq\":3,\"level\":\"WARN\",\"session\":\"a1b2c3d4\",\"proc\":\"engine\",\"pid\":4242,\"scope\":\"engine\",\"msg\":\"visible warn\"}"
        ]
      }
    },
    {
      "name": "a raised scope reaches app.log at DEBUG",
      "input": {
        "clock": 1767225600123,
        "session": "a1b2c3d4",
        "pid": 4242,
        "env": {
          "DRAGGY_DEBUG": "providers"
        },
        "ops": [
          {
            "op": "debug",
            "scope": "providers.openai",
            "message": "raised child",
            "data": {
              "attempt": 1
            }
          },
          {
            "op": "debug",
            "scope": "engine",
            "message": "not raised"
          }
        ]
      },
      "expected": {
        "app": [
          "2026-01-01T00:00:00.123Z DEBUG a1b2c3d4.2 [system] [providers.openai] raised child {\"attempt\":1}"
        ],
        "debug": [
          "2026-01-01T00:00:00.123Z DEBUG a1b2c3d4.2 [system] [providers.openai] raised child {\"attempt\":1}",
          "2026-01-01T00:00:00.123Z DEBUG a1b2c3d4.3 [system] [engine] not raised"
        ],
        "events": [
          "{\"ts\":\"2026-01-01T00:00:00.123Z\",\"seq\":2,\"level\":\"DEBUG\",\"session\":\"a1b2c3d4\",\"proc\":\"main\",\"pid\":4242,\"scope\":\"providers.openai\",\"msg\":\"raised child\",\"data\":{\"attempt\":1}}",
          "{\"ts\":\"2026-01-01T00:00:00.123Z\",\"seq\":3,\"level\":\"DEBUG\",\"session\":\"a1b2c3d4\",\"proc\":\"engine\",\"pid\":4242,\"scope\":\"engine\",\"msg\":\"not raised\"}"
        ]
      }
    },
    {
      "name": "prompts and replies are hashed in every file",
      "input": {
        "clock": 1767225600123,
        "session": "a1b2c3d4",
        "pid": 4242,
        "env": {},
        "ops": [
          {
            "op": "info",
            "scope": "agent",
            "message": "turn",
            "data": {
              "cid": "turn-2",
              "prompt": "please summarise my confidential merger memo",
              "reply": "the merger closes on the ninth of March",
              "messages": [
                {
                  "role": "user",
                  "content": "please summarise my confidential merger memo"
                },
                {
                  "role": "assistant",
                  "content": [
                    {
                      "type": "text",
                      "text": "the merger closes on the ninth of March"
                    }
                  ]
                }
              ]
            }
          }
        ]
      },
      "expected": {
        "app": [
          "2026-01-01T00:00:00.123Z INFO a1b2c3d4.2 [turn-2] [agent] turn {\"cid\":\"turn-2\",\"prompt\":\"[44 chars, sha256:974fa8e1]\",\"reply\":\"[39 chars, sha256:f2de1b10]\",\"messages\":[{\"role\":\"user\",\"content\":\"[44 chars, sha256:974fa8e1]\"},{\"role\":\"assistant\",\"content\":[{\"type\":\"[4 chars, sha256:982d9e3e]\",\"text\":\"[39 chars, sha256:f2de1b10]\"}]}]}"
        ],
        "debug": [
          "2026-01-01T00:00:00.123Z INFO a1b2c3d4.2 [turn-2] [agent] turn {\"cid\":\"turn-2\",\"prompt\":\"[44 chars, sha256:974fa8e1]\",\"reply\":\"[39 chars, sha256:f2de1b10]\",\"messages\":[{\"role\":\"user\",\"content\":\"[44 chars, sha256:974fa8e1]\"},{\"role\":\"assistant\",\"content\":[{\"type\":\"[4 chars, sha256:982d9e3e]\",\"text\":\"[39 chars, sha256:f2de1b10]\"}]}]}"
        ],
        "events": [
          "{\"ts\":\"2026-01-01T00:00:00.123Z\",\"seq\":2,\"level\":\"INFO\",\"session\":\"a1b2c3d4\",\"proc\":\"main\",\"pid\":4242,\"scope\":\"agent\",\"msg\":\"turn\",\"cid\":\"turn-2\",\"data\":{\"cid\":\"turn-2\",\"prompt\":\"[44 chars, sha256:974fa8e1]\",\"reply\":\"[39 chars, sha256:f2de1b10]\",\"messages\":[{\"role\":\"user\",\"content\":\"[44 chars, sha256:974fa8e1]\"},{\"role\":\"assistant\",\"content\":[{\"type\":\"[4 chars, sha256:982d9e3e]\",\"text\":\"[39 chars, sha256:f2de1b10]\"}]}]}}"
        ]
      }
    },
    {
