{
  "area": "diagnostics",
  "description": "setLevel as it changes what the files take. Format runner: app, debug and events lines after the boot line. The `level changed` line carries the level, scopes, keep and until.",
  "cases": [
    {
      "name": "a level change is logged with keep false and until null",
      "input": {
        "clock": 1767225600123,
        "session": "a1b2c3d4",
        "pid": 4242,
        "env": {},
        "ops": [
          {
            "op": "setLevel",
            "level": "debug"
          }
        ]
      },
      "expected": {
        "app": [
          "2026-01-01T00:00:00.123Z INFO a1b2c3d4.2 [system] [logger] level changed {\"level\":\"DEBUG\",\"scopes\":[],\"keep\":false,\"until\":null}"
        ],
        "debug": [
          "2026-01-01T00:00:00.123Z INFO a1b2c3d4.2 [system] [logger] level changed {\"level\":\"DEBUG\",\"scopes\":[],\"keep\":false,\"until\":null}"
        ],
        "events": [
          "{\"ts\":\"2026-01-01T00:00:00.123Z\",\"seq\":2,\"level\":\"INFO\",\"session\":\"a1b2c3d4\",\"proc\":\"main\",\"pid\":4242,\"scope\":\"logger\",\"msg\":\"level changed\",\"data\":{\"level\":\"DEBUG\",\"scopes\":[],\"keep\":false,\"until\":null}}"
        ]
      }
    },
    {
      "name": "a timed change logs when it ends",
      "input": {
        "clock": 1767225600123,
        "session": "a1b2c3d4",
        "pid": 4242,
        "env": {},
        "ops": [
          {
            "op": "setLevel",
            "level": "DEBUG",
            "durationMs": 60000
          }
        ]
      },
      "expected": {
        "app": [
          "2026-01-01T00:00:00.123Z INFO a1b2c3d4.2 [system] [logger] level changed {\"level\":\"DEBUG\",\"scopes\":[],\"keep\":false,\"until\":1767225660123}"
        ],
        "debug": [
          "2026-01-01T00:00:00.123Z INFO a1b2c3d4.2 [system] [logger] level changed {\"level\":\"DEBUG\",\"scopes\":[],\"keep\":false,\"until\":1767225660123}"
        ],
        "events": [
          "{\"ts\":\"2026-01-01T00:00:00.123Z\",\"seq\":2,\"level\":\"INFO\",\"session\":\"a1b2c3d4\",\"proc\":\"main\",\"pid\":4242,\"scope\":\"logger\",\"msg\":\"level changed\",\"data\":{\"level\":\"DEBUG\",\"scopes\":[],\"keep\":false,\"until\":1767225660123}}"
        ]
      }
    },
    {
