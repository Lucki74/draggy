{
  "area": "storage",
  "description": "Ordered operation lists over a database closed by quitting: each call that arrives after close answers as refused, empty or null, never with a throw, and a reopen brings the stored chats back. Same op and expected rules as ops-chats.json.",
  "cases": [
    {
      "name": "a save after close is refused with the closed message, and the stored chat is kept",
      "input": {
        "ops": [
          {
            "call": "saveChat",
            "args": [
              {
                "id": "kept",
                "title": "k",
                "messages": [
                  {
                    "id": "m1",
                    "role": "user",
                    "content": "before the quit"
                  }
                ]
              }
            ]
          },
          {
            "call": "close"
          },
          {
            "call": "saveChat",
            "args": [
              {
                "id": "late",
                "title": "l",
                "messages": [
                  {
                    "id": "m2",
                    "role": "user",
                    "content": "after the quit"
                  }
                ]
              }
            ]
          },
          {
            "call": "reopen"
          },
          {
            "call": "loadChats"
          }
        ]
      },
      "expected": [
        {
          "success": true
        },
        null,
        {
          "success": false,
          "error": "The chat database is not open."
        },
        null,
        [
          {
            "id": "kept",
            "title": "k",
            "updatedAt": {
              "$any": "now"
            },
            "workspaceId": "default",
            "plan": null,
            "isOutOfContext": false,
            "isGenerating": false,
            "compaction": null,
            "messages": [
              {
                "id": "m1",
                "role": "user",
                "content": "before the quit"
              }
            ]
          }
        ]
      ]
    },
