            "call": "addCheckpoint",
            "args": [
              {
                "workspaceId": "default",
                "path": "/1",
                "createdAt": 1.5
              }
            ]
          },
          {
            "call": "listCheckpoints",
            "args": [
              "default"
            ]
          }
        ]
