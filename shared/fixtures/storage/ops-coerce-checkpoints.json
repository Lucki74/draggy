{
  "area": "storage",
  "description": "Ordered operation lists over checkpoints read the way addCheckpoint and listCheckpoints read their arguments: falsy and wrong-typed fields, hashes bound as the reference binds them, a null or non-object entry, and ids and limits given as text. Each case starts from an empty database. Same op and expected rules as ops-chats.json.",
  "cases": [
    {
      "name": "a checkpoint with null fields takes the default for each",
      "input": {
        "ops": [
          {
            "call": "addCheckpoint",
            "args": [
              {
                "workspaceId": null,
                "chatId": null,
                "path": null,
                "action": null,
                "detail": null,
                "beforeHash": null,
                "afterHash": null,
                "createdAt": null
              }
            ]
          },
          {
            "call": "listCheckpoints",
            "args": [
              "default"
            ]
          }
        ]
      },
      "expected": [
        {
          "success": true,
          "id": 1
        },
        [
          {
            "id": 1,
            "workspaceId": "default",
            "chatId": null,
            "path": "",
            "action": "write",
            "detail": null,
            "beforeHash": null,
            "afterHash": null,
            "createdAt": {
              "$any": "now"
            }
          }
        ]
      ]
    },
    {
      "name": "a falsy workspace id is the default, and a numeric action is text",
      "input": {
        "ops": [
          {
            "call": "addCheckpoint",
            "args": [
              {
                "workspaceId": 0,
                "path": "/a",
                "action": 3
              }
            ]
          },
          {
            "call": "listCheckpoints",
            "args": [
              "default"
            ]
          }
        ]
      },
      "expected": [
        {
          "success": true,
          "id": 1
        },
        [
          {
            "id": 1,
            "workspaceId": "default",
            "chatId": null,
            "path": "/a",
            "action": "3",
            "detail": null,
            "beforeHash": null,
            "afterHash": null,
            "createdAt": {
              "$any": "now"
            }
          }
        ]
      ]
    },
    {
      "name": "a numeric hash is stored as the text of a real number",
      "input": {
        "ops": [
          {
            "call": "addCheckpoint",
            "args": [
              {
                "workspaceId": "default",
                "path": "/a",
                "beforeHash": 5,
                "afterHash": 1.5
              }
            ]
          },
          {
            "call": "getCheckpoint",
            "args": [
              1
            ]
          },
          {
            "call": "query",
            "args": [
              "SELECT before_hash, typeof(before_hash), after_hash FROM checkpoints"
            ]
          }
        ]
      },
      "expected": [
        {
          "success": true,
          "id": 1
        },
        {
          "id": 1,
          "workspaceId": "default",
          "chatId": null,
          "path": "/a",
          "action": "write",
          "detail": null,
          "beforeHash": "5.0",
          "afterHash": "1.5",
          "createdAt": {
            "$any": "now"
          }
        },
        [
          [
            "5.0",
            "text",
            "1.5"
          ]
        ]
      ]
    },
    {
      "name": "a hash that cannot be stored refuses the record",
      "input": {
        "ops": [
          {
            "call": "addCheckpoint",
            "args": [
              {
                "workspaceId": "default",
                "path": "/a",
                "beforeHash": true
              }
            ]
          },
          {
            "call": "addCheckpoint",
            "args": [
              {
                "workspaceId": "default",
                "path": "/a",
                "afterHash": {}
              }
            ]
          },
          {
            "call": "listCheckpoints",
            "args": [
              "default"
            ]
          }
        ]
      },
      "expected": [
        {
          "threw": true
        },
        {
          "threw": true
        },
        []
      ]
    },
    {
      "name": "an entry that is null is refused, while any other non-object records a default checkpoint",
      "input": {
        "ops": [
          {
            "call": "addCheckpoint",
            "args": [
              null
            ]
          },
          {
            "call": "addCheckpoint",
            "args": [
              5
            ]
          },
          {
            "call": "addCheckpoint",
            "args": [
              "abc"
            ]
          },
          {
            "call": "listCheckpoints",
            "args": [
              "default"
            ]
          }
        ]
      },
      "expected": [
        {
          "threw": true
        },
        {
          "success": true,
          "id": 1
        },
        {
          "success": true,
          "id": 2
        },
        [
          {
            "id": 2,
            "workspaceId": "default",
            "chatId": null,
            "path": "",
            "action": "write",
            "detail": null,
            "beforeHash": null,
            "afterHash": null,
            "createdAt": {
              "$any": "now"
            }
          },
          {
            "id": 1,
            "workspaceId": "default",
            "chatId": null,
            "path": "",
            "action": "write",
            "detail": null,
            "beforeHash": null,
            "afterHash": null,
            "createdAt": {
              "$any": "now"
            }
          }
        ]
      ]
    },
