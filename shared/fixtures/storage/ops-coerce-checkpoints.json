    {
      "name": "an id that is not a whole number matches no checkpoint",
      "input": {
        "ops": [
          {
            "call": "addCheckpoint",
            "args": [
              {
                "workspaceId": "default",
                "path": "/1"
              }
            ]
          },
          {
            "call": "getCheckpoint",
            "args": [
              1.5
            ]
          },
          {
            "call": "dropCheckpoint",
            "args": [
              1.5
            ]
          },
          {
            "call": "getCheckpoint",
            "args": [
              1
            ]
          }
        ]
      },
      "expected": [
        {
          "success": true,
          "id": 1
        },
        null,
        {
          "success": true
        },
        {
          "id": 1,
          "workspaceId": "default",
          "chatId": null,
          "path": "/1",
          "action": "write",
          "detail": null,
          "beforeHash": null,
          "afterHash": null,
          "createdAt": {
            "$any": "now"
          }
        }
      ]
    },
    {
      "name": "a chat id of zero, and an empty or zero detail, are stored as none",
      "input": {
        "ops": [
          {
            "call": "addCheckpoint",
            "args": [
              {
                "workspaceId": "default",
                "path": "/1",
                "chatId": 0,
                "detail": ""
              }
            ]
          },
          {
            "call": "addCheckpoint",
            "args": [
              {
                "workspaceId": "default",
                "path": "/2",
                "chatId": "c",
                "detail": 0
              }
            ]
          },
          {
            "call": "addCheckpoint",
            "args": [
              {
                "workspaceId": "default",
                "path": "/3",
                "detail": 7
              }
            ]
          },
          {
            "call": "listCheckpoints",
            "args": [
              "default"
            ]
          }
        ]
      },
      "expected": [
        {
          "success": true,
          "id": 1
        },
        {
          "success": true,
          "id": 2
        },
        {
          "success": true,
          "id": 3
        },
        [
          {
            "id": 3,
            "workspaceId": "default",
            "chatId": null,
            "path": "/3",
            "action": "write",
            "detail": "7",
