    {
      "name": "a workspace id that is a list is stored as its empty text, not as the default",
      "input": {
        "ops": [
          {
            "call": "addCheckpoint",
            "args": [
              {
                "workspaceId": [],
                "path": "/list"
              }
            ]
          },
          {
            "call": "listCheckpoints",
            "args": [
              ""
            ]
          },
          {
            "call": "listCheckpoints",
            "args": [
              "default"
            ]
          }
        ]
      },
      "expected": [
        {
          "success": true,
          "id": 1
