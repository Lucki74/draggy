                "id": "c1",
                "title": "t",
                "messages": [
                  {
                    "id": "m1",
                    "role": 5,
                    "content": "a"
                  },
                  {
                    "id": "m2",
                    "role": 1.5,
                    "content": "b"
                  }
                ]
              }
            ]
          },
          {
            "call": "loadChats"
          },
          {
            "call": "query",
            "args": [
              "SELECT role, typeof(role) FROM messages ORDER BY row_id"
            ]
          }
        ]
      },
      "expected": [
        {
          "success": true
        },
        [
          {
            "id": "c1",
            "title": "t",
            "updatedAt": {
              "$any": "now"
            },
            "workspaceId": "default",
            "plan": null,
            "isOutOfContext": false,
            "isGenerating": false,
            "compaction": null,
            "messages": [
              {
                "id": "m1",
                "role": 5,
                "content": "a"
              },
              {
                "id": "m2",
                "role": 1.5,
                "content": "b"
              }
            ]
          }
        ],
        [
          [
            "5.0",
            "text"
          ],
          [
            "1.5",
            "text"
          ]
        ]
      ]
    },
