          {
            "id": "c1",
            "title": "t",
            "updatedAt": 12345,
            "workspaceId": "default",
            "plan": null,
            "isOutOfContext": false,
            "isGenerating": false,
            "compaction": null,
            "messages": []
          }
        ]
      ]
    },
