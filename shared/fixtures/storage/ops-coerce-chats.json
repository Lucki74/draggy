            "updatedAt": 1000,
            "workspaceId": "default",
            "isOutOfContext": false,
            "messageCount": 0
          }
        ]
      ]
    },
    {
      "name": "a message with a falsy id takes its position, and other ids are written as text",
      "input": {
        "ops": [
          {
            "call": "saveChat",
            "args": [
              {
                "id": "c1",
                "title": "t",
                "messages": [
                  {
                    "id": 0,
                    "role": "user",
                    "content": "a"
                  },
                  {
                    "id": 5,
                    "role": "user",
                    "content": "b"
                  },
                  {
                    "id": null,
                    "role": "user",
                    "content": "c"
                  },
                  {
                    "id": "",
                    "role": "user",
                    "content": "d"
                  },
                  {
                    "id": false,
                    "role": "assistant",
                    "content": "e"
                  },
                  {
                    "id": {},
                    "role": "user",
                    "content": "f"
                  },
                  {
                    "id": "kept",
                    "role": "user",
                    "content": "g"
                  }
                ]
              }
            ]
          },
          {
            "call": "loadChats"
          }
        ]
      },
      "expected": [
        {
          "success": true
        },
        [
          {
            "id": "c1",
            "title": "t",
            "updatedAt": {
              "$any": "now"
            },
            "workspaceId": "default",
            "plan": null,
            "isOutOfContext": false,
            "isGenerating": false,
            "compaction": null,
            "messages": [
              {
                "id": "message-0",
                "role": "user",
                "content": "a"
              },
              {
                "id": "5",
                "role": "user",
                "content": "b"
              },
              {
                "id": "message-2",
                "role": "user",
                "content": "c"
              },
              {
                "id": "message-3",
                "role": "user",
                "content": "d"
              },
              {
                "id": "message-4",
                "role": "assistant",
                "content": "e"
              },
              {
                "id": "[object Object]",
                "role": "user",
                "content": "f"
              },
              {
                "id": "kept",
                "role": "user",
                "content": "g"
              }
            ]
          }
        ]
      ]
    },
