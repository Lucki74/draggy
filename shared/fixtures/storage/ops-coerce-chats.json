{
  "area": "storage",
  "description": "Ordered operation lists over JavaScript-shaped chat input: falsy, numeric and wrong-typed fields that saveChat and importSessions coerce, message ids and roles, attachment lists, chat ids, key order in a payload, and import's own reading of a session. Each case starts from an empty database and runs ops in order: expected[i] is the result of ops[i], so later reads see earlier writes. Expected values are generated by electron/storage.cjs. Pseudo-op query returns raw rows as stored. A timestamp the call defaulted to now is written as {\"$any\":\"now\"}.",
  "cases": [
    {
      "name": "a chat with null title, workspace, time and flag saves with the defaults",
      "input": {
        "ops": [
          {
            "call": "saveChat",
            "args": [
              {
                "id": "c1",
                "title": null,
                "workspaceId": null,
                "updatedAt": null,
                "isOutOfContext": 0,
                "messages": []
              }
            ]
          },
          {
            "call": "loadChats"
          }
        ]
      },
      "expected": [
        {
          "success": true
        },
        [
          {
            "id": "c1",
            "title": "",
            "updatedAt": {
              "$any": "now"
            },
            "workspaceId": "default",
            "plan": null,
            "isOutOfContext": false,
            "isGenerating": false,
            "compaction": null,
            "messages": []
          }
        ]
      ]
    },
    {
      "name": "the out-of-context flag is read by truthiness",
      "input": {
        "ops": [
          {
            "call": "saveChat",
            "args": [
              {
                "id": "c1",
                "title": "one",
                "isOutOfContext": 1,
                "messages": [],
                "updatedAt": 1000
              }
            ]
          },
          {
            "call": "saveChat",
            "args": [
              {
                "id": "c2",
                "title": "two",
                "isOutOfContext": "yes",
                "messages": [],
                "updatedAt": 2000
              }
            ]
          },
          {
            "call": "saveChat",
            "args": [
              {
                "id": "c3",
                "title": "three",
                "isOutOfContext": "",
                "messages": [],
                "updatedAt": 3000
              }
            ]
          },
          {
            "call": "loadChatSummaries"
          }
        ]
      },
      "expected": [
        {
          "success": true
        },
        {
          "success": true
        },
        {
          "success": true
        },
        [
          {
            "id": "c3",
            "title": "three",
            "updatedAt": 3000,
            "workspaceId": "default",
            "isOutOfContext": false,
            "messageCount": 0
          },
          {
            "id": "c2",
            "title": "two",
            "updatedAt": 2000,
            "workspaceId": "default",
            "isOutOfContext": true,
            "messageCount": 0
          },
          {
            "id": "c1",
            "title": "one",
            "updatedAt": 1000,
            "workspaceId": "default",
            "isOutOfContext": true,
            "messageCount": 0
          }
        ]
      ]
    },
    {
      "name": "a fractional update time is kept as a real number",
      "input": {
        "ops": [
          {
            "call": "saveChat",
            "args": [
              {
                "id": "c1",
                "title": "t",
                "updatedAt": 1.5,
                "messages": []
              }
            ]
          },
          {
            "call": "loadChats"
          },
          {
            "call": "query",
            "args": [
              "SELECT updated_at, typeof(updated_at) FROM chats"
            ]
          }
        ]
      },
      "expected": [
        {
          "success": true
        },
        [
          {
            "id": "c1",
            "title": "t",
            "updatedAt": 1.5,
            "workspaceId": "default",
            "plan": null,
            "isOutOfContext": false,
            "isGenerating": false,
            "compaction": null,
            "messages": []
          }
        ],
        [
          [
            1.5,
            "real"
          ]
        ]
      ]
    },
    {
      "name": "a text update time is read as a number, and an unreadable one is now",
