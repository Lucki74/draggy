{
  "area": "storage",
  "description": "Ordered operation lists over per-turn statistics read the way recordMetric reads them: list-valued ids, numbers beyond the integer range, the tools map and its JavaScript key rules, first-token times, refusals of non-object and model-less turns, and a stored tools column that is not an object. Each case starts from an empty database. Same op and expected rules as ops-chats.json.",
  "cases": [
    {
      "name": "a workspace or chat id that is a list is stored as empty text, not as none",
      "input": {
        "ops": [
          {
            "call": "recordMetric",
            "args": [
              {
                "model": "m",
                "recordedAt": 1000,
                "workspaceId": [],
                "chatId": [
                  ""
                ]
              }
            ]
          },
          {
            "call": "listMetrics",
            "args": [
              0
            ]
          }
        ]
      },
      "expected": [
        {
          "success": true
        },
        [
          {
            "recordedAt": 1000,
            "workspaceId": "",
            "chatId": "",
            "model": "m",
            "promptTokens": 0,
            "responseTokens": 0,
            "responseMs": 0,
            "firstTokenMs": null,
            "loadMs": 0,
            "taskMs": 0,
            "loops": 1,
            "tools": {}
          }
        ]
      ]
    },
    {
      "name": "huge numbers are stored as they are, not clamped to the integer range",
      "input": {
        "ops": [
          {
            "call": "recordMetric",
            "args": [
              {
                "model": "m",
                "recordedAt": 1e+300,
                "promptTokens": 1e+300,
                "responseTokens": 1e+300,
                "responseMs": 1e+300,
                "loops": 1e+300
              }
            ]
          },
          {
            "call": "listMetrics",
            "args": [
              0
            ]
          }
        ]
      },
      "expected": [
        {
          "success": true
        },
        [
          {
            "recordedAt": 1e+300,
            "workspaceId": null,
            "chatId": null,
            "model": "m",
            "promptTokens": 1e+300,
            "responseTokens": 1e+300,
            "responseMs": 1e+300,
            "firstTokenMs": null,
            "loadMs": 0,
            "taskMs": 0,
            "loops": 1e+300,
            "tools": {}
          }
        ]
      ]
    },
