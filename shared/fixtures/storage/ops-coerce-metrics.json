    {
      "name": "a tool count that is not positive is dropped, and a fraction rounds down",
      "input": {
        "ops": [
          {
            "call": "recordMetric",
            "args": [
              {
                "model": "m",
                "recordedAt": 1000,
                "tools": {
                  "a": 0,
                  "b": -1,
                  "c": 2.9,
                  "d": "3",
                  "e": null,
                  "f": "x",
                  "g": [
                    4
                  ]
                }
              }
            ]
          },
          {
            "call": "listMetrics",
            "args": [
              0
            ]
          }
        ]
      },
      "expected": [
        {
          "success": true
        },
        [
          {
            "recordedAt": 1000,
            "workspaceId": null,
            "chatId": null,
            "model": "m",
            "promptTokens": 0,
            "responseTokens": 0,
            "responseMs": 0,
            "firstTokenMs": null,
            "loadMs": 0,
            "taskMs": 0,
            "loops": 1,
            "tools": {
              "c": 2,
              "d": 3,
              "g": 4
            }
          }
        ]
      ]
    },
