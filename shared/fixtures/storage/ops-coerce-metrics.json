    {
      "name": "a stored tools column that is not an object reads back as it was stored",
      "input": {
        "ops": [
          {
            "call": "sql",
            "args": [
              [
                "INSERT INTO metrics (recorded_at, model, tools) VALUES (1000, 'm', '[1]')",
                "INSERT INTO metrics (recorded_at, model, tools) VALUES (2000, 'm', 'null')",
                "INSERT INTO metrics (recorded_at, model, tools) VALUES (3000, 'm', '5')",
                "INSERT INTO metrics (recorded_at, model, tools) VALUES (4000, 'm', '\"x\"')",
                "INSERT INTO metrics (recorded_at, model, tools) VALUES (5000, 'm', '')",
                "INSERT INTO metrics (recorded_at, model, tools) VALUES (6000, 'm', 'not json')"
              ]
            ]
          },
          {
            "call": "listMetrics",
            "args": [
              0
            ]
          }
        ]
      },
      "expected": [
        null,
        [
          {
            "recordedAt": 6000,
            "workspaceId": null,
            "chatId": null,
            "model": "m",
            "promptTokens": 0,
            "responseTokens": 0,
            "responseMs": 0,
            "firstTokenMs": null,
            "loadMs": 0,
            "taskMs": 0,
            "loops": 1,
            "tools": {}
          },
