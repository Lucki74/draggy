    {
      "name": "a workspace with null fields saves with the defaults the reference uses",
      "input": {
        "ops": [
          {
            "call": "saveWorkspace",
            "args": [
              {
                "id": "w1",
                "name": null,
                "kind": null,
                "rootPath": null,
                "permissionMode": null,
                "settings": null,
                "grants": null,
                "createdAt": null
              }
            ]
          },
          {
            "call": "getWorkspace",
            "args": [
              "w1"
            ]
          }
        ]
      },
      "expected": [
        {
          "success": true,
          "workspace": {
            "id": "w1",
            "name": "",
            "kind": "chat",
            "rootPath": null,
            "permissionMode": "ask",
            "settings": {},
            "grants": [],
            "createdAt": {
              "$any": "now"
            },
            "updatedAt": {
              "$any": "now"
            }
          }
        },
        {
          "id": "w1",
          "name": "",
          "kind": "chat",
          "rootPath": null,
          "permissionMode": "ask",
          "settings": {},
          "grants": [],
          "createdAt": {
            "$any": "now"
          },
          "updatedAt": {
            "$any": "now"
          }
        }
      ]
    },
