    {
      "name": "deletes a removed project's chats rather than moving them into Chat",
      "input": {
        "ops": [
          {
            "call": "saveWorkspace",
            "args": [
              {
                "id": "w1",
                "name": "Workspace w1",
                "kind": "project",
                "settings": {},
                "createdAt": 500
              }
            ]
          },
          {
            "call": "saveChat",
            "args": [
              {
                "id": "a",
                "title": "Chat a",
                "updatedAt": 1000,
                "isOutOfContext": false,
                "messages": [
                  {
                    "id": "m1",
                    "role": "user",
                    "content": "fix the build",
                    "textContent": "fix the build"
                  }
                ],
                "workspaceId": "w1"
              }
            ]
          },
          {
            "call": "saveChat",
            "args": [
              {
                "id": "b",
                "title": "Chat b",
                "updatedAt": 2000,
                "isOutOfContext": false,
                "messages": [
                  {
                    "id": "m2",
                    "role": "user",
                    "content": "hi",
                    "textContent": "hi"
                  }
                ]
              }
            ]
          },
          {
            "call": "deleteWorkspace",
            "args": [
              "w1"
            ]
          },
          {
            "call": "listWorkspaces"
          },
          {
            "call": "loadChats"
          },
          {
            "call": "searchChats",
            "args": [
              "build"
            ]
          }
        ]
      },
      "expected": [
        {
          "success": true,
          "workspace": {
            "id": "w1",
            "name": "Workspace w1",
            "kind": "project",
            "rootPath": null,
            "permissionMode": "ask",
            "settings": {},
            "grants": [],
            "createdAt": 500,
            "updatedAt": {
              "$any": "now"
            }
          }
        },
        {
          "success": true
        },
        {
          "success": true
        },
        {
          "success": true,
          "deleted": 1
        },
        [
          {
            "id": "default",
            "name": "",
            "kind": "chat",
            "rootPath": null,
            "permissionMode": "auto",
            "settings": {},
            "grants": [],
            "createdAt": {
              "$any": "now"
            },
            "updatedAt": {
              "$any": "now"
            }
          }
        ],
        [
          {
            "id": "b",
            "title": "Chat b",
            "updatedAt": 2000,
            "workspaceId": "default",
            "plan": null,
            "isOutOfContext": false,
            "isGenerating": false,
            "compaction": null,
