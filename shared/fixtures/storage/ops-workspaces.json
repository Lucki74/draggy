{
  "area": "storage",
  "description": "Ordered operation lists over workspaces: the default workspace, adoption of chats with no workspace, edits that keep the creation day, project deletion, unreadable JSON columns read as empty, and grants. Same op and expected rules as ops-chats.json.",
  "cases": [
    {
      "name": "the first launch has one default workspace",
      "input": {
        "ops": [
          {
            "call": "listWorkspaces"
          }
        ]
      },
      "expected": [
        [
          {
            "id": "default",
            "name": "",
            "kind": "chat",
            "rootPath": null,
            "permissionMode": "auto",
            "settings": {},
            "grants": [],
            "createdAt": {
              "$any": "now"
            },
            "updatedAt": {
              "$any": "now"
            }
          }
        ]
      ]
    },
    {
      "name": "a chat with no workspace of its own goes into the default one",
      "input": {
        "ops": [
          {
            "call": "saveChat",
            "args": [
              {
                "id": "a",
                "title": "Chat a",
                "updatedAt": 1000,
                "isOutOfContext": false,
                "messages": [
                  {
                    "id": "m1",
                    "role": "user",
                    "content": "hi",
                    "textContent": "hi"
                  }
                ]
              }
            ]
          },
          {
            "call": "loadChats"
          },
          {
            "call": "loadChatSummaries"
          }
        ]
      },
      "expected": [
        {
          "success": true
        },
        [
          {
            "id": "a",
            "title": "Chat a",
            "updatedAt": 1000,
            "workspaceId": "default",
            "plan": null,
            "isOutOfContext": false,
            "isGenerating": false,
            "compaction": null,
            "messages": [
              {
                "id": "m1",
                "role": "user",
                "content": "hi",
                "textContent": "hi"
              }
            ]
          }
        ],
        [
          {
            "id": "a",
            "title": "Chat a",
            "updatedAt": 1000,
            "workspaceId": "default",
            "isOutOfContext": false,
            "messageCount": 1
          }
        ]
      ]
    },
    {
      "name": "keeps a chat in the workspace it was saved in",
      "input": {
        "ops": [
          {
            "call": "saveWorkspace",
            "args": [
              {
                "id": "w1",
                "name": "Workspace w1",
                "kind": "project",
                "rootPath": "C:\\projects\\thing",
                "permissionMode": "acceptEdits",
                "settings": {},
                "createdAt": 500
              }
            ]
          },
          {
            "call": "saveChat",
            "args": [
              {
                "id": "a",
                "title": "Chat a",
                "updatedAt": 1000,
                "isOutOfContext": false,
                "messages": [
                  {
                    "id": "m1",
                    "role": "user",
                    "content": "hi",
                    "textContent": "hi"
                  }
                ],
                "workspaceId": "w1"
              }
            ]
          },
          {
            "call": "loadChats"
          }
        ]
      },
      "expected": [
        {
          "success": true,
          "workspace": {
            "id": "w1",
            "name": "Workspace w1",
            "kind": "project",
            "rootPath": "C:\\projects\\thing",
            "permissionMode": "acceptEdits",
            "settings": {},
            "grants": [],
            "createdAt": 500,
            "updatedAt": {
              "$any": "now"
            }
          }
        },
        {
          "success": true
        },
        [
          {
            "id": "a",
            "title": "Chat a",
            "updatedAt": 1000,
            "workspaceId": "w1",
            "plan": null,
            "isOutOfContext": false,
            "isGenerating": false,
            "compaction": null,
            "messages": [
              {
                "id": "m1",
                "role": "user",
                "content": "hi",
                "textContent": "hi"
              }
            ]
          }
        ]
      ]
    },
