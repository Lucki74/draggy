            "logs": [
              {
                "level": "info",
                "scope": "net.search",
                "message": "search answered",
                "data": {
                  "provider": "searxng",
                  "results": 1,
                  "durationMs": 0
                }
              }
            ]
          },
          {
            "status": "ok",
            "provider": "searxng",
            "cached": true,
            "called": [],
            "logs": []
          }
        ]
      }
    },
    {
      "name": "an outage logs one failure from every provider and no empty event",
      "input": {
        "ops": [
          {
            "query": "rare zq9417",
            "config": {
              "searchProvider": "auto",
              "searxngUrl": "http://searx.test:8080",
              "braveApiKey": ""
            },
            "responses": {
              "searxng": {
                "error": "offline"
              },
              "duckduckgo": {
                "error": "offline"
              },
              "startpage": {
                "error": "offline"
              },
              "duckduckgo-lite": {
                "error": "offline"
              },
              "brave-html": {
                "error": "offline"
              }
            }
          }
        ]
      },
      "expected": {
        "steps": [
          {
            "status": "unavailable",
            "provider": null,
            "cached": false,
            "called": [
              "searxng",
              "duckduckgo",
              "startpage",
              "duckduckgo-lite",
              "brave-html"
            ],
            "logs": [
              {
                "level": "warn",
                "scope": "net.search",
                "message": "provider failed",
                "data": {
                  "provider": "searxng",
                  "durationMs": 0,
                  "error": "offline"
                }
              },
              {
                "level": "warn",
                "scope": "net.search",
                "message": "provider failed",
                "data": {
                  "provider": "duckduckgo",
                  "durationMs": 0,
                  "error": "offline"
                }
              },
              {
                "level": "warn",
                "scope": "net.search",
                "message": "provider failed",
                "data": {
                  "provider": "startpage",
                  "durationMs": 0,
                  "error": "offline"
                }
              },
              {
                "level": "warn",
                "scope": "net.search",
                "message": "provider failed",
                "data": {
                  "provider": "duckduckgo-lite",
                  "durationMs": 0,
                  "error": "offline"
                }
              },
              {
                "level": "warn",
                "scope": "net.search",
                "message": "provider failed",
                "data": {
                  "provider": "brave-html",
                  "durationMs": 0,
                  "error": "offline"
                }
              }
