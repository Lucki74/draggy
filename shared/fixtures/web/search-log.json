    },
    {
      "name": "a provider held back by its gap logs the time it waited",
      "input": {
        "ops": [
          {
            "query": "first question",
            "config": {
              "searchProvider": "auto",
              "searxngUrl": "http://searx.test:8080",
              "braveApiKey": ""
            },
            "responses": {
              "searxng": {
                "body": "{\"results\":[{\"title\":\"A\",\"url\":\"https://a.example/\",\"content\":\"one\"}]}"
              }
            }
          },
          {
            "at": 1000100,
            "query": "second question",
            "config": {
              "searchProvider": "auto",
              "searxngUrl": "http://searx.test:8080",
              "braveApiKey": ""
            },
            "responses": {
              "searxng": {
                "body": "{\"results\":[{\"title\":\"B\",\"url\":\"https://b.example/\",\"content\":\"two\"}]}"
              }
            }
          }
        ]
      },
      "expected": {
        "steps": [
          {
            "status": "ok",
            "provider": "searxng",
            "cached": false,
            "called": [
              "searxng"
            ],
            "logs": [
              {
                "level": "info",
                "scope": "net.search",
                "message": "search answered",
                "data": {
                  "provider": "searxng",
                  "results": 1,
                  "durationMs": 0
                }
              }
            ]
          },
          {
            "status": "ok",
            "provider": "searxng",
            "cached": false,
            "called": [
              "searxng"
            ],
            "logs": [
              {
                "level": "info",
                "scope": "net.search",
                "message": "search answered",
                "data": {
                  "provider": "searxng",
                  "results": 1,
                  "durationMs": 800
                }
              }
            ]
          }
        ]
      }
    },
