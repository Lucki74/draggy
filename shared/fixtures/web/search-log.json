{
  "area": "web",
  "description": "The net.search events a search logs, per step of an ordered op list. An answer logs 'search answered' with the provider, result count and time taken; an empty page logs 'search empty'; a failure logs 'provider failed' with its message, the query cut out and the rest cut at 120 units. Steps share one cache and pacing history on a virtual clock, so durations include the wait for a provider's gap. A cache hit logs nothing, and no logged text holds the query. Each step gives the status, the provider, whether it came from the cache, the providers called and its events.",
  "cases": [
    {
      "name": "an answer logs the provider, its result count and the time taken",
      "input": {
        "ops": [
          {
            "query": "rare zq9417",
            "config": {
              "searchProvider": "auto",
              "searxngUrl": "http://searx.test:8080",
              "braveApiKey": ""
            },
            "responses": {
              "searxng": {
                "body": "{\"results\":[{\"title\":\"A\",\"url\":\"https://a.example/\",\"content\":\"one\"},{\"title\":\"B\",\"url\":\"https://b.example/\",\"content\":\"two\"}]}"
              }
            }
          }
        ]
      },
      "expected": {
        "steps": [
          {
            "status": "ok",
            "provider": "searxng",
            "cached": false,
            "called": [
              "searxng"
            ],
            "logs": [
              {
                "level": "info",
                "scope": "net.search",
                "message": "search answered",
                "data": {
                  "provider": "searxng",
                  "results": 2,
                  "durationMs": 0
                }
              }
            ]
          }
        ]
      }
    },
    {
      "name": "a failing provider logs its error with the query cut out, then the next provider answers",
      "input": {
        "ops": [
          {
            "query": "rare zq9417",
            "config": {
              "searchProvider": "auto",
              "searxngUrl": "http://searx.test:8080",
              "braveApiKey": ""
            },
            "responses": {
              "searxng": {
                "error": "GET https://searx.test:8080/search?q=rare+zq9417&format=json failed for rare zq9417"
              },
              "duckduckgo": {
                "body": "<div class=\"result\"><a class=\"result__a\" href=\"https://x.example/one\">One</a><div class=\"result__snippet\">first</div></div>"
              }
            }
          }
        ]
      },
      "expected": {
        "steps": [
          {
            "status": "ok",
            "provider": "duckduckgo",
            "cached": false,
            "called": [
              "searxng",
              "duckduckgo"
            ],
            "logs": [
              {
                "level": "warn",
                "scope": "net.search",
                "message": "provider failed",
                "data": {
                  "provider": "searxng",
                  "durationMs": 0,
                  "error": "GET https://searx.test:8080/search?q=[query]&format=json failed for [query]"
                }
              },
              {
                "level": "info",
                "scope": "net.search",
                "message": "search answered",
                "data": {
                  "provider": "duckduckgo",
                  "results": 1,
                  "durationMs": 0
                }
              }
            ]
          }
        ]
      }
    },
    {
      "name": "an empty answer logs search empty and moves on",
      "input": {
        "ops": [
          {
            "query": "rare zq9417",
            "config": {
              "searchProvider": "auto",
              "searxngUrl": "http://searx.test:8080",
              "braveApiKey": ""
            },
            "responses": {
              "searxng": {
                "body": "{\"results\":[]}"
              },
              "duckduckgo": {
                "body": "<div class=\"result\"><a class=\"result__a\" href=\"https://x.example/one\">One</a><div class=\"result__snippet\">first</div></div>"
              }
            }
          }
        ]
      },
      "expected": {
        "steps": [
          {
            "status": "ok",
            "provider": "duckduckgo",
            "cached": false,
            "called": [
              "searxng",
              "duckduckgo"
            ],
            "logs": [
              {
                "level": "info",
                "scope": "net.search",
                "message": "search empty",
                "data": {
                  "provider": "searxng",
                  "results": 0,
                  "durationMs": 0
                }
              },
              {
                "level": "info",
                "scope": "net.search",
                "message": "search answered",
                "data": {
                  "provider": "duckduckgo",
                  "results": 1,
                  "durationMs": 0
                }
              }
            ]
          }
        ]
      }
    },
    {
      "name": "a long failure message is cut at 120 units",
      "input": {
        "ops": [
          {
            "query": "rare zq9417",
            "config": {
              "searchProvider": "auto",
              "searxngUrl": "http://searx.test:8080",
              "braveApiKey": ""
            },
            "responses": {
              "searxng": {
                "error": "upstream said the request was refused by the gateway, which keeps the long reason text going well past the limit of one hundred and twenty units"
              },
              "duckduckgo": {
                "body": "<div class=\"result\"><a class=\"result__a\" href=\"https://x.example/one\">One</a><div class=\"result__snippet\">first</div></div>"
              }
            }
          }
        ]
      },
      "expected": {
        "steps": [
          {
            "status": "ok",
            "provider": "duckduckgo",
            "cached": false,
            "called": [
              "searxng",
              "duckduckgo"
            ],
            "logs": [
              {
                "level": "warn",
                "scope": "net.search",
                "message": "provider failed",
                "data": {
                  "provider": "searxng",
                  "durationMs": 0,
                  "error": "upstream said the request was refused by the gateway, which keeps the long reason text going well past the limit of one "
                }
              },
              {
                "level": "info",
                "scope": "net.search",
                "message": "search answered",
                "data": {
                  "provider": "duckduckgo",
                  "results": 1,
                  "durationMs": 0
                }
              }
            ]
          }
        ]
      }
    },
