            },
            "responses": {
              "searxng": {
                "body": "{\"results\":[{\"title\":\"A\",\"url\":\"https://a.example/\",\"content\":\"one\"}]}"
              }
            }
          },
          {
            "query": "rare zq9417",
            "config": {
              "searchProvider": "auto",
