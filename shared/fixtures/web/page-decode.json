{
  "area": "web",
  "description": "How a scraped page body is decoded, as a browser decodes it: a byte order mark first, then the charset the Content-Type names, then UTF-8. Unknown charsets and missing ones read as UTF-8. Input is the Content-Type and the raw bytes. TS stand-in: TextDecoder with the same byte order mark checks. <meta charset> and the locale default are not modelled.",
  "cases": [
    {
      "name": "no Content-Type reads UTF-8",
      "input": {
        "contentType": null,
        "bytes": [
          99,
          97,
          102,
          195,
          169
        ]
      },
      "expected": "café"
    },
    {
      "name": "text/html with no charset reads UTF-8",
      "input": {
        "contentType": "text/html",
        "bytes": [
          99,
          97,
          102,
          195,
          169
        ]
      },
      "expected": "café"
    },
    {
      "name": "a charset parameter decodes Latin-1 bytes",
      "input": {
        "contentType": "text/html; charset=iso-8859-1",
        "bytes": [
          99,
          97,
          102,
          233
        ]
      },
      "expected": "café"
    },
    {
      "name": "the charset name ignores case and quotes",
      "input": {
        "contentType": "text/html; Charset=\"ISO-8859-1\"",
        "bytes": [
          99,
          97,
          102,
          233
        ]
      },
      "expected": "café"
    },
    {
      "name": "spaces around the charset parameter are allowed",
      "input": {
        "contentType": "text/html ;  charset = utf-8 ",
        "bytes": [
          99,
          97,
          102,
          195,
          169
        ]
      },
      "expected": "café"
    },
    {
      "name": "an unknown charset falls back to UTF-8",
      "input": {
        "contentType": "text/html; charset=no-such-set",
        "bytes": [
          99,
          97,
          102,
          195,
          169
        ]
      },
      "expected": "café"
    },
    {
      "name": "an empty charset value falls back to UTF-8",
      "input": {
        "contentType": "text/html; charset=",
        "bytes": [
          99,
          97,
          102,
          195,
          169
        ]
      },
      "expected": "café"
    },
    {
      "name": "windows-1252 reads the 0x80 range as Windows characters",
      "input": {
        "contentType": "text/html; charset=windows-1252",
        "bytes": [
          128,
          65
        ]
      },
      "expected": "€A"
    },
    {
      "name": "the latin1 label reads curly quotes in the 0x80 range",
      "input": {
        "contentType": "text/html; charset=latin1",
        "bytes": [
          147,
          148
        ]
      },
      "expected": "“”"
    },
    {
      "name": "Shift_JIS bytes decode as Japanese",
      "input": {
        "contentType": "text/html; charset=shift_jis",
        "bytes": [
          147,
          250,
          150,
          123
        ]
      },
      "expected": "日本"
    },
    {
      "name": "GBK bytes decode as Chinese",
      "input": {
        "contentType": "text/html; charset=gbk",
        "bytes": [
          214,
          208,
          206,
          196
        ]
      },
      "expected": "中文"
    },
    {
      "name": "invalid UTF-8 becomes replacement characters",
      "input": {
        "contentType": "text/html; charset=utf-8",
        "bytes": [
          97,
          255,
          98
        ]
      },
      "expected": "a�b"
    },
    {
      "name": "a UTF-8 byte order mark is dropped",
      "input": {
        "contentType": null,
        "bytes": [
          239,
          187,
          191,
          111,
          107
        ]
      },
      "expected": "ok"
    },
    {
      "name": "a UTF-8 byte order mark beats the charset header",
      "input": {
        "contentType": "text/html; charset=iso-8859-1",
        "bytes": [
          239,
          187,
          191,
          99,
          97,
          102,
          195,
          169
        ]
      },
      "expected": "café"
    },
    {
      "name": "a UTF-16LE byte order mark reads UTF-16 whatever the header says",
      "input": {
        "contentType": "text/html; charset=iso-8859-1",
        "bytes": [
          255,
          254,
          111,
          0,
          107,
          0
        ]
      },
      "expected": "ok"
    },
    {
      "name": "a utf-16le charset reads its bytes as UTF-16",
      "input": {
        "contentType": "text/html; charset=utf-16le",
        "bytes": [
          111,
          0,
          107,
          0
        ]
      },
      "expected": "ok"
    }
  ]
}
