{
  "area": "web",
  "description": "Page reading: metadata from JSON-LD, OpenGraph and meta, script-shell detection, the PDF branch, paging and the page note.",
  "cases": [
    {
      "name": "json-ld wins over opengraph and resolves the canonical link",
      "input": {
        "op": "metadata",
        "html": "<!doctype html><html lang=\"en-GB\"><head><title>Fallback title</title>\n<link rel=\"canonical\" href=\"/news/story-1\">\n<meta property=\"og:title\" content=\"OG title\">\n<meta property=\"og:site_name\" content=\"OG Site\">\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"NewsMediaOrganization\",\"name\":\"The Daily Example\"},{\"@type\":\"NewsArticle\",\"headline\":\"Rates &amp; reality\",\"author\":[{\"@type\":\"Person\",\"name\":\"Ada Lovelace\"},{\"@type\":\"Person\",\"name\":\"Alan Turing\"}],\"datePublished\":\"2026-03-04T09:00:00Z\",\"dateModified\":\"2026-03-05T10:30:00Z\",\"publisher\":{\"@type\":\"Organization\",\"name\":\"Daily Example Ltd\"},\"inLanguage\":\"en-GB\"}]}</script>\n</head><body><p>x</p></body></html>",
        "url": "https://news.example.com/a?utm=1"
      },
      "expected": {
        "title": "Rates & reality",
        "site": "Daily Example Ltd",
        "author": "Ada Lovelace, Alan Turing",
        "published": "2026-03-04T09:00:00Z",
        "modified": "2026-03-05T10:30:00Z",
        "language": "en-GB",
        "canonical": "https://news.example.com/news/story-1"
      }
    },
    {
      "name": "opengraph and meta fill what json-ld lacks",
      "input": {
        "op": "metadata",
        "html": "<html lang=\"fr\"><head><title> Plain   title </title>\n<meta property=\"og:title\" content=\"Titre OG\">\n<meta property=\"og:site_name\" content=\"Le Site\">\n<meta property=\"article:published_time\" content=\"2025-12-01\">\n<meta property=\"article:modified_time\" content=\"2025-12-02\">\n<meta name=\"author\" content=\"Marie Curie\">\n<meta property=\"og:url\" content=\"https://example.com/fr/page\">\n</head><body></body></html>",
        "url": "https://example.com/fr/x"
      },
      "expected": {
        "title": "Titre OG",
        "site": "Le Site",
        "author": "Marie Curie",
        "published": "2025-12-01",
        "modified": "2025-12-02",
        "language": "fr",
        "canonical": "https://example.com/fr/page"
      }
    },
    {
      "name": "plain meta and the title tag",
      "input": {
        "op": "metadata",
        "html": "<html><head><title>Only a title</title>\n<meta name=\"description\" content=\"ignored\">\n<meta name=\"date\" content=\"2024-01-02\">\n<meta name='application-name' content='App Name'>\n<link rel=\"canonical\" href=\"https://example.com/c\">\n</head></html>",
        "url": "https://example.com/p"
      },
      "expected": {
        "title": "Only a title",
        "site": "App Name",
        "author": null,
        "published": "2024-01-02",
        "modified": null,
        "language": null,
        "canonical": "https://example.com/c"
      }
    },
    {
      "name": "malformed json-ld is skipped",
      "input": {
        "op": "metadata",
        "html": "<html><head><script type=\"application/ld+json\">{not json</script><title>Survives</title></head></html>",
        "url": "https://example.com/"
      },
      "expected": {
        "title": "Survives",
        "site": null,
        "author": null,
        "published": null,
        "modified": null,
        "language": null,
        "canonical": null
      }
    },
    {
      "name": "an empty root div with scripts is a shell",
      "input": {
        "op": "shell",
        "html": "<!doctype html><html><head><title>App</title><script src=\"/app.js\"></script></head><body><div id=\"root\"></div><noscript>You need to enable JavaScript to run this app.</noscript><script>window.__DATA__={}</script></body></html>"
      },
      "expected": true
    },
    {
      "name": "real prose with a script is not a shell",
      "input": {
        "op": "shell",
        "html": "<html><head><script>var a=1</script></head><body><article><p>A sentence of real prose that a reader can see. A sentence of real prose that a reader can see. A sentence of real prose that a reader can see. A sentence of real prose that a reader can see. A sentence of real prose that a reader can see. A sentence of real prose that a reader can see. A sentence of real prose that a reader can see. A sentence of real prose that a reader can see. A sentence of real prose that a reader can see. A sentence of real prose that a reader can see. </p></article></body></html>"
      },
      "expected": false
    },
    {
      "name": "a short page without scripts is not a shell",
      "input": {
        "op": "shell",
        "html": "<html><body><p>Hi</p></body></html>"
      },
      "expected": false
    },
    {
      "name": "short text goes to the rendered window",
      "input": {
        "op": "needsRender",
        "markdown": "",
        "html": "<html><body><p>Hi</p></body></html>"
      },
      "expected": true
    },
    {
      "name": "enough text stays on the fast path",
      "input": {
        "op": "needsRender",
        "markdown": "",
        "html": "<html><head><script>var a=1</script></head><body><article><p>A sentence of real prose that a reader can see. A sentence of real prose that a reader can see. A sentence of real prose that a reader can see. A sentence of real prose that a reader can see. A sentence of real prose that a reader can see. A sentence of real prose that a reader can see. A sentence of real prose that a reader can see. A sentence of real prose that a reader can see. A sentence of real prose that a reader can see. A sentence of real prose that a reader can see. </p></article></body></html>"
      },
      "expected": false
    },
    {
      "name": "enough text from a shell still renders",
      "input": {
        "op": "needsRender",
        "markdown": "",
        "html": "<!doctype html><html><head><title>App</title><script src=\"/app.js\"></script></head><body><div id=\"root\"></div><noscript>You need to enable JavaScript to run this app.</noscript><script>window.__DATA__={}</script></body></html>"
      },
      "expected": true
    },
    {
      "name": "the content type decides",
      "input": {
        "op": "pdf",
        "contentType": "application/pdf",
        "url": "https://example.com/download?id=3"
      },
      "expected": true
    },
    {
      "name": "the content type may carry parameters",
      "input": {
        "op": "pdf",
        "contentType": "Application/PDF; charset=binary",
        "url": "https://example.com/x"
      },
      "expected": true
    },
    {
      "name": "a pdf address with no type is a pdf",
      "input": {
        "op": "pdf",
        "contentType": "",
        "url": "https://example.com/files/paper.PDF"
      },
      "expected": true
    },
    {
      "name": "an html page at a pdf address is html",
      "input": {
        "op": "pdf",
        "contentType": "text/html; charset=utf-8",
        "url": "https://example.com/viewer.pdf"
      },
      "expected": false
    },
    {
      "name": "an ordinary page is not a pdf",
      "input": {
        "op": "pdf",
        "contentType": "text/html",
        "url": "https://example.com/a"
      },
      "expected": false
    },
    {
      "name": "everything fits on one page",
      "input": {
        "op": "split",
        "markdown": "P1 xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\n\nP2 xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\n\nP3 xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
        "size": 200
      },
      "expected": {
        "lengths": [
          124
        ],
        "starts": [
          "P1"
        ]
      }
    },
    {
      "name": "pages break between paragraphs",
      "input": {
        "op": "split",
        "markdown": "P1 xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\n\nP2 xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\n\nP3 xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\n\nP4 xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
        "size": 130
      },
      "expected": {
        "lengths": [
          122,
          122
        ],
        "starts": [
          "P1",
          "P3"
        ]
      }
    },
    {
      "name": "a paragraph over the size is cut on the size",
      "input": {
        "op": "split",
        "markdown": "P1 xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\n\nP2 xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
        "size": 60
      },
      "expected": {
        "lengths": [
          60,
          40,
          50
        ],
        "starts": [
          "P1",
          "xx",
          "P2"
        ]
      }
    },
    {
      "name": "empty text is one empty page",
      "input": {
        "op": "split",
        "markdown": "  ",
        "size": 100
      },
      "expected": {
        "lengths": [
          0
        ],
        "starts": [
          ""
        ]
      }
    },
    {
      "name": "a single page has no note",
      "input": {
        "op": "note",
        "page": 1,
        "count": 1
      },
      "expected": ""
    },
    {
      "name": "the first page says how to continue",
      "input": {
        "op": "note",
        "page": 1,
        "count": 3
      },
      "expected": "Page 1 of 3. More follows: call read_url again with the same url and page=2 to read the next page."
    },
    {
      "name": "the last page says so",
      "input": {
        "op": "note",
        "page": 3,
        "count": 3
      },
      "expected": "Page 3 of 3. This is the last page."
    }
  ]
}
