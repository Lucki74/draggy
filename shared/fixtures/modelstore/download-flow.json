{
  "area": "modelstore",
  "description": "Ordered operations on one scratch models folder with a scripted https server: each op's result, the files left behind and each request's URL and Range. A start op begins a download without awaiting it; an await op settles it.",
  "cases": [
    {
      "name": "a whole file lands under its name and no partial is left",
      "input": {
        "replies": [
          {
            "status": 200,
            "headers": {
              "content-length": "10"
            },
            "body": [
              {
                "data": "0123456789"
              }
            ]
          }
        ],
        "ops": [
          {
            "op": "download",
            "args": {
              "url": "https://huggingface.co/acme/Model-GGUF/resolve/main/model.gguf"
            }
          }
        ]
      },
      "expected": {
        "results": [
          {
            "success": true,
            "filename": "model.gguf"
          }
        ],
        "files": [
          {
            "name": "model.gguf",
            "content": "0123456789"
          }
        ],
        "requests": [
          {
            "url": "https://huggingface.co/acme/Model-GGUF/resolve/main/model.gguf",
            "range": null
          }
        ]
      }
    },
    {
      "name": "a filename without the gguf suffix gets it",
      "input": {
        "replies": [
          {
            "status": 200,
