              "filename": "model"
            }
          }
        ]
      },
      "expected": {
        "results": [
          {
            "success": true,
            "filename": "model.gguf"
          }
        ],
        "files": [
          {
            "name": "model.gguf",
            "content": "0123456789"
          }
        ],
        "requests": [
          {
            "url": "https://huggingface.co/acme/Model-GGUF/resolve/main/model.gguf",
            "range": null
          }
        ]
      }
    },
