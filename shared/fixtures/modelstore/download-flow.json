        "requests": [
          {
            "url": "https://huggingface.co/acme/Model-GGUF/resolve/main/model.gguf",
            "range": null
          }
        ]
      }
    },
    {
      "name": "a failed replacement keeps the installed model and the bytes it got",
      "input": {
        "seed": [
          {
            "name": "model.gguf",
            "content": "installed"
          }
        ],
        "replies": [
          {
            "status": 200,
            "headers": {
              "content-length": "10"
            },
            "body": [
              {
                "data": "01234"
              },
              {
                "fail": "connection reset"
              }
            ]
          }
        ],
        "ops": [
          {
            "op": "download",
            "args": {
              "url": "https://huggingface.co/acme/Model-GGUF/resolve/main/model.gguf",
              "retries": 0,
              "retryDelayMs": 1
            }
          }
        ]
      },
      "expected": {
        "results": [
          {
            "error": "The connection closed before the download finished"
          }
        ],
        "files": [
          {
            "name": "model.gguf",
            "content": "installed"
          },
          {
            "name": "model.gguf.download",
            "content": "01234"
          }
        ],
        "requests": [
          {
            "url": "https://huggingface.co/acme/Model-GGUF/resolve/main/model.gguf",
            "range": null
          }
        ]
      }
    },
