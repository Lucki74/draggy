    {
      "name": "a refused entry keeps its measurements and stays off",
      "input": {
        "initial": {
          "x.gguf": {
            "rate": 0.5,
            "samples": 4,
            "refused": true
          }
        },
        "ops": [],
        "model": "/m/x.gguf"
      },
      "expected": {
