    {
      "name": "a stored entry with no sample count is read as measured",
      "input": {
        "initial": {
          "x.gguf": {
            "rate": 0.9
          }
        },
        "ops": [],
        "model": "/m/x.gguf"
      },
      "expected": {
        "settings": {
          "enabled": true,
          "max": 16,
          "rate": 0.9
        },
        "stored": {
          "x.gguf": {
            "rate": 0.9
          }
        }
      }
    },
    {
      "name": "a stored value that is not an object is read as empty",
      "input": {
        "initial": 5,
        "ops": [
          {
            "op": "record",
            "model": "/m/a.gguf",
            "rate": 0.9,
            "accepted": 9,
            "generated": 10
          },
          {
            "op": "record",
            "model": "/m/a.gguf",
            "rate": 0.9,
