    {
      "name": "each model's entry is kept in the same file",
      "input": {
        "initial": null,
        "ops": [
          {
            "op": "record",
            "model": "/m/a.gguf",
            "rate": 0.9,
            "accepted": 9,
            "generated": 10
          },
          {
            "op": "record",
            "model": "/m/b.gguf",
            "rate": 0.1,
            "accepted": 1,
            "generated": 10
          }
        ],
        "model": "/m/b.gguf"
      },
      "expected": {
        "settings": {
          "enabled": true,
          "max": 8,
          "rate": 0.1
        },
        "stored": {
          "a.gguf": {
            "rate": 0.9,
            "samples": 1
          },
          "b.gguf": {
            "rate": 0.1,
            "samples": 1
          }
        }
      }
    }
