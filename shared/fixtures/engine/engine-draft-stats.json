          }
        },
        "ops": [],
        "model": "/m/x.gguf"
      },
      "expected": {
        "settings": {
          "enabled": true,
          "max": 16,
          "rate": 0.8
        },
        "stored": {
          "x.gguf": {
            "rate": 0.8,
            "samples": 5
          }
        }
      }
    },
