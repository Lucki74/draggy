{
  "area": "engine",
  "description": "Windows registry text to drive list. `mountedDevices` and `diskEnum` parse `reg query` output into entries; `drives` joins them with the space map (volume to {sizeBytes, freeBytes}, null when unknown); `smartAppControl` reads the Smart App Control value. Text inputs are the registry output as-is.",
  "cases": [
    {
      "name": "mounted devices from a real query",
      "input": {
        "op": "mountedDevices",
        "text": "\nHKEY_LOCAL_MACHINE\\SYSTEM\\MountedDevices\n    \\DosDevices\\C:    REG_BINARY    444D494F3A49443A16DAF3F7A1B2C3D4E5F60718\n    \\DosDevices\\D:    REG_BINARY    444D494F3A49443A99DAF3F7A1B2C3D4E5F60718\n    \\DosDevices\\E:    REG_BINARY    5F003F003F005F00550053004200530054004F00520023004400690073006B002600560065006E005F004C0065007800610072002600500072006F0064005F005500530042005F0046006C006100730068005F00440072006900760065002300300023007B0078007D00\n    \\DosDevices\\F:    REG_BINARY    5F003F003F005F00530043005300490023004300640052006F006D002600560065006E005F0048004C002D00440054002D005300540023003100\n    \\??\\Volume{1234}    REG_BINARY    444D494F3A49443A16DAF3F7A1B2C3D4E5F60718\n\n"
      },
      "expected": [
        {
          "letter": "C",
          "usb": false
        },
        {
          "letter": "D",
          "usb": false
        },
        {
          "letter": "E",
          "usb": true
        }
      ]
    },
    {
      "name": "mounted devices keep first-seen order and the last USB flag",
      "input": {
        "op": "mountedDevices",
        "text": "HKEY_LOCAL_MACHINE\\SYSTEM\\MountedDevices\n    \\DosDevices\\E:    REG_BINARY    5F003F003F005F00550053004200530054004F00520023004400690073006B002600560065006E005F00530061006E004400690073006B002300300030003000310023007B0035003300660035007D00\n    \\DosDevices\\c:    REG_BINARY    444D494F3A49443A16DAF3F7A1B2C3D4E5F60718\n    \\DosDevices\\D:    REG_BINARY    5F003F003F005F004300440052004F004D0030005F0046006C006F00700070007900\n    \\DosDevices\\E:    REG_BINARY    5F003F003F005F00550053004200530054004F00520023004400690073006B002600560065006E005F004B0069006E006700730074006F006E002300300030003000320023007B0035003300660035007D00\n"
      },
      "expected": [
        {
          "letter": "E",
          "usb": true
        },
        {
          "letter": "C",
          "usb": false
        }
      ]
    },
    {
      "name": "mounted devices from an error message",
      "input": {
        "op": "mountedDevices",
        "text": "ERROR: Access is denied.\n"
      },
      "expected": []
    },
    {
      "name": "disk enum with two NVMe disks and a USB stick",
      "input": {
        "op": "diskEnum",
        "text": "\nHKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Services\\disk\\Enum\n    0    REG_SZ    SCSI\\Disk&Ven_NVMe&Prod_SAMSUNG_MZVL21T0\\4&22a0e0d9&0&020000\n    1    REG_SZ    SCSI\\Disk&Ven_NVMe&Prod_WD_BLACK_SN850_P\\4&22a0e0d9&0&010000\n    2    REG_SZ    USBSTOR\\Disk&Ven_Lexar&Prod_USB_Flash_Drive&Rev_\\0123&0\n    Count    REG_DWORD    0x3\n    NextInstance    REG_DWORD    0x3\n\n"
      },
      "expected": [
