          "diskKey": "volume:D",
          "name": "",
          "bus": "nvme",
          "role": "good",
          "sizeBytes": 1000000000000,
          "freeBytes": 1090000000000
        },
        {
          "volume": "E:\\",
          "diskId": null,
          "diskKey": "volume:E",
          "name": "",
          "bus": "usb",
          "role": "refuse",
          "sizeBytes": 60000000000,
          "freeBytes": 50000000000
        }
      ]
