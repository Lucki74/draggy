          "index": 0,
          "bus": "nvme",
          "name": "SAMSUNG MZVL21T0",
          "instance": "SCSI\\Disk&Ven_NVMe&Prod_SAMSUNG_MZVL21T0\\4&22a0e0d9&0&020000"
        },
        {
          "index": 1,
          "bus": "nvme",
          "name": "WD BLACK SN850 P",
          "instance": "SCSI\\Disk&Ven_NVMe&Prod_WD_BLACK_SN850_P\\4&22a0e0d9&0&010000"
        },
        {
          "index": 2,
          "bus": "usb",
          "name": "USB Flash Drive",
          "instance": "USBSTOR\\Disk&Ven_Lexar&Prod_USB_Flash_Drive&Rev_\\0123&0"
        }
      ]
    },
    {
      "name": "disk enum with one internal disk",
      "input": {
        "op": "diskEnum",
        "text": "\nHKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Services\\disk\\Enum\n    0    REG_SZ    SCSI\\Disk&Ven_NVMe&Prod_Micron_2450\\4&1&0&000000\n    Count    REG_DWORD    0x1\n"
