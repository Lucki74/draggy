    {
      "name": "Windows engine with a Vulkan runner is complete",
      "input": {
        "op": "state",
        "platform": "win32",
        "files": [
          "llama-server.exe",
          "vulkan/"
        ],
        "vramGB": 4,
        "nvidia": false
      },
      "expected": {
        "present": true,
        "complete": true,
        "runnerType": "vulkan"
      }
    },
    {
      "name": "Windows engine with no runner is incomplete on a GPU",
      "input": {
        "op": "state",
        "platform": "win32",
        "files": [
          "llama-server.exe"
        ],
        "vramGB": 8,
        "nvidia": true
      },
      "expected": {
        "present": true,
        "complete": false,
