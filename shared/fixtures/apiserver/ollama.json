{
  "area": "apiserver",
  "cases": [
    {
      "name": "chat request maps messages options and format",
      "input": {
        "op": "request",
        "kind": "chat",
        "body": {
          "model": "qwen3:latest",
          "messages": [
            {
              "role": "system",
              "content": "Be brief."
            },
            {
              "role": "user",
              "content": "What is this?",
              "images": [
                "/9j/AAAA"
              ]
            }
          ],
          "format": "json",
          "options": {
            "temperature": 0.2,
            "top_k": 40,
            "num_predict": 64,
            "num_ctx": 8192,
            "stop": [
              "END"
            ]
          }
        }
      },
      "expected": {
        "max_tokens": 64,
        "messages": [
          {
            "content": "Be brief.",
            "role": "system"
          },
          {
            "content": [
              {
                "text": "What is this?",
                "type": "text"
              },
              {
                "image_url": {
                  "url": "data:image/jpeg;base64,/9j/AAAA"
                },
                "type": "image_url"
              }
            ],
            "role": "user"
          }
        ],
        "model": "qwen3",
        "response_format": {
          "type": "json_object"
        },
        "stop": [
          "END"
        ],
        "stream": true,
        "stream_options": {
          "include_usage": true
        },
        "temperature": 0.2,
        "top_k": 40
      }
    },
    {
      "name": "chat request with tool calls and a schema",
      "input": {
        "op": "request",
        "kind": "chat",
        "body": {
          "model": "m",
          "stream": false,
          "format": {
            "type": "object"
          },
          "tools": [
            {
              "type": "function",
              "function": {
                "name": "f",
                "parameters": {
                  "type": "object"
                }
              }
            }
          ],
          "messages": [
            {
              "role": "user",
              "content": "go"
            },
            {
              "role": "assistant",
              "content": "",
              "tool_calls": [
                {
                  "function": {
                    "name": "f",
                    "arguments": {
                      "a": 1
                    }
                  }
                }
              ]
            },
            {
              "role": "tool",
              "tool_name": "f",
              "content": "done"
            }
          ]
        }
      },
      "expected": {
        "messages": [
          {
            "content": "go",
            "role": "user"
          },
          {
            "content": "",
            "role": "assistant",
            "tool_calls": [
              {
                "function": {
                  "arguments": "{\"a\":1}",
                  "name": "f"
                },
                "id": "call_1_0",
                "type": "function"
              }
            ]
          },
          {
            "content": "done",
            "role": "tool",
            "tool_call_id": "call_1_0"
          }
        ],
        "model": "m",
        "response_format": {
          "json_schema": {
            "name": "response",
            "schema": {
              "type": "object"
            },
            "strict": true
          },
          "type": "json_schema"
        },
        "stream": false,
        "tools": [
          {
            "function": {
              "name": "f",
              "parameters": {
                "type": "object"
              }
            },
            "type": "function"
          }
        ]
      }
    },
    {
      "name": "chat request rejects a bad role",
      "input": {
        "op": "request",
        "kind": "chat",
        "body": {
          "model": "m",
          "messages": [
            {
              "role": "robot",
              "content": "x"
            }
          ]
        }
      },
      "expected": {
        "error": "messages[].role must be system, user, assistant or tool."
      }
    },
    {
      "name": "generate request joins system and prompt",
      "input": {
        "op": "request",
        "kind": "generate",
        "body": {
          "model": "m",
          "system": "S",
          "prompt": "P",
          "images": [
            "iVBORw0"
          ]
        }
      },
      "expected": {
        "messages": [
          {
            "content": "S",
            "role": "system"
          },
          {
            "content": [
              {
                "text": "P",
                "type": "text"
              },
              {
                "image_url": {
                  "url": "data:image/png;base64,iVBORw0"
                },
                "type": "image_url"
              }
            ],
            "role": "user"
          }
        ],
        "model": "m",
        "stream": true,
        "stream_options": {
          "include_usage": true
        }
      }
    },
    {
      "name": "empty generate only loads the model",
      "input": {
        "op": "load",
        "kind": "generate",
        "model": "m",
        "created": 86400,
        "body": {
          "model": "m",
          "prompt": ""
        }
      },
      "expected": {
        "created_at": "1970-01-02T00:00:00Z",
        "done": true,
        "done_reason": "load",
        "model": "m",
        "response": ""
      }
    },
    {
      "name": "whole chat reply with a tool call",
      "input": {
        "op": "response",
        "kind": "chat",
        "model": "m",
        "created": 1700000000,
        "chat": {
          "choices": [
            {
              "message": {
                "role": "assistant",
                "content": "",
                "tool_calls": [
                  {
                    "id": "c1",
                    "type": "function",
                    "function": {
                      "name": "f",
                      "arguments": "{\"a\":1}"
                    }
                  }
                ]
              },
              "finish_reason": "tool_calls"
            }
          ],
          "usage": {
            "prompt_tokens": 7,
            "completion_tokens": 3
          }
        }
      },
      "expected": {
        "created_at": "2023-11-14T22:13:20Z",
        "done": true,
        "done_reason": "stop",
        "eval_count": 3,
        "load_duration": 0,
        "message": {
          "content": "",
          "role": "assistant",
          "tool_calls": [
            {
              "function": {
                "arguments": {
                  "a": 1
                },
                "name": "f"
              }
            }
          ]
        },
        "model": "m",
        "prompt_eval_count": 7,
        "total_duration": 0
      }
    },
    {
      "name": "whole generate reply stopped by length",
      "input": {
        "op": "response",
        "kind": "generate",
        "model": "m",
        "created": 0,
        "chat": {
          "choices": [
            {
              "message": {
                "role": "assistant",
                "content": "Hi"
              },
              "finish_reason": "length"
            }
          ],
          "usage": {
            "prompt_tokens": 2,
            "completion_tokens": 1
          }
        }
      },
      "expected": {
        "created_at": "1970-01-01T00:00:00Z",
        "done": true,
        "done_reason": "length",
        "eval_count": 1,
        "load_duration": 0,
        "model": "m",
        "prompt_eval_count": 2,
        "response": "Hi",
        "total_duration": 0
      }
    },
    {
      "name": "chat stream of text then done",
      "input": {
        "op": "stream",
        "kind": "chat",
        "model": "m",
        "created": 0,
        "chunks": [
          {
            "choices": [
              {
                "delta": {
                  "role": "assistant",
                  "content": "Hel"
                }
              }
            ]
          },
          {
            "choices": [
              {
                "delta": {
                  "content": "lo"
                },
                "finish_reason": "stop"
              }
            ]
          },
          {
            "choices": [],
            "usage": {
              "prompt_tokens": 4,
              "completion_tokens": 2
            }
          }
        ],
        "end": "finish"
      },
      "expected": [
        {
          "created_at": "1970-01-01T00:00:00Z",
          "done": false,
          "message": {
            "content": "Hel",
            "role": "assistant"
          },
          "model": "m"
        },
        {
          "created_at": "1970-01-01T00:00:00Z",
          "done": false,
          "message": {
            "content": "lo",
            "role": "assistant"
          },
          "model": "m"
        },
        {
          "created_at": "1970-01-01T00:00:00Z",
          "done": true,
          "done_reason": "stop",
          "eval_count": 2,
          "load_duration": 0,
          "message": {
            "content": "",
            "role": "assistant"
          },
          "model": "m",
          "prompt_eval_count": 4,
          "total_duration": 0
        }
      ]
    },
    {
      "name": "chat stream with tool call before done",
      "input": {
        "op": "stream",
        "kind": "chat",
        "model": "m",
        "created": 0,
        "chunks": [
          {
            "choices": [
              {
                "delta": {
                  "tool_calls": [
                    {
                      "index": 0,
                      "id": "c",
                      "function": {
                        "name": "f",
                        "arguments": "{\"a\":"
                      }
                    }
                  ]
                }
              }
            ]
          },
          {
            "choices": [
              {
                "delta": {
                  "tool_calls": [
                    {
                      "index": 0,
                      "function": {
                        "arguments": "1}"
                      }
                    }
                  ]
                },
                "finish_reason": "tool_calls"
              }
            ]
          }
        ],
        "end": "finish"
      },
      "expected": [
        {
          "created_at": "1970-01-01T00:00:00Z",
          "done": false,
          "message": {
            "content": "",
            "role": "assistant",
            "tool_calls": [
              {
                "function": {
                  "arguments": {
                    "a": 1
                  },
                  "name": "f"
                }
              }
            ]
          },
          "model": "m"
        },
        {
          "created_at": "1970-01-01T00:00:00Z",
          "done": true,
          "done_reason": "stop",
          "eval_count": 0,
          "load_duration": 0,
          "message": {
            "content": "",
            "role": "assistant"
          },
          "model": "m",
          "prompt_eval_count": 0,
          "total_duration": 0
        }
      ]
    },
    {
      "name": "generate stream failing midway",
      "input": {
        "op": "stream",
        "kind": "generate",
        "model": "m",
        "created": 0,
        "chunks": [
          {
            "choices": [
              {
                "delta": {
                  "content": "a"
                }
              }
            ]
          }
        ],
        "end": "fail:boom"
      },
      "expected": [
        {
          "created_at": "1970-01-01T00:00:00Z",
          "done": false,
          "model": "m",
          "response": "a"
        },
        {
          "error": "boom"
        }
      ]
    },
