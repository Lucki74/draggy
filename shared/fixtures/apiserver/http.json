          "connection": null
        },
        "body": {
          "object": "list",
          "data": [
            {
              "id": "qwen3:8b",
              "object": "model",
              "created": 1700000000,
              "owned_by": "local"
            },
            {
              "id": "llama3.2:3b",
              "object": "model",
              "created": 1700000000,
              "owned_by": "local"
            }
          ]
        }
      }
    },
