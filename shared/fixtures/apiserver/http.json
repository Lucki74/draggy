    {
      "name": "a streamed completion sends deltas, the stop and DONE",
      "input": {
        "config": {
          "port": 11500,
          "key": "draggy-test-key-0123456789",
          "models": [
            "qwen3:8b",
            "llama3.2:3b"
          ]
        },
        "now": 1700000000,
        "reply": {
          "announce": "qwen3:8b",
          "chunks": [
            "Hel",
            "lo"
          ],
          "model": "qwen3:8b",
          "content": "Hello"
        },
        "request": {
          "method": "POST",
          "url": "/v1/chat/completions",
          "headers": {
            "host": "127.0.0.1:11500",
            "authorization": "Bearer draggy-test-key-0123456789",
            "content-type": "application/json"
          },
          "body": "{\"model\":\"qwen3:8b\",\"stream\":true,\"messages\":[{\"role\":\"user\",\"content\":\"Hi\"}]}"
        }
      },
      "expected": {
        "status": 200,
        "headers": {
          "content-type": "text/event-stream",
          "cache-control": "no-store",
          "x-content-type-options": "nosniff",
          "connection": "keep-alive"
        },
        "body": "data: {\"id\":\"chatcmpl-<random>\",\"object\":\"chat.completion.chunk\",\"created\":1700000000,\"model\":\"qwen3:8b\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\"Hel\"},\"finish_reason\":null}]}\n\ndata: {\"id\":\"chatcmpl-<random>\",\"object\":\"chat.completion.chunk\",\"created\":1700000000,\"model\":\"qwen3:8b\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\"lo\"},\"finish_reason\":null}]}\n\ndata: {\"id\":\"chatcmpl-<random>\",\"object\":\"chat.completion.chunk\",\"created\":1700000000,\"model\":\"qwen3:8b\",\"choices\":[{\"index\":0,\"delta\":{},\"finish_reason\":\"stop\"}]}\n\ndata: [DONE]\n\n"
      }
    },
