{
  "area": "apiserver",
  "description": "HTTP routes, invoked directly on apiServer.cjs's request listener with a fixed clock. Covers the refusals in their order, model listing, completions in one piece and streamed, error events, body limits. Headers that matter are compared; the random completion id is written as a placeholder. Dot segments are resolved as WHATWG URL parsing resolves them, and a failed model list answers 500.",
  "cases": [
    {
      "name": "lists the installed models",
      "input": {
        "config": {
          "port": 11500,
          "key": "draggy-test-key-0123456789",
          "models": [
            "qwen3:8b",
            "llama3.2:3b"
          ]
        },
        "now": 1700000000,
        "reply": {},
        "request": {
          "method": "GET",
          "url": "/v1/models",
          "headers": {
            "host": "127.0.0.1:11500",
            "authorization": "Bearer draggy-test-key-0123456789"
          }
        }
      },
      "expected": {
        "status": 200,
        "headers": {
          "content-type": "application/json",
          "cache-control": "no-store",
          "x-content-type-options": "nosniff",
          "connection": null
        },
        "body": {
          "object": "list",
          "data": [
            {
              "id": "qwen3:8b",
              "object": "model",
              "created": 1700000000,
              "owned_by": "local"
            },
            {
              "id": "llama3.2:3b",
              "object": "model",
              "created": 1700000000,
              "owned_by": "local"
            }
          ]
        }
      }
    },
    {
