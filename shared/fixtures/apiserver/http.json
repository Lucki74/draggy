    {
      "name": "a completion comes back in one piece",
      "input": {
        "config": {
          "port": 11500,
          "key": "draggy-test-key-0123456789",
          "models": [
            "qwen3:8b",
            "llama3.2:3b"
          ]
        },
        "now": 1700000000,
        "reply": {
          "model": "qwen3:8b",
          "content": "Hello!",
          "usage": {
            "promptTokens": 12,
            "responseTokens": 2
          }
        },
        "request": {
          "method": "POST",
          "url": "/v1/chat/completions",
          "headers": {
            "host": "127.0.0.1:11500",
            "authorization": "Bearer draggy-test-key-0123456789",
            "content-type": "application/json"
          },
          "body": "{\"model\":\"qwen3:8b\",\"messages\":[{\"role\":\"user\",\"content\":\"Hi\"}]}"
        }
      },
      "expected": {
        "status": 200,
        "headers": {
          "content-type": "application/json",
          "cache-control": "no-store",
          "x-content-type-options": "nosniff",
          "connection": null
        },
        "body": {
          "id": "chatcmpl-<random>",
          "object": "chat.completion",
          "created": 1700000000,
          "model": "qwen3:8b",
          "choices": [
            {
              "index": 0,
              "message": {
                "role": "assistant",
                "content": "Hello!"
              },
              "finish_reason": "stop"
            }
          ],
          "usage": {
            "prompt_tokens": 12,
            "completion_tokens": 2,
            "total_tokens": 14
          }
        }
      }
    },
