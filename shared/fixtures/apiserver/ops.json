    {
      "name": "a streamed reply is handed over and read to the end",
      "input": {
        "config": {
          "port": 11500,
          "key": "draggy-test-key-0123456789",
          "models": [
            "qwen3:8b",
            "llama3.2:3b"
          ]
        },
        "now": 1700000000,
        "reply": {
          "announce": "qwen3:8b",
          "chunks": [
            "Hel",
            "lo"
          ],
          "model": "qwen3:8b",
          "content": "Hello"
        },
        "steps": [
          {
            "op": "send",
            "as": "one",
            "request": {
              "method": "POST",
