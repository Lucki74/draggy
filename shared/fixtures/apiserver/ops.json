{
  "area": "apiserver",
  "description": "Stateful sequences, run as ordered steps against one server with a fixed clock. A send with hold ignore_cancel never finishes, and one with until_cancelled finishes once its client leaves. Pins the busy 429 while replies are still held, slot release after a client leaves, the cancel signal, and the request handed to the backend. Each expected value is the list of step results.",
  "cases": [
    {
      "name": "an abandoned reply keeps its slot until generate settles",
      "input": {
        "config": {
          "port": 11500,
          "key": "draggy-test-key-0123456789",
          "models": [
            "qwen3:8b",
            "llama3.2:3b"
          ]
        },
        "now": 1700000000,
        "reply": {
          "model": "qwen3:8b",
          "content": "Hello!",
          "usage": {
            "promptTokens": 12,
            "responseTokens": 2
          }
        },
        "steps": [
          {
            "op": "send",
            "as": "first",
            "hold": "ignore_cancel",
            "request": {
              "method": "POST",
              "url": "/v1/chat/completions",
              "headers": {
                "host": "127.0.0.1:11500",
                "authorization": "Bearer draggy-test-key-0123456789",
                "content-type": "application/json"
              },
              "body": "{\"model\":\"qwen3:8b\",\"messages\":[{\"role\":\"user\",\"content\":\"Hi\"}]}"
            }
          },
          {
            "op": "send",
            "as": "second",
            "hold": "ignore_cancel",
            "request": {
              "method": "POST",
              "url": "/v1/chat/completions",
              "headers": {
                "host": "127.0.0.1:11500",
                "authorization": "Bearer draggy-test-key-0123456789",
                "content-type": "application/json"
              },
              "body": "{\"model\":\"qwen3:8b\",\"messages\":[{\"role\":\"user\",\"content\":\"Hi\"}]}"
            }
          },
          {
            "op": "abandon",
            "as": "first"
          },
          {
            "op": "abandon",
            "as": "second"
          },
          {
            "op": "send",
            "as": "third",
            "request": {
              "method": "POST",
              "url": "/v1/chat/completions",
              "headers": {
                "host": "127.0.0.1:11500",
                "authorization": "Bearer draggy-test-key-0123456789",
                "content-type": "application/json"
              },
              "body": "{\"model\":\"qwen3:8b\",\"messages\":[{\"role\":\"user\",\"content\":\"Hi\"}]}"
            }
          },
          {
            "op": "report"
          }
        ]
      },
      "expected": [
        {
          "pending": true
        },
        {
          "pending": true
        },
        {
          "cancelled": true,
          "settled": false
        },
        {
          "cancelled": true,
          "settled": false
        },
        {
          "status": 429,
          "headers": {
            "content-type": "application/json",
            "cache-control": "no-store",
            "x-content-type-options": "nosniff",
            "connection": null
          },
          "body": {
            "error": {
              "message": "Draggy is already answering other requests. Try again shortly.",
              "type": "rate_limit_error"
            }
          }
        },
        {
          "calls": [
            {
              "request": {
                "model": "qwen3:8b",
                "messages": [
                  {
                    "role": "user",
                    "content": "Hi"
                  }
                ],
                "stream": false
              },
              "cancelled": true,
              "settled": false
            },
            {
              "request": {
                "model": "qwen3:8b",
                "messages": [
                  {
                    "role": "user",
                    "content": "Hi"
                  }
                ],
                "stream": false
              },
              "cancelled": true,
              "settled": false
            }
          ]
        }
      ]
    },
