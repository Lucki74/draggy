    {
      "name": "a file named through a link inside the skill that points outside it is refused",
      "input": {
        "tree": {
          "files": {
            "project/.draggy/skills/evil/SKILL.md": "---\nname: evil\ndescription: Escape test.\n---\nBody.\n",
            "outside/secret.txt": "outside text\n"
          },
          "links": {
            "project/.draggy/skills/evil/notes.txt": "{base}/outside/secret.txt"
          }
        },
        "project": true,
        "id": "evil",
        "overrides": {},
        "enabledOnly": false,
        "file": "notes.txt"
      },
      "expected": {
        "success": false,
        "error": "\"notes.txt\" is not a file in the evil skill."
      }
    },
    {
