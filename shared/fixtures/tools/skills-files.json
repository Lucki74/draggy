{
  "area": "tools",
  "description": "skills.readSkill with the file list of a skill: how deep and how many files are listed, links left out, and a named file read through a link. A file reached through a link is read only when its real path stays inside the skill and no part of it is a denied name. Input as skills-read.json. Expected as skills-read.json.",
  "cases": [
    {
      "name": "a skill lists its files up to three folders deep and no deeper",
      "input": {
        "tree": {
          "files": {
            "userdata/skills/s1/SKILL.md": "---\nname: s1\ndescription: Depth test.\n---\nBody.\n",
            "userdata/skills/s1/top.md": "top\n",
            "userdata/skills/s1/a/b/c/deep.txt": "deep\n",
            "userdata/skills/s1/a/b/c/d/deeper.txt": "deeper\n",
            "userdata/skills/s1/.hidden.txt": "hidden\n"
          }
        },
        "project": false,
        "id": "s1",
        "overrides": {},
        "enabledOnly": false,
        "file": null
      },
      "expected": {
        "success": true,
        "skill": {
          "id": "s1",
          "name": "s1",
          "description": "Depth test.",
          "summary": "Depth test",
          "path": "{base}/userdata/skills/s1",
          "source": "user",
          "category": null,
          "surface": "both",
          "defaultOn": true,
          "modelInvocable": true,
          "enabled": true,
          "body": "Body.",
          "files": [
            "a/b/c/deep.txt",
            "top.md"
          ]
        }
      }
    },
