{
  "area": "tools",
  "description": "fsGuard.readText decisions. Input: tree (files as text, bytes as byte arrays), file (absolute path using {base}), limit (optional byte limit; absent means the default 2 MiB). Expected: {ok: true, text, bytes} or {ok: false, error}.",
  "cases": [
    {
      "name": "text comes back with its size",
      "input": {
        "tree": {
          "files": {
            "project/notes.md": "# notes\n"
          },
          "bytes": {},
          "dirs": []
        },
        "file": "{base}/project/notes.md"
      },
      "expected": {
        "ok": true,
        "text": "# notes\n",
        "bytes": 8
      }
    },
    {
      "name": "a folder is refused",
      "input": {
        "tree": {
          "files": {
            "project/src/App.tsx": "x\n"
          },
          "bytes": {},
          "dirs": []
        },
        "file": "{base}/project/src"
      },
      "expected": {
        "ok": false,
        "error": "That is a folder, not a file."
      }
    },
    {
      "name": "a NUL in the first block means it is not text",
      "input": {
        "tree": {
          "files": {},
          "bytes": {
            "project/logo.png": [
              137,
              80,
              78,
              71,
              0,
              13
            ]
          },
          "dirs": []
        },
        "file": "{base}/project/logo.png"
      },
      "expected": {
        "ok": false,
        "error": "That file is not text."
      }
    },
    {
      "name": "a NUL inside the first 8000 bytes is refused",
      "input": {
        "tree": {
          "files": {
            "project/data.bin": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\u0000b"
          },
          "bytes": {},
          "dirs": []
        },
        "file": "{base}/project/data.bin"
      },
      "expected": {
        "ok": false,
        "error": "That file is not text."
      }
    },
    {
      "name": "a NUL after the first 8000 bytes is not checked",
      "input": {
        "tree": {
          "files": {
            "project/long.txt": "\u0000"
          },
          "bytes": {},
          "dirs": []
        },
        "file": "{base}/project/long.txt"
      },
      "expected": {
        "ok": true,
        "text": "\u0000",
        "bytes": 9001
      }
    },
    {
      "name": "a file over the limit is refused with both sizes",
      "input": {
        "tree": {
          "files": {
            "project/big.txt": ""
          },
          "bytes": {},
          "dirs": []
        },
        "file": "{base}/project/big.txt",
        "limit": 1000
      },
      "expected": {
        "ok": false,
        "error": "That file is 5 KB, over the 1 KB a single read allows. Ask for part of it instead."
      }
    },
    {
      "name": "a file exactly at the limit is read",
      "input": {
        "tree": {
          "files": {
            "project/edge.txt": ""
          },
          "bytes": {},
          "dirs": []
        },
        "file": "{base}/project/edge.txt",
        "limit": 1024
      },
      "expected": {
        "ok": true,
        "text": "",
        "bytes": 1024
      }
    },
    {
      "name": "invalid UTF-8 is read with replacement characters",
      "input": {
        "tree": {
          "files": {},
          "bytes": {
            "project/odd.txt": [
              104,
              105,
              255,
              33
            ]
          },
          "dirs": []
        },
        "file": "{base}/project/odd.txt"
      },
      "expected": {
        "ok": true,
        "text": "hi�!",
        "bytes": 4
      }
    }
  ]
}
