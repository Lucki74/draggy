{
  "area": "tools",
  "description": "skills.parseSkill: front matter and body of a SKILL.md, read without a YAML parser. Input: {text}. Expected: {name, description, body, disableModelInvocation} or null when the name or description is missing.",
  "cases": [
    {
      "name": "takes the name, the description and the body",
      "input": {
        "text": "---\nname: Invoices\ndescription: How we write an invoice.\n---\n\nAlways put the date first.\n"
      },
      "expected": {
        "name": "Invoices",
        "description": "How we write an invoice.",
        "body": "Always put the date first.",
        "disableModelInvocation": false
      }
    },
    {
      "name": "copes with quotes and Windows line endings",
      "input": {
        "text": "---\r\nname: \"Invoices\"\r\ndescription: 'How we do it.'\r\n---\r\n\r\nBody.\r\n"
      },
      "expected": {
        "name": "Invoices",
        "description": "How we do it.",
        "body": "Body.",
        "disableModelInvocation": false
      }
    },
    {
      "name": "folds a description written with >",
      "input": {
        "text": "---\nname: pdf\ndescription: >\n  Fills in PDF forms\n  and merges files.\nlicense: MIT\n---\n\nBody."
      },
      "expected": {
        "name": "pdf",
        "description": "Fills in PDF forms and merges files.",
        "body": "Body.",
        "disableModelInvocation": false
      }
    },
    {
      "name": "keeps the line breaks of a description written with |",
      "input": {
        "text": "---\nname: notes\ndescription: |\n  First line.\n  Second line.\n---\nBody"
      },
      "expected": {
        "name": "notes",
        "description": "First line.\nSecond line.",
        "body": "Body",
        "disableModelInvocation": false
      }
    },
    {
      "name": "refuses one with no description",
      "input": {
        "text": "---\nname: Invoices\n---\n\nBody."
      },
      "expected": null
    },
    {
      "name": "refuses a file with no front matter",
      "input": {
        "text": "# Just a document"
      },
      "expected": null
    },
    {
      "name": "refuses an empty text",
      "input": {
        "text": ""
      },
      "expected": null
    },
    {
      "name": "skips nested keys it has no use for",
      "input": {
        "text": "---\nname: notes\nmetadata:\n  version: 2\n  author: someone\ndescription: Takes notes.\n---\n\nBody."
      },
      "expected": {
        "name": "notes",
        "description": "Takes notes.",
        "body": "Body.",
        "disableModelInvocation": false
      }
    },
    {
      "name": "marks a skill only a slash command may start",
      "input": {
        "text": "---\nname: deploy\ndescription: Deploys.\ndisable-model-invocation: true\n---\n\nBody."
      },
      "expected": {
        "name": "deploy",
        "description": "Deploys.",
        "body": "Body.",
        "disableModelInvocation": true
      }
    },
    {
      "name": "cuts a description at the format limit",
      "input": {
        "text": "---\nname: long\ndescription: \n---\n"
      },
      "expected": {
        "name": "long",
        "description": "",
        "body": "",
        "disableModelInvocation": false
      }
    },
    {
      "name": "ignores a byte order mark",
      "input": {
        "text": "﻿---\nname: a\ndescription: b\n---\nBody"
      },
      "expected": {
        "name": "a",
        "description": "b",
        "body": "Body",
        "disableModelInvocation": false
      }
    },
    {
      "name": "a closing dash line at the very end leaves an empty body",
      "input": {
        "text": "---\nname: a\ndescription: b\n---"
      },
      "expected": {
        "name": "a",
        "description": "b",
        "body": "",
        "disableModelInvocation": false
      }
    },
    {
      "name": "keys are read in lowercase whatever their case",
      "input": {
        "text": "---\nName: Invoices\nDESCRIPTION: How.\n---\n"
      },
      "expected": {
        "name": "Invoices",
        "description": "How.",
        "body": "",
        "disableModelInvocation": false
      }
    },
    {
      "name": "an indented line is a value, not a key",
      "input": {
        "text": "---\nname: a\n  description: not me\ndescription: me\n---\n"
      },
      "expected": {
        "name": "a",
        "description": "me",
        "body": "",
        "disableModelInvocation": false
      }
    },
    {
      "name": "a quoted empty name is refused",
      "input": {
        "text": "---\nname: \"\"\ndescription: x\n---\n"
      },
      "expected": null
    },
    {
      "name": "dashes that run on do not close the block",
      "input": {
        "text": "---\nname: a\ndescription: b\n----\nbody"
      },
      "expected": {
        "name": "a",
        "description": "b",
        "body": "-\nbody",
        "disableModelInvocation": false
      }
    },
    {
      "name": "a description is cut at 1024 UTF-16 units",
      "input": {
        "text": "---\nname: Long\ndescription: a😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀bc😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀\n---\nbody\n"
      },
      "expected": {
        "name": "Long",
        "description": "a😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀b",
        "body": "body",
        "disableModelInvocation": false
      }
    },
    {
      "name": "a value trims a byte order mark but not a next-line character",
      "input": {
        "text": "---\nname: ﻿sized﻿\ndescription: kept\n---\n"
      },
      "expected": {
        "name": "sized",
        "description": "kept",
        "body": "",
        "disableModelInvocation": false
      }
    },
    {
      "name": "a folded block joins a byte order mark as a space",
      "input": {
        "text": "---\nname: Fold\ndescription: >\n  one﻿two\n---\n"
      },
      "expected": {
        "name": "Fold",
        "description": "one two",
        "body": "",
        "disableModelInvocation": false
      }
    }
  ]
