    {
      "name": "a relative path inside the folder is allowed",
      "input": {
        "tree": {
          "files": {
            "project/notes.md": "# notes\n",
            "project/src/App.tsx": "export default 1;\n",
            "project/.gitignore": "node_modules\n",
            "project/.env": "API_KEY=fake\n",
            "project/.ssh/config": "Host *\n",
            "project/appdata/draggy.db": "not sqlite\n",
            "project/appdata-old/x.txt": "old\n",
            "project/..notes": "two dots\n",
            "project-backup/notes.md": "other\n",
            "elsewhere/secrets.txt": "do not read me\n",
            "second/readme.md": "hi\n"
          },
          "dirs": [
            "project/empty"
          ],
          "links": {
            "project/escape.txt": "{base}/elsewhere/secrets.txt",
            "project/out": "{base}/elsewhere",
            "project/alias.md": "{base}/project/notes.md",
            "project/inner": "{base}/project/src"
          }
        },
        "roots": [
          "{base}/project"
        ],
        "requested": "notes.md"
      },
      "expected": {
        "ok": true,
        "path": "{base}/project/notes.md"
      }
