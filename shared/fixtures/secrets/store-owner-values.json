{
  "area": "secrets",
  "description": "Ordered ops over a store whose owner holds a value that is not an object, and over names a __proto__ set leaves readable. The reference returns the stored value as it is, so a text owner reads as text, and withSecrets or adopt spread it by character or index. A name the prototype holds reads as its value; a store reopened afterwards reads empty.",
  "cases": [
    {
      "name": "reads a stored owner text as the text, and withSecrets spreads its characters",
      "input": {
        "container": "eyJnaXRodWIiOiJhYmNkZWYifQ==",
        "ops": [
          {
            "call": "get",
            "args": [
              "github"
            ]
          },
          {
            "call": "withSecrets",
            "args": [
              "github",
              {
                "PORT": "8080"
              }
            ]
          }
        ]
      },
      "expected": [
        "abcdef",
        {
          "0": "a",
          "1": "b",
          "2": "c",
          "3": "d",
          "4": "e",
          "5": "f",
          "PORT": "8080"
        }
      ]
    },
    {
      "name": "reads a stored owner array as the array, and withSecrets spreads its items",
      "input": {
        "container": "eyJnaXRodWIiOlsieCIsInkiXX0=",
        "ops": [
          {
            "call": "get",
            "args": [
              "github"
            ]
          },
          {
            "call": "withSecrets",
            "args": [
              "github",
              {
                "PORT": "8080"
              }
            ]
          }
        ]
      },
      "expected": [
        [
          "x",
          "y"
        ],
        {
          "0": "x",
          "1": "y",
          "PORT": "8080"
        }
      ]
    },
    {
      "name": "reads a stored owner number or boolean as itself and adds nothing in withSecrets",
      "input": {
        "container": "eyJhIjo1LCJiIjp0cnVlfQ==",
        "ops": [
          {
            "call": "get",
            "args": [
              "a"
            ]
          },
          {
            "call": "get",
            "args": [
              "b"
            ]
          },
          {
            "call": "withSecrets",
            "args": [
              "a",
              {
                "PORT": "8080"
              }
            ]
          }
        ]
      },
      "expected": [
        5,
        true,
        {
          "PORT": "8080"
        }
      ]
    },
    {
      "name": "reads a stored owner null as empty",
      "input": {
        "container": "eyJnaXRodWIiOm51bGx9",
        "ops": [
          {
            "call": "get",
            "args": [
              "github"
            ]
          },
          {
            "call": "withSecrets",
            "args": [
              "github",
              {
                "PORT": "8080"
              }
            ]
          },
          {
            "call": "owners",
            "args": []
          }
        ]
      },
      "expected": [
        {},
        {
          "PORT": "8080"
        },
        [
          "github"
        ]
      ]
    },
    {
      "name": "adopt merges moved credentials into a stored owner text by its characters",
      "input": {
        "container": "eyJnaXRodWIiOiJhYmNkZWYifQ==",
        "ops": [
          {
            "call": "adopt",
            "args": [
              {
                "github": {
                  "enabled": true,
                  "env": {
                    "GITHUB_TOKEN": "fixture-secret-0001"
                  }
                }
              },
              "TOKEN"
            ]
          },
          {
            "call": "get",
            "args": [
              "github"
            ]
          },
          {
            "call": "container",
            "args": []
          }
        ]
      },
      "expected": [
        {
          "moved": 1,
          "records": {
            "github": {
              "enabled": true,
              "env": {}
            }
          }
        },
        {
          "0": "a",
          "1": "b",
          "2": "c",
          "3": "d",
          "4": "e",
          "5": "f",
          "GITHUB_TOKEN": "fixture-secret-0001"
        },
        "eyJnaXRodWIiOnsiMCI6ImEiLCIxIjoiYiIsIjIiOiJjIiwiMyI6ImQiLCI0IjoiZSIsIjUiOiJmIiwiR0lUSFVCX1RPS0VOIjoiZml4dHVyZS1zZWNyZXQtMDAwMSJ9fQ=="
      ]
    },
    {
      "name": "adopt over a stored owner number starts the owner from the moved credentials",
      "input": {
        "container": "eyJnaXRodWIiOjV9",
        "ops": [
          {
            "call": "adopt",
            "args": [
              {
                "github": {
                  "env": {
                    "GITHUB_TOKEN": "fixture-secret-0001"
                  }
                }
              },
              "TOKEN"
            ]
          },
          {
            "call": "get",
            "args": [
              "github"
            ]
          }
        ]
      },
      "expected": [
        {
          "moved": 1,
          "records": {
            "github": {
              "env": {}
            }
          }
        },
        {
          "GITHUB_TOKEN": "fixture-secret-0001"
        }
      ]
    },
    {
      "name": "a name a __proto__ set left reads as its value until the store is reopened",
      "input": {
        "ops": [
          {
            "call": "set",
            "args": [
              "__proto__",
              {
                "GITHUB_TOKEN": "fixture-secret-0001"
              }
            ]
          },
          {
            "call": "get",
            "args": [
              "GITHUB_TOKEN"
            ]
          },
          {
            "call": "withSecrets",
            "args": [
              "GITHUB_TOKEN",
              {}
            ]
          },
          {
            "call": "reopen",
            "args": []
          },
          {
            "call": "get",
            "args": [
              "GITHUB_TOKEN"
            ]
          }
        ]
      },
      "expected": [
        true,
        "fixture-secret-0001",
        {
          "0": "f",
          "1": "i",
          "2": "x",
          "3": "t",
          "4": "u",
          "5": "r",
          "6": "e",
          "7": "-",
          "8": "s",
          "9": "e",
          "10": "c",
          "11": "r",
          "12": "e",
          "13": "t",
          "14": "-",
          "15": "0",
          "16": "0",
          "17": "0",
          "18": "1"
        },
        null,
        {}
      ]
    },
    {
      "name": "a __proto__ set's names still read after another owner is saved, and the file keeps only owners",
      "input": {
        "ops": [
          {
            "call": "set",
            "args": [
              "__proto__",
              {
                "GITHUB_TOKEN": "fixture-secret-0001"
              }
            ]
          },
          {
            "call": "set",
            "args": [
              "github",
              {
                "GITHUB_TOKEN": "fixture-secret-0002"
              }
            ]
          },
          {
            "call": "get",
            "args": [
              "GITHUB_TOKEN"
            ]
          },
          {
            "call": "owners",
            "args": []
          },
          {
            "call": "container",
            "args": []
          }
        ]
      },
      "expected": [
        true,
        true,
        "fixture-secret-0001",
        [
          "github"
        ],
        "eyJnaXRodWIiOnsiR0lUSFVCX1RPS0VOIjoiZml4dHVyZS1zZWNyZXQtMDAwMiJ9fQ=="
      ]
    },
    {
      "name": "a name a __proto__ set did not store reads empty",
      "input": {
        "ops": [
          {
            "call": "set",
            "args": [
              "__proto__",
              {
                "GITHUB_TOKEN": "fixture-secret-0001"
              }
            ]
          },
          {
            "call": "get",
            "args": [
              "missing"
            ]
          },
          {
            "call": "get",
            "args": [
              "__proto__"
            ]
          }
        ]
      },
      "expected": [
        true,
        {},
        {
          "GITHUB_TOKEN": "fixture-secret-0001"
        }
      ]
    },
    {
      "name": "reads a store whose decrypted text is not UTF-8 with replacement characters",
      "input": {
        "container": "eyJnaXRodWIiOnsiSyI6ImFi/yJ9fQ==",
        "ops": [
          {
            "call": "get",
            "args": [
              "github"
            ]
          },
          {
            "call": "owners",
            "args": []
          }
        ]
      },
      "expected": [
        {
          "K": "ab�"
        },
        [
          "github"
        ]
      ]
    }
  ]
}
