{
  "area": "secrets",
  "description": "Ordered ops over one store file with a working fake keystore (base64, as electron/secrets.test.js). Each expected entry is the result of the op at the same index: set and remove return whether the file was written, get and withSecrets return the object, owners the list, container the file text or null, fileContains a boolean, and writeContainer and close null. The TS runner drives electron/secrets.cjs; the Rust runner drives draggy-storage.",
  "cases": [
    {
      "name": "reads back what it was given",
      "input": {
        "ops": [
          {
            "call": "set",
            "args": [
              "github",
              {
                "GITHUB_TOKEN": "fixture-secret-0001"
              }
            ]
          },
          {
            "call": "get",
            "args": [
              "github"
            ]
          }
        ]
      },
      "expected": [
        true,
        {
          "GITHUB_TOKEN": "fixture-secret-0001"
        }
      ]
    },
    {
      "name": "does not leave the value readable on disk",
      "input": {
        "ops": [
          {
            "call": "set",
            "args": [
              "github",
              {
                "GITHUB_TOKEN": "fixture-secret-0001"
              }
            ]
          },
          {
            "call": "fileContains",
            "args": [
              "fixture-secret-0001"
            ]
          },
          {
            "call": "container",
            "args": []
          }
        ]
      },
      "expected": [
        true,
        false,
        "eyJnaXRodWIiOnsiR0lUSFVCX1RPS0VOIjoiZml4dHVyZS1zZWNyZXQtMDAwMSJ9fQ=="
      ]
    },
    {
      "name": "survives the app being restarted",
      "input": {
        "ops": [
          {
            "call": "set",
            "args": [
              "github",
              {
                "GITHUB_TOKEN": "fixture-secret-0001"
              }
            ]
          },
          {
            "call": "reopen",
            "args": []
          },
          {
            "call": "get",
            "args": [
              "github"
            ]
          }
        ]
      },
      "expected": [
        true,
        null,
        {
          "GITHUB_TOKEN": "fixture-secret-0001"
        }
      ]
    },
    {
      "name": "drops a field that was emptied, and the owner with it",
      "input": {
        "ops": [
          {
            "call": "set",
            "args": [
              "github",
              {
                "GITHUB_TOKEN": "fixture-secret-0001"
              }
            ]
          },
          {
            "call": "set",
            "args": [
              "github",
              {
                "GITHUB_TOKEN": ""
              }
            ]
          },
          {
            "call": "get",
            "args": [
              "github"
            ]
          },
          {
            "call": "owners",
            "args": []
          }
        ]
      },
      "expected": [
        true,
        true,
        {},
        []
      ]
    },
    {
      "name": "keeps numbers and booleans as text and drops null and empty values",
      "input": {
        "ops": [
          {
            "call": "set",
            "args": [
              "svc",
              {
                "PORT": 8080,
                "DEBUG": true,
                "EMPTY": "",
                "NONE": null,
                "TOKEN": "fixture-secret-0002"
              }
            ]
          },
          {
            "call": "get",
            "args": [
              "svc"
            ]
          }
        ]
      },
      "expected": [
        true,
        {
          "PORT": "8080",
          "DEBUG": "true",
          "TOKEN": "fixture-secret-0002"
        }
      ]
    },
    {
      "name": "keeps an empty array as an empty string and joins the others",
      "input": {
        "ops": [
          {
            "call": "set",
            "args": [
              "svc",
              {
                "LIST": [],
                "NAMES": [
                  "a",
                  null,
                  "b"
                ]
              }
            ]
          },
          {
            "call": "get",
            "args": [
              "svc"
            ]
          }
        ]
      },
      "expected": [
        true,
        {
          "LIST": "",
          "NAMES": "a,,b"
        }
      ]
    },
    {
      "name": "forgets a server that was removed",
      "input": {
        "ops": [
          {
            "call": "set",
            "args": [
              "github",
              {
                "GITHUB_TOKEN": "fixture-secret-0001"
              }
            ]
          },
          {
            "call": "remove",
            "args": [
              "github"
            ]
          },
          {
            "call": "get",
            "args": [
              "github"
            ]
          },
          {
            "call": "owners",
            "args": []
          }
        ]
      },
      "expected": [
        true,
        true,
        {},
        []
      ]
    },
    {
      "name": "removing a server that was never stored still writes the store",
      "input": {
        "ops": [
          {
            "call": "remove",
            "args": [
              "ghost"
            ]
          },
          {
            "call": "container",
            "args": []
          }
        ]
      },
      "expected": [
        true,
        "e30="
      ]
    },
    {
      "name": "hands a server its own secrets and nobody else's",
      "input": {
        "ops": [
          {
            "call": "set",
            "args": [
              "github",
              {
                "GITHUB_TOKEN": "fixture-secret-0001"
              }
            ]
          },
          {
            "call": "set",
            "args": [
              "gitlab",
              {
                "GITLAB_TOKEN": "fixture-secret-0003"
              }
            ]
          },
          {
            "call": "withSecrets",
            "args": [
              "github",
              {
                "PATH": "/usr/bin"
              }
            ]
          }
        ]
      },
      "expected": [
        true,
        true,
        {
          "PATH": "/usr/bin",
          "GITHUB_TOKEN": "fixture-secret-0001"
        }
      ]
    },
    {
      "name": "stored secrets override the env they are merged into",
      "input": {
        "ops": [
          {
            "call": "set",
            "args": [
              "github",
              {
                "GITHUB_TOKEN": "fixture-secret-0001"
              }
            ]
          },
          {
            "call": "withSecrets",
            "args": [
              "github",
              {
                "GITHUB_TOKEN": "from-env",
                "GITHUB_HOST": "github.com"
              }
            ]
          }
        ]
      },
      "expected": [
        true,
        {
          "GITHUB_TOKEN": "fixture-secret-0001",
          "GITHUB_HOST": "github.com"
        }
      ]
    },
    {
      "name": "lists owners in the order they were first stored",
      "input": {
        "ops": [
          {
            "call": "set",
            "args": [
              "github",
              {
                "GITHUB_TOKEN": "fixture-secret-0001"
              }
            ]
          },
          {
            "call": "set",
            "args": [
              "gitlab",
              {
                "GITLAB_TOKEN": "fixture-secret-0004"
              }
            ]
          },
          {
            "call": "set",
            "args": [
              "filesystem",
              {
                "ROOT": "/tmp/fixture"
              }
            ]
          },
          {
            "call": "owners",
            "args": []
          }
        ]
      },
      "expected": [
        true,
        true,
        true,
        [
          "github",
          "gitlab",
          "filesystem"
        ]
      ]
    },
    {
      "name": "lists integer-like owners first and writes them that way, as JavaScript orders object keys",
      "input": {
        "ops": [
          {
            "call": "set",
            "args": [
              "beta",
              {
                "K": "fixture-secret-0005"
              }
            ]
          },
          {
            "call": "set",
            "args": [
              "10",
              {
                "K": "fixture-secret-0006"
              }
            ]
          },
          {
            "call": "set",
            "args": [
              "2",
              {
                "K": "fixture-secret-0007"
              }
            ]
          },
          {
            "call": "owners",
            "args": []
          },
          {
            "call": "container",
            "args": []
          }
        ]
      },
      "expected": [
        true,
        true,
        true,
        [
          "2",
          "10",
          "beta"
        ],
        "eyIyIjp7IksiOiJmaXh0dXJlLXNlY3JldC0wMDA3In0sIjEwIjp7IksiOiJmaXh0dXJlLXNlY3JldC0wMDA2In0sImJldGEiOnsiSyI6ImZpeHR1cmUtc2VjcmV0LTAwMDUifX0="
      ]
    },
    {
      "name": "keeps other owners' values when one owner changes",
      "input": {
        "ops": [
          {
            "call": "set",
            "args": [
              "github",
              {
                "GITHUB_TOKEN": "fixture-secret-0001"
              }
            ]
          },
          {
            "call": "set",
            "args": [
              "gitlab",
              {
                "GITLAB_TOKEN": "fixture-secret-0008"
              }
            ]
          },
          {
            "call": "set",
            "args": [
              "github",
              {
                "GITHUB_TOKEN": "fixture-secret-0009"
              }
            ]
          },
          {
            "call": "get",
            "args": [
              "gitlab"
            ]
          }
        ]
      },
      "expected": [
        true,
        true,
        true,
        {
          "GITLAB_TOKEN": "fixture-secret-0008"
        }
      ]
    },
    {
      "name": "keeps the store read in memory until it is closed, then reads the file again",
      "input": {
        "container": "eyJnaXRodWIiOnsiR0lUSFVCX1RPS0VOIjoiZml4dHVyZS1zZWNyZXQtMDAwMSJ9fQ==",
        "ops": [
          {
            "call": "owners",
            "args": []
          },
          {
            "call": "writeContainer",
            "args": [
              "eyJnaXRsYWIiOnsiSyI6ImZpeHR1cmUtc2VjcmV0LTAwMTAifX0="
            ]
          },
          {
            "call": "owners",
            "args": []
          },
          {
            "call": "close",
            "args": []
          },
          {
            "call": "owners",
            "args": []
          },
          {
            "call": "get",
            "args": [
              "gitlab"
            ]
          }
        ]
      },
      "expected": [
        [
          "github"
        ],
        null,
        [
          "github"
        ],
        null,
        [
          "gitlab"
        ],
        {
          "K": "fixture-secret-0010"
        }
      ]
    },
    {
      "name": "a store it cannot read starts empty, and the next save replaces it",
      "input": {
        "container": "not encrypted by us",
        "ops": [
          {
            "call": "get",
            "args": [
              "github"
            ]
          },
          {
            "call": "owners",
            "args": []
          },
          {
            "call": "set",
            "args": [
              "github",
              {
                "GITHUB_TOKEN": "fixture-secret-0011"
              }
            ]
          },
          {
            "call": "get",
            "args": [
              "github"
            ]
          }
        ]
      },
      "expected": [
        {},
        [],
        true,
        {
          "GITHUB_TOKEN": "fixture-secret-0011"
        }
      ]
    },
    {
      "name": "a store that decrypts to a number starts empty",
      "input": {
        "container": "NDI=",
        "ops": [
          {
            "call": "owners",
            "args": []
          },
          {
            "call": "get",
            "args": [
              "github"
            ]
          }
        ]
      },
      "expected": [
        [],
        {}
      ]
    },
    {
      "name": "a store that decrypts to invalid JSON starts empty",
      "input": {
        "container": "eyJnaXRodWIiOiA=",
        "ops": [
          {
            "call": "owners",
            "args": []
          }
        ]
      },
      "expected": [
        []
      ]
    }
  ]
}
