{
  "area": "secrets",
  "description": "Migration of credentials out of old records. The adopt op takes the records and a marker, and isSecret(field) is field.toUpperCase().includes(marker) in both runners. Expected is { moved, records } from adopt, then the results of the remaining ops. Two cases record TS quirks: Object.prototype names count as `in` the secrets object, and a __proto__ assignment is ignored.",
  "cases": [
    {
      "name": "moves the secret fields into the store",
      "input": {
        "ops": [
          {
            "call": "adopt",
            "args": [
              {
                "github": {
                  "enabled": true,
                  "env": {
                    "GITHUB_PERSONAL_ACCESS_TOKEN": "fixture-old-token",
                    "GITHUB_HOST": "github.com"
                  },
                  "arguments": {
                    "roots": [
                      "C:\\projects"
                    ]
                  }
                },
                "filesystem": {
                  "enabled": true,
                  "env": {},
                  "arguments": {
                    "roots": [
                      "C:\\projects"
                    ]
                  }
                }
              },
              "TOKEN"
            ]
          },
          {
            "call": "get",
            "args": [
              "github"
            ]
          }
        ]
      },
      "expected": [
        {
          "moved": 1,
          "records": {
            "github": {
              "enabled": true,
              "env": {
                "GITHUB_HOST": "github.com"
              },
              "arguments": {
                "roots": [
                  "C:\\projects"
                ]
              }
            },
            "filesystem": {
              "enabled": true,
              "env": {},
              "arguments": {
                "roots": [
                  "C:\\projects"
                ]
              }
            }
          }
        },
        {
          "GITHUB_PERSONAL_ACCESS_TOKEN": "fixture-old-token"
        }
      ]
    },
    {
      "name": "leaves every non-credential field exactly as it was",
      "input": {
        "ops": [
          {
            "call": "adopt",
            "args": [
              {
                "github": {
                  "enabled": true,
                  "env": {
                    "GITHUB_PERSONAL_ACCESS_TOKEN": "fixture-old-token",
                    "GITHUB_HOST": "github.com"
                  },
                  "arguments": {
                    "roots": [
                      "C:\\projects"
                    ]
                  }
                },
                "filesystem": {
                  "enabled": true,
                  "env": {},
                  "arguments": {
                    "roots": [
                      "C:\\projects"
                    ]
                  }
                }
              },
              "TOKEN"
            ]
          },
          {
            "call": "owners",
            "args": []
          }
        ]
      },
      "expected": [
        {
          "moved": 1,
          "records": {
            "github": {
              "enabled": true,
              "env": {
                "GITHUB_HOST": "github.com"
              },
              "arguments": {
                "roots": [
                  "C:\\projects"
                ]
              }
            },
            "filesystem": {
              "enabled": true,
              "env": {},
              "arguments": {
                "roots": [
                  "C:\\projects"
                ]
              }
            }
          }
        },
        [
          "github"
        ]
      ]
    },
    {
      "name": "changes nothing when there is nothing to move",
      "input": {
        "ops": [
          {
            "call": "adopt",
            "args": [
              {
                "filesystem": {
                  "enabled": true,
                  "env": {},
                  "arguments": {
                    "roots": [
                      "C:\\projects"
                    ]
                  }
                }
              },
              "TOKEN"
            ]
          },
          {
            "call": "owners",
            "args": []
          }
        ]
      },
      "expected": [
        {
          "moved": 0,
          "records": {
            "filesystem": {
              "enabled": true,
              "env": {},
              "arguments": {
                "roots": [
                  "C:\\projects"
                ]
              }
            }
          }
        },
        []
      ]
    },
    {
      "name": "leaves the records alone when the keystore is unavailable",
      "input": {
        "vault": {
          "encryptionAvailable": false
        },
        "ops": [
          {
            "call": "adopt",
            "args": [
              {
                "github": {
                  "enabled": true,
                  "env": {
                    "GITHUB_PERSONAL_ACCESS_TOKEN": "fixture-old-token",
                    "GITHUB_HOST": "github.com"
                  },
                  "arguments": {
                    "roots": [
                      "C:\\projects"
                    ]
                  }
                },
                "filesystem": {
                  "enabled": true,
                  "env": {},
                  "arguments": {
                    "roots": [
                      "C:\\projects"
                    ]
                  }
                }
              },
              "TOKEN"
            ]
          },
          {
            "call": "get",
            "args": [
              "github"
            ]
          }
        ]
      },
      "expected": [
        {
          "moved": 0,
          "records": {
            "github": {
              "enabled": true,
              "env": {
                "GITHUB_PERSONAL_ACCESS_TOKEN": "fixture-old-token",
                "GITHUB_HOST": "github.com"
              },
              "arguments": {
                "roots": [
                  "C:\\projects"
                ]
              }
            },
            "filesystem": {
              "enabled": true,
              "env": {},
              "arguments": {
                "roots": [
                  "C:\\projects"
                ]
              }
            }
          }
        },
        {}
      ]
    },
    {
      "name": "merges moved credentials with those already stored",
      "input": {
        "ops": [
          {
            "call": "set",
            "args": [
              "github",
              {
                "OTHER_TOKEN": "fixture-secret-0013"
              }
            ]
          },
          {
            "call": "adopt",
            "args": [
              {
                "github": {
                  "enabled": true,
                  "env": {
                    "GITHUB_PERSONAL_ACCESS_TOKEN": "fixture-old-token",
                    "GITHUB_HOST": "github.com"
                  },
                  "arguments": {
                    "roots": [
                      "C:\\projects"
                    ]
                  }
                },
                "filesystem": {
                  "enabled": true,
                  "env": {},
                  "arguments": {
                    "roots": [
                      "C:\\projects"
                    ]
                  }
                }
              },
              "TOKEN"
            ]
          },
          {
            "call": "get",
            "args": [
              "github"
            ]
          }
        ]
      },
      "expected": [
        true,
        {
          "moved": 1,
          "records": {
            "github": {
              "enabled": true,
              "env": {
                "GITHUB_HOST": "github.com"
              },
              "arguments": {
                "roots": [
                  "C:\\projects"
                ]
              }
            },
            "filesystem": {
              "enabled": true,
              "env": {},
              "arguments": {
                "roots": [
                  "C:\\projects"
                ]
              }
            }
          }
        },
        {
          "OTHER_TOKEN": "fixture-secret-0013",
          "GITHUB_PERSONAL_ACCESS_TOKEN": "fixture-old-token"
        }
      ]
    },
    {
      "name": "counts credentials moved across servers",
      "input": {
        "ops": [
          {
            "call": "adopt",
            "args": [
              {
                "github": {
                  "enabled": true,
                  "env": {
                    "GITHUB_PERSONAL_ACCESS_TOKEN": "fixture-old-token",
                    "GITHUB_HOST": "github.com"
                  },
                  "arguments": {
                    "roots": [
                      "C:\\projects"
                    ]
                  }
                },
                "gitlab": {
                  "enabled": true,
                  "env": {
                    "GITLAB_TOKEN": "fixture-secret-0014",
                    "GITLAB_URL": "https://gitlab.example.com"
                  }
                }
              },
              "TOKEN"
            ]
          },
          {
            "call": "owners",
            "args": []
          }
        ]
      },
      "expected": [
        {
          "moved": 2,
          "records": {
            "github": {
              "enabled": true,
              "env": {
                "GITHUB_HOST": "github.com"
              },
              "arguments": {
                "roots": [
                  "C:\\projects"
                ]
              }
            },
            "gitlab": {
              "enabled": true,
              "env": {
                "GITLAB_URL": "https://gitlab.example.com"
              }
            }
          }
        },
        [
          "github",
          "gitlab"
        ]
      ]
    },
    {
      "name": "keeps an empty credential field where it is",
      "input": {
        "ops": [
          {
            "call": "adopt",
            "args": [
              {
                "github": {
                  "enabled": true,
                  "env": {
                    "GITHUB_TOKEN": "",
                    "GITHUB_HOST": "github.com"
                  }
                }
              },
              "TOKEN"
            ]
          },
          {
            "call": "owners",
            "args": []
          }
        ]
      },
      "expected": [
        {
          "moved": 0,
          "records": {
            "github": {
              "enabled": true,
              "env": {
                "GITHUB_TOKEN": "",
                "GITHUB_HOST": "github.com"
              }
            }
          }
        },
        []
      ]
    },
    {
      "name": "stores a numeric credential as text",
      "input": {
        "ops": [
          {
            "call": "adopt",
            "args": [
              {
                "svc": {
                  "env": {
                    "API_TOKEN": 12345
                  }
                }
              },
              "TOKEN"
            ]
          },
          {
            "call": "get",
            "args": [
              "svc"
            ]
          }
        ]
      },
      "expected": [
        {
          "moved": 1,
          "records": {
            "svc": {
              "env": {}
            }
          }
        },
        {
          "API_TOKEN": "12345"
        }
      ]
    },
    {
      "name": "drops an env field named like an Object.prototype key when a credential moves",
      "input": {
        "ops": [
          {
            "call": "adopt",
            "args": [
              {
                "svc": {
                  "env": {
                    "constructor": "fixture-config",
                    "API_TOKEN": "fixture-secret-0015"
                  }
                }
              },
              "TOKEN"
            ]
          },
          {
            "call": "get",
            "args": [
              "svc"
            ]
          }
        ]
      },
      "expected": [
        {
          "moved": 1,
          "records": {
            "svc": {
              "env": {}
            }
          }
        },
        {
          "API_TOKEN": "fixture-secret-0015"
        }
      ]
    },
    {
      "name": "counts a __proto__ credential as moved but stores nothing",
      "input": {
        "ops": [
          {
            "call": "adopt",
            "args": [
              {
                "svc": {
                  "env": {
                    "__proto__": "fixture-secret-0016"
                  }
                }
              },
              ""
            ]
          },
          {
            "call": "owners",
            "args": []
          }
        ]
      },
      "expected": [
        {
          "moved": 1,
          "records": {
            "svc": {
              "env": {
                "__proto__": "fixture-secret-0016"
              }
            }
          }
        },
        []
      ]
    }
  ]
}
