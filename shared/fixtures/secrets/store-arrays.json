{
  "area": "secrets",
  "description": "Ordered ops over a store that was written as an array. The reference keeps the array's length as it grows: a set past the end leaves null for the skipped indices, and removing that index later does not shorten the array. A named owner lives on the array object only until the store is reopened, and length reads as the array's length.",
  "cases": [
    {
      "name": "a set past the end of an array store leaves nulls for the skipped indices",
      "input": {
        "container": "W3siR0lUSFVCX1RPS0VOIjoiZml4dHVyZS1zZWNyZXQtMDAwMSJ9XQ==",
        "ops": [
          {
            "call": "set",
            "args": [
              "2",
              {
                "GITHUB_TOKEN": "fixture-secret-0002"
              }
            ]
          },
          {
            "call": "container",
            "args": []
          },
          {
            "call": "owners",
            "args": []
          },
          {
            "call": "get",
            "args": [
              "1"
            ]
          }
        ]
      },
      "expected": [
        true,
        "W3siR0lUSFVCX1RPS0VOIjoiZml4dHVyZS1zZWNyZXQtMDAwMSJ9LG51bGwseyJHSVRIVUJfVE9LRU4iOiJmaXh0dXJlLXNlY3JldC0wMDAyIn1d",
        [
          "0",
          "2"
        ],
        {}
      ]
    },
    {
      "name": "removing an index a set grew the array to leaves the array as long as it was",
      "input": {
        "container": "W3siR0lUSFVCX1RPS0VOIjoiZml4dHVyZS1zZWNyZXQtMDAwMSJ9XQ==",
        "ops": [
          {
            "call": "set",
            "args": [
              "2",
              {
                "GITHUB_TOKEN": "fixture-secret-0002"
              }
            ]
          },
          {
            "call": "remove",
            "args": [
              "2"
            ]
          },
          {
            "call": "container",
            "args": []
          },
          {
            "call": "owners",
            "args": []
          }
        ]
      },
      "expected": [
        true,
        true,
        "W3siR0lUSFVCX1RPS0VOIjoiZml4dHVyZS1zZWNyZXQtMDAwMSJ9LG51bGwsbnVsbF0=",
        [
          "0"
        ]
      ]
    },
    {
      "name": "a named owner on an array store is listed until the store is reopened, and not written",
      "input": {
        "container": "W3siR0lUSFVCX1RPS0VOIjoiZml4dHVyZS1zZWNyZXQtMDAwMSJ9XQ==",
        "ops": [
          {
            "call": "set",
            "args": [
              "abc",
              {
                "GITHUB_TOKEN": "fixture-secret-0002"
              }
            ]
          },
          {
            "call": "owners",
            "args": []
          },
          {
            "call": "container",
            "args": []
          },
          {
            "call": "reopen",
            "args": []
          },
          {
            "call": "owners",
            "args": []
          }
        ]
      },
      "expected": [
        true,
        [
          "0",
          "abc"
        ],
        "W3siR0lUSFVCX1RPS0VOIjoiZml4dHVyZS1zZWNyZXQtMDAwMSJ9XQ==",
        null,
        [
          "0"
        ]
      ]
    },
    {
      "name": "the holes of a stored array are listed as owners and read as empty",
      "input": {
        "container": "W3siR0lUSFVCX1RPS0VOIjoiZml4dHVyZS1zZWNyZXQtMDAwMSJ9LG51bGwseyJHSVRIVUJfVE9LRU4iOiJmaXh0dXJlLXNlY3JldC0wMDAyIn1d",
        "ops": [
          {
            "call": "owners",
            "args": []
          },
          {
            "call": "get",
            "args": [
              "1"
            ]
          }
        ]
      },
      "expected": [
        [
          "0",
          "1",
          "2"
        ],
        {}
      ]
    },
    {
      "name": "a set with no values past the end of an array store writes the array unchanged",
      "input": {
        "container": "W3siR0lUSFVCX1RPS0VOIjoiZml4dHVyZS1zZWNyZXQtMDAwMSJ9XQ==",
        "ops": [
          {
            "call": "set",
            "args": [
              "3",
              {
                "GITHUB_TOKEN": ""
              }
            ]
          },
          {
            "call": "container",
            "args": []
          }
        ]
      },
      "expected": [
        true,
        "W3siR0lUSFVCX1RPS0VOIjoiZml4dHVyZS1zZWNyZXQtMDAwMSJ9XQ=="
      ]
    },
    {
      "name": "a set on an empty array store fills index zero",
      "input": {
        "container": "W10=",
        "ops": [
          {
            "call": "set",
            "args": [
              "0",
              {
                "GITHUB_TOKEN": "fixture-secret-0001"
              }
            ]
          },
          {
            "call": "container",
            "args": []
          }
        ]
      },
      "expected": [
        true,
        "W3siR0lUSFVCX1RPS0VOIjoiZml4dHVyZS1zZWNyZXQtMDAwMSJ9XQ=="
      ]
    },
    {
      "name": "get of length on an array store reads the array's length, and follows a set past the end",
      "input": {
        "container": "W3siR0lUSFVCX1RPS0VOIjoiZml4dHVyZS1zZWNyZXQtMDAwMSJ9LHsiR0lUSFVCX1RPS0VOIjoiZml4dHVyZS1zZWNyZXQtMDAwMiJ9XQ==",
        "ops": [
          {
            "call": "get",
            "args": [
              "length"
            ]
          },
          {
            "call": "set",
            "args": [
              "4",
              {
                "GITHUB_TOKEN": "fixture-secret-0001"
              }
            ]
          },
          {
            "call": "get",
            "args": [
              "length"
            ]
          }
        ]
      },
      "expected": [
        2,
        true,
        5
      ]
    },
    {
      "name": "get of length on an object store reads empty",
      "input": {
        "container": "eyJnaXRodWIiOnsiR0lUSFVCX1RPS0VOIjoiZml4dHVyZS1zZWNyZXQtMDAwMSJ9fQ==",
        "ops": [
          {
            "call": "get",
            "args": [
              "length"
            ]
          }
        ]
      },
      "expected": [
        {}
      ]
    }
  ]
}
