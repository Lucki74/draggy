{
  "area": "secrets",
  "description": "Ordered ops over one store file with a working fake keystore. Covers stores that decrypt to something other than an object (the reference loads an array by its indices, and reads null, numbers and text as empty), owners named __proto__ and constructor, and set or withSecrets given null. The reference keeps a __proto__ owner in memory only, so it never reaches the file or the owner list. Expected entries follow the store.json shape.",
  "cases": [
    {
      "name": "lists the indices of a store that is an array",
      "input": {
        "container": "W3siR0lUSFVCX1RPS0VOIjoiZml4dHVyZS1zZWNyZXQtMDAwMSJ9XQ==",
        "ops": [
          {
            "call": "owners",
            "args": []
          },
          {
            "call": "get",
            "args": [
              "0"
            ]
          }
        ]
      },
      "expected": [
        [
          "0"
        ],
        {
          "GITHUB_TOKEN": "fixture-secret-0001"
        }
      ]
    },
    {
      "name": "writes an array store back as an array and drops an owner added to it",
      "input": {
        "container": "W3siR0lUSFVCX1RPS0VOIjoiZml4dHVyZS1zZWNyZXQtMDAwMSJ9XQ==",
        "ops": [
          {
            "call": "set",
            "args": [
              "github",
              {
                "GITHUB_TOKEN": "fixture-secret-0001"
              }
            ]
          },
          {
            "call": "container",
            "args": []
          },
          {
            "call": "owners",
            "args": []
          }
        ]
      },
      "expected": [
        true,
        "W3siR0lUSFVCX1RPS0VOIjoiZml4dHVyZS1zZWNyZXQtMDAwMSJ9XQ==",
        [
          "0",
          "github"
        ]
      ]
    },
    {
      "name": "writes a removed index of an array store as null",
      "input": {
        "container": "W3siR0lUSFVCX1RPS0VOIjoiZml4dHVyZS1zZWNyZXQtMDAwMSJ9LHsiR0lUSFVCX1RPS0VOIjoiZml4dHVyZS1zZWNyZXQtMDAwMiJ9XQ==",
        "ops": [
          {
            "call": "remove",
            "args": [
              "0"
            ]
          },
          {
            "call": "container",
            "args": []
          },
          {
            "call": "owners",
            "args": []
          }
        ]
      },
      "expected": [
        true,
        "W251bGwseyJHSVRIVUJfVE9LRU4iOiJmaXh0dXJlLXNlY3JldC0wMDAyIn1d",
        [
          "1"
        ]
      ]
    },
    {
      "name": "reads a store that is null as empty and saves over it",
      "input": {
        "container": "bnVsbA==",
        "ops": [
          {
            "call": "owners",
            "args": []
          },
          {
            "call": "set",
            "args": [
              "github",
              {
                "GITHUB_TOKEN": "fixture-secret-0001"
              }
            ]
          },
          {
            "call": "owners",
            "args": []
          }
        ]
      },
      "expected": [
        [],
        true,
        [
          "github"
        ]
      ]
    },
    {
      "name": "reads a store that is a number as empty",
      "input": {
        "container": "NDI=",
        "ops": [
          {
            "call": "owners",
            "args": []
          },
          {
            "call": "set",
            "args": [
              "github",
              {
                "GITHUB_TOKEN": "fixture-secret-0001"
              }
            ]
          },
          {
            "call": "owners",
            "args": []
          }
        ]
      },
      "expected": [
        [],
        true,
        [
          "github"
        ]
      ]
    },
    {
      "name": "reads a store that is text as empty",
      "input": {
        "container": "ImZpeHR1cmUtdGV4dCI=",
        "ops": [
          {
            "call": "owners",
            "args": []
          },
          {
            "call": "get",
            "args": [
              "github"
            ]
          }
        ]
      },
      "expected": [
        [],
        {}
      ]
    },
    {
      "name": "lists an owner named __proto__ that the store file holds",
      "input": {
        "container": "eyJfX3Byb3RvX18iOnsiR0lUSFVCX1RPS0VOIjoiZml4dHVyZS1zZWNyZXQtMDAwMSJ9fQ==",
        "ops": [
          {
            "call": "owners",
            "args": []
          },
          {
            "call": "get",
            "args": [
              "__proto__"
            ]
          }
        ]
      },
      "expected": [
        [
          "__proto__"
        ],
        {
          "GITHUB_TOKEN": "fixture-secret-0001"
        }
      ]
    },
    {
      "name": "keeps an owner named __proto__ in memory only",
      "input": {
        "ops": [
          {
            "call": "set",
            "args": [
              "__proto__",
              {
                "GITHUB_TOKEN": "fixture-secret-0001"
              }
            ]
          },
          {
            "call": "get",
            "args": [
              "__proto__"
            ]
          },
          {
            "call": "owners",
            "args": []
          },
          {
            "call": "container",
            "args": []
          }
        ]
      },
      "expected": [
        true,
        {
          "GITHUB_TOKEN": "fixture-secret-0001"
        },
        [],
        "e30="
      ]
    },
    {
      "name": "a remove of an owner named __proto__ does not clear the value set for it",
      "input": {
        "ops": [
          {
            "call": "set",
            "args": [
              "__proto__",
              {
                "GITHUB_TOKEN": "fixture-secret-0001"
              }
            ]
          },
          {
            "call": "remove",
            "args": [
              "__proto__"
            ]
          },
          {
            "call": "get",
            "args": [
              "__proto__"
            ]
          }
        ]
      },
      "expected": [
        true,
        true,
        {
          "GITHUB_TOKEN": "fixture-secret-0001"
        }
      ]
    },
    {
      "name": "keeps an owner named constructor like any other owner",
      "input": {
        "ops": [
          {
            "call": "set",
            "args": [
              "constructor",
              {
                "GITHUB_TOKEN": "fixture-secret-0001"
              }
            ]
          },
          {
            "call": "reopen",
            "args": []
          },
          {
            "call": "get",
            "args": [
              "constructor"
            ]
          }
        ]
      },
      "expected": [
        true,
        null,
        {
          "GITHUB_TOKEN": "fixture-secret-0001"
        }
      ]
    },
    {
      "name": "a set with no values forgets the owner",
      "input": {
        "ops": [
          {
            "call": "set",
            "args": [
              "github",
              {
                "GITHUB_TOKEN": "fixture-secret-0001"
              }
            ]
          },
          {
            "call": "set",
            "args": [
              "github",
              null
            ]
          },
          {
            "call": "get",
            "args": [
              "github"
            ]
          },
          {
            "call": "owners",
            "args": []
          }
        ]
      },
      "expected": [
        true,
        true,
        {},
        []
      ]
    },
    {
      "name": "withSecrets with no configured env returns only the stored values",
      "input": {
        "ops": [
          {
            "call": "set",
            "args": [
              "github",
              {
                "GITHUB_TOKEN": "fixture-secret-0001"
              }
            ]
          },
          {
            "call": "withSecrets",
            "args": [
              "github",
              null
            ]
          }
        ]
      },
      "expected": [
        true,
        {
          "GITHUB_TOKEN": "fixture-secret-0001"
        }
      ]
    }
  ]
}
