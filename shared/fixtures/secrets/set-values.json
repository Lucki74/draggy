{
  "area": "secrets",
  "description": "Ordered set-then-get ops on one owner. Each kept value is written as text the way JavaScript's String() writes it: numbers in shortest round-trip form, objects as [object Object], and arrays joined with commas. Null and the empty string are dropped before that. Negative zero and NaN cannot be written in JSON, so they are pinned on the Rust side only.",
  "cases": [
    {
      "name": "writes an integer past 2^53 as the nearest double",
      "input": {
        "ops": [
          {
            "call": "set",
            "args": [
              "svc",
              {
                "VALUE": 9007199254740992
              }
            ]
          },
          {
            "call": "get",
            "args": [
              "svc"
            ]
          }
        ]
      },
      "expected": [
        true,
        {
          "VALUE": "9007199254740992"
        }
      ]
    },
    {
      "name": "writes a large integer with trailing zeros as JavaScript does",
      "input": {
        "ops": [
          {
            "call": "set",
            "args": [
              "svc",
              {
                "VALUE": 12345678901234567000
              }
            ]
          },
          {
            "call": "get",
            "args": [
              "svc"
            ]
          }
        ]
      },
      "expected": [
        true,
        {
          "VALUE": "12345678901234567000"
        }
      ]
    },
    {
      "name": "writes 1e20 in full digits",
      "input": {
        "ops": [
          {
            "call": "set",
            "args": [
              "svc",
              {
                "VALUE": 100000000000000000000
              }
            ]
          },
          {
            "call": "get",
            "args": [
              "svc"
            ]
          }
        ]
      },
      "expected": [
        true,
        {
          "VALUE": "100000000000000000000"
        }
      ]
    },
    {
      "name": "writes 1e21 in exponent form",
      "input": {
        "ops": [
          {
            "call": "set",
            "args": [
              "svc",
              {
                "VALUE": 1e+21
              }
            ]
          },
          {
            "call": "get",
            "args": [
              "svc"
            ]
          }
        ]
      },
      "expected": [
        true,
        {
          "VALUE": "1e+21"
        }
      ]
    },
    {
      "name": "writes 1.5e-7 in exponent form",
      "input": {
        "ops": [
          {
            "call": "set",
            "args": [
              "svc",
              {
                "VALUE": 1.5e-7
              }
            ]
          },
          {
            "call": "get",
            "args": [
              "svc"
            ]
          }
        ]
      },
      "expected": [
        true,
        {
          "VALUE": "1.5e-7"
        }
      ]
    },
    {
      "name": "writes 0.000001 in full digits",
      "input": {
        "ops": [
          {
            "call": "set",
            "args": [
              "svc",
              {
                "VALUE": 0.000001
              }
            ]
          },
          {
            "call": "get",
            "args": [
              "svc"
            ]
          }
        ]
      },
      "expected": [
        true,
        {
          "VALUE": "0.000001"
        }
      ]
    },
    {
      "name": "writes a fraction with the shortest digits that round-trip",
      "input": {
        "ops": [
          {
            "call": "set",
            "args": [
              "svc",
              {
                "VALUE": 0.30000000000000004
              }
            ]
          },
          {
            "call": "get",
            "args": [
              "svc"
            ]
          }
        ]
      },
      "expected": [
        true,
        {
          "VALUE": "0.30000000000000004"
        }
      ]
    },
    {
      "name": "writes a negative fraction with its sign",
      "input": {
        "ops": [
          {
            "call": "set",
            "args": [
              "svc",
              {
                "VALUE": -2.25
              }
            ]
          },
          {
            "call": "get",
            "args": [
              "svc"
            ]
          }
        ]
      },
      "expected": [
        true,
        {
          "VALUE": "-2.25"
        }
      ]
    },
    {
      "name": "writes a nested object as [object Object]",
      "input": {
        "ops": [
          {
            "call": "set",
            "args": [
              "svc",
              {
                "VALUE": {
                  "nested": {
                    "x": 1
                  }
                }
              }
            ]
          },
          {
            "call": "get",
            "args": [
              "svc"
            ]
          }
        ]
      },
      "expected": [
        true,
        {
          "VALUE": "[object Object]"
        }
      ]
    },
    {
      "name": "writes an array as its items joined with commas, and null as nothing",
      "input": {
        "ops": [
          {
            "call": "set",
            "args": [
              "svc",
              {
                "VALUE": [
                  1,
                  [
                    2,
                    3
                  ],
                  null,
                  "x"
                ]
              }
            ]
          },
          {
            "call": "get",
            "args": [
              "svc"
            ]
          }
        ]
      },
      "expected": [
        true,
        {
          "VALUE": "1,2,3,,x"
        }
      ]
    },
    {
      "name": "writes an array of objects as one text per item",
      "input": {
        "ops": [
          {
            "call": "set",
            "args": [
              "svc",
              {
                "VALUE": [
                  {
                    "a": 1
                  },
                  {
                    "b": 2
                  }
                ]
              }
            ]
          },
          {
            "call": "get",
            "args": [
              "svc"
            ]
          }
        ]
      },
      "expected": [
        true,
        {
          "VALUE": "[object Object],[object Object]"
        }
      ]
    },
    {
      "name": "keeps an array that holds only nulls as its commas",
      "input": {
        "ops": [
          {
            "call": "set",
            "args": [
              "svc",
              {
                "VALUE": [
                  null,
                  null
                ]
              }
            ]
          },
          {
            "call": "get",
            "args": [
              "svc"
            ]
          }
        ]
      },
      "expected": [
        true,
        {
          "VALUE": ","
        }
      ]
    },
    {
      "name": "keeps an empty array as empty text",
      "input": {
        "ops": [
          {
            "call": "set",
            "args": [
              "svc",
              {
                "VALUE": []
              }
            ]
          },
          {
            "call": "get",
            "args": [
              "svc"
            ]
          }
        ]
      },
      "expected": [
        true,
        {
          "VALUE": ""
        }
      ]
    },
    {
      "name": "keeps an empty object as [object Object]",
      "input": {
        "ops": [
          {
            "call": "set",
            "args": [
              "svc",
              {
                "VALUE": {}
              }
            ]
          },
          {
            "call": "get",
            "args": [
              "svc"
            ]
          }
        ]
      },
      "expected": [
        true,
        {
          "VALUE": "[object Object]"
        }
      ]
    },
    {
      "name": "keeps non-ASCII text as it is",
      "input": {
        "ops": [
          {
            "call": "set",
            "args": [
              "svc",
              {
                "VALUE": "héllo 世界"
              }
            ]
          },
          {
            "call": "get",
            "args": [
              "svc"
            ]
          }
        ]
      },
      "expected": [
        true,
        {
          "VALUE": "héllo 世界"
        }
      ]
    },
    {
      "name": "keeps a string of spaces",
      "input": {
        "ops": [
          {
            "call": "set",
            "args": [
              "svc",
              {
                "VALUE": "   "
              }
            ]
          },
          {
            "call": "get",
            "args": [
              "svc"
            ]
          }
        ]
      },
      "expected": [
        true,
        {
          "VALUE": "   "
        }
      ]
    },
    {
      "name": "drops null and the empty string and keeps zero",
      "input": {
        "ops": [
          {
            "call": "set",
            "args": [
              "svc",
              {
                "A": null,
                "B": "",
                "C": 0
              }
            ]
          },
          {
            "call": "get",
            "args": [
              "svc"
            ]
          }
        ]
      },
      "expected": [
        true,
        {
          "C": "0"
        }
      ]
    }
  ]
}
