{
  "area": "secrets",
  "description": "Ordered ops for adopt when a record is owned by a name that is __proto__ (an own key, as JSON.parse makes it). The reference stores that owner's credentials on its prototype for this run only, and the owner never reaches the records or the file. Expected values are the reference's results.",
  "cases": [
    {
      "name": "moves a credential under an owner named __proto__ and leaves that owner out of the records",
      "input": {
        "ops": [
          {
            "call": "adopt",
            "args": [
              {
                "__proto__": {
                  "enabled": true,
                  "env": {
                    "GITHUB_TOKEN": "fixture-secret-0001",
                    "GITHUB_HOST": "github.com"
                  }
                },
                "github": {
                  "enabled": true,
                  "env": {
                    "GITHUB_TOKEN": "fixture-secret-0002"
                  }
                }
              },
              "TOKEN"
            ]
          },
          {
            "call": "get",
            "args": [
              "__proto__"
            ]
          },
          {
            "call": "get",
            "args": [
              "github"
            ]
          },
          {
            "call": "owners",
            "args": []
          },
          {
            "call": "container",
            "args": []
          }
        ]
      },
      "expected": [
        {
          "moved": 2,
          "records": {
            "github": {
              "enabled": true,
              "env": {}
            }
          }
        },
        {
          "GITHUB_TOKEN": "fixture-secret-0001"
        },
        {
          "GITHUB_TOKEN": "fixture-secret-0002"
        },
        [
          "github"
        ],
        "eyJnaXRodWIiOnsiR0lUSFVCX1RPS0VOIjoiZml4dHVyZS1zZWNyZXQtMDAwMiJ9fQ=="
      ]
    },
    {
      "name": "drops an owner named __proto__ from the records even when nothing moves",
      "input": {
        "ops": [
          {
            "call": "adopt",
            "args": [
              {
                "__proto__": {
                  "enabled": false,
                  "env": {
                    "GITHUB_TOKEN": ""
                  }
                }
              },
              "TOKEN"
            ]
          },
          {
            "call": "owners",
            "args": []
          }
        ]
      },
      "expected": [
        {
          "moved": 0,
          "records": {}
        },
        []
      ]
    },
    {
      "name": "a __proto__ owner's credentials are gone once the store is reopened",
      "input": {
        "ops": [
          {
            "call": "adopt",
            "args": [
              {
                "__proto__": {
                  "enabled": true,
                  "env": {
                    "GITHUB_TOKEN": "fixture-secret-0001",
                    "GITHUB_HOST": "github.com"
                  }
                },
                "github": {
                  "enabled": true,
                  "env": {
                    "GITHUB_TOKEN": "fixture-secret-0002"
                  }
                }
              },
              "TOKEN"
            ]
          },
          {
            "call": "reopen",
            "args": []
          },
          {
            "call": "get",
            "args": [
              "__proto__"
            ]
          },
          {
            "call": "owners",
            "args": []
          }
        ]
      },
      "expected": [
        {
          "moved": 2,
          "records": {
            "github": {
              "enabled": true,
              "env": {}
            }
          }
        },
        null,
        {},
        [
          "github"
        ]
      ]
    }
  ]
}
