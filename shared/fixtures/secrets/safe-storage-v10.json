{
  "area": "secrets",
  "description": "Electron safeStorage v10 blobs on Linux: AES-128-CBC, a 16-byte key from PBKDF2-HMAC-SHA1 over the password with salt saltysalt and one round, an IV of sixteen spaces, PKCS#7 padding. Input is the blob as base64 (prefix included) and the password. Expected is { plaintext } or { error } with the stable code. Blobs were made with node:crypto from a known plaintext, not from a decoder. The TS runner re-derives each answer with node:crypto.",
  "cases": [
    {
      "name": "decrypts a basic_text blob",
      "input": {
        "blob": "djEwxlnE+bRDubc/DGW1Vj0FWR0YAMOXwbQZVliCzHieuoU=",
        "password": "peanuts"
      },
      "expected": {
        "plaintext": "fixture-secret-v10-0001"
      }
    },
    {
      "name": "decrypts a value spanning several blocks",
      "input": {
        "blob": "djEwj/5E6d1bObzGM2gA/9ZdaTt0qqYd+QSILF56/DceMShZsatA8zNjQ3VVM869ybI44/89CPb6oVCnVFMNnZGd9L5NY5yBUfs4IMDriV+orYLS5DqJaOlXy/YChJmAzJoOGIJXQuFWwBpg2HkdgqPlvyuCKHtG7vnihXRrMJS8dT4=",
        "password": "peanuts"
      },
      "expected": {
        "plaintext": "fixture-token-fixture-token-fixture-token-fixture-token-fixture-token-fixture-token-fixture-token-fixture-token-fixture-token-"
      }
    },
    {
      "name": "decrypts an empty value",
      "input": {
        "blob": "djEwK7xxe29GDDor0ALcseSKlw==",
        "password": "peanuts"
      },
      "expected": {
        "plaintext": ""
      }
    },
    {
      "name": "decrypts a value of exactly one block",
      "input": {
        "blob": "djEwC5zwpu7pzxqqxgG4XKN8+YSPahULdJyY0ogcD6lFP3Y=",
        "password": "peanuts"
      },
      "expected": {
        "plaintext": "0123456789abcdef"
      }
    },
    {
      "name": "decrypts non-ASCII text",
      "input": {
        "blob": "djEwuTEellPJmheRbgcPI359fc5fZXwwhRwElWimjykQ0So=",
        "password": "peanuts"
      },
      "expected": {
        "plaintext": "fixture-clé-钥匙-0001"
      }
    },
    {
      "name": "refuses a blob without the v10 prefix",
      "input": {
        "blob": "djExxlnE+bRDubc/DGW1Vj0FWR0YAMOXwbQZVliCzHieuoU=",
        "password": "peanuts"
      },
      "expected": {
        "error": "not_v10"
      }
    },
    {
      "name": "refuses a blob that is not a whole number of blocks",
      "input": {
        "blob": "djEwxlnE+bRDubc/DGW1Vj0FWR0YAMOXwbQZVliCzHieug==",
        "password": "peanuts"
      },
      "expected": {
        "error": "bad_length"
      }
    },
    {
      "name": "refuses a blob with no ciphertext",
      "input": {
        "blob": "djEw",
        "password": "peanuts"
      },
      "expected": {
        "error": "bad_length"
      }
    },
    {
      "name": "refuses a blob whose last block ends in a zero pad byte",
      "input": {
        "blob": "djEwp/hhrUv2VgzxTTKOArBkqg==",
        "password": "peanuts"
      },
      "expected": {
        "error": "bad_padding"
      }
    },
    {
      "name": "refuses a blob decrypted with another password",
      "input": {
        "blob": "djEwxlnE+bRDubc/DGW1Vj0FWR0YAMOXwbQZVliCzHieuoU=",
        "password": "not-peanuts"
      },
      "expected": {
        "error": "bad_padding"
      }
    }
  ]
}
