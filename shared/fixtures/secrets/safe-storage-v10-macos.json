{
  "area": "secrets",
  "description": "Electron safeStorage v10 blobs written on macOS: AES-128-CBC, a key from PBKDF2-HMAC-SHA1 over the Keychain password with salt saltysalt and 1003 rounds, an IV of sixteen spaces, PKCS#7 padding. The scheme field picks the rounds: linux is one, macos is 1003. Blobs were made with node:crypto, not a decoder: the TS runner re-derives each answer with node:crypto, since electron/ has no v10 decoder.",
  "cases": [
    {
      "name": "decrypts a macOS blob with 1003 rounds",
      "input": {
        "blob": "djEw7fRqyJmjw36xhSMGxoX60s5YS8wfYrnEJCk5VwfIO/c=",
        "password": "fixture-keychain-password",
        "scheme": "macos"
      },
      "expected": {
        "plaintext": "fixture-keychain-secret-0001"
      }
    },
    {
      "name": "decrypts a macOS blob spanning several blocks",
      "input": {
        "blob": "djEw7fRqyJmjw36xhSMGxoX60tpTb9YAJroUSJsHKikJnPkxMJ0k2IGYkKz0mXprJs38zM92CQd26Jf57IeMgMcwGbXfWMNEeJNWIbQJ2yDDTE/nCFGZfF45gNMzJA4+14VlJ/4LjcgHTUmn/+V1c5KEtbY7Rxwi6KEEzBvitUTdiC1VRbfQCzfMsPQw5y7+PcrY",
        "password": "fixture-keychain-password",
        "scheme": "macos"
      },
      "expected": {
        "plaintext": "fixture-keychain-token-fixture-keychain-token-fixture-keychain-token-fixture-keychain-token-fixture-keychain-token-fixture-keychain-token-"
      }
    },
    {
      "name": "refuses a macOS blob decrypted with the Linux single round",
      "input": {
        "blob": "djEw7fRqyJmjw36xhSMGxoX60s5YS8wfYrnEJCk5VwfIO/c=",
        "password": "fixture-keychain-password",
        "scheme": "linux"
      },
      "expected": {
        "error": "bad_padding"
      }
    },
    {
      "name": "refuses a macOS blob decrypted with another password",
      "input": {
        "blob": "djEw7fRqyJmjw36xhSMGxoX60s5YS8wfYrnEJCk5VwfIO/c=",
        "password": "not-the-keychain-password",
        "scheme": "macos"
      },
      "expected": {
        "error": "bad_padding"
      }
    },
    {
      "name": "refuses a Linux blob decrypted with the macOS rounds",
      "input": {
        "blob": "djEwxlnE+bRDubc/DGW1Vj0FWR0YAMOXwbQZVliCzHieuoU=",
        "password": "peanuts",
        "scheme": "macos"
      },
      "expected": {
        "error": "bad_padding"
      }
    }
  ]
}
