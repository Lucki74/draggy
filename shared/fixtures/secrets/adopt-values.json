{
  "area": "secrets",
  "description": "Migration of credentials whose values are not plain text: the reference turns each into text with String(), so an object becomes [object Object], an array is joined, zero and false are kept, and an empty array moves as nothing. adopt given no records returns no records and moves nothing.",
  "cases": [
    {
      "name": "keeps an object value as the text [object Object]",
      "input": {
        "ops": [
          {
            "call": "adopt",
            "args": [
              {
                "github": {
                  "env": {
                    "API_TOKEN": {
                      "kind": "x"
                    },
                    "GITHUB_HOST": "github.com"
                  }
                }
              },
              "TOKEN"
            ]
          },
          {
            "call": "get",
            "args": [
              "github"
            ]
          }
        ]
      },
      "expected": [
        {
          "moved": 1,
          "records": {
            "github": {
              "env": {
                "GITHUB_HOST": "github.com"
              }
            }
          }
        },
        {
          "API_TOKEN": "[object Object]"
        }
      ]
    },
    {
      "name": "keeps zero and false as text when they move",
      "input": {
        "ops": [
          {
            "call": "adopt",
            "args": [
              {
                "github": {
                  "env": {
                    "API_TOKEN": 0,
                    "OTHER_TOKEN": false
                  }
                }
              },
              "TOKEN"
            ]
          },
          {
            "call": "get",
            "args": [
              "github"
            ]
          }
        ]
      },
      "expected": [
        {
          "moved": 2,
          "records": {
            "github": {
              "env": {}
            }
          }
        },
        {
          "API_TOKEN": "0",
          "OTHER_TOKEN": "false"
        }
      ]
    },
    {
      "name": "joins an array value, and an empty array moves as nothing",
      "input": {
        "ops": [
          {
            "call": "adopt",
            "args": [
              {
                "github": {
                  "env": {
                    "API_TOKEN": [
                      "a",
                      null,
                      "b"
                    ],
                    "EMPTY_TOKEN": []
                  }
                }
              },
              "TOKEN"
            ]
          },
          {
            "call": "get",
            "args": [
              "github"
            ]
          }
        ]
      },
      "expected": [
        {
          "moved": 2,
          "records": {
            "github": {
              "env": {}
            }
          }
        },
        {
          "API_TOKEN": "a,,b"
        }
      ]
    },
    {
      "name": "moves nothing when there are no records",
      "input": {
        "ops": [
          {
            "call": "adopt",
            "args": [
              null,
              "TOKEN"
            ]
          },
          {
            "call": "owners",
            "args": []
          }
        ]
      },
      "expected": [
        {
          "moved": 0,
          "records": {}
        },
        []
      ]
    }
  ]
}
