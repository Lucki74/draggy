{
  "area": "secrets",
  "description": "Ordered ops for adopt over records and envs that are not plain objects. The reference reads a null record as empty, a text or array record by its characters or indices, and a number or boolean record as empty. An env is read the same way by Object.entries, and an env that is not an object or array moves nothing.",
  "cases": [
    {
      "name": "an owner whose record is null becomes an empty record",
      "input": {
        "ops": [
          {
            "call": "adopt",
            "args": [
              {
                "github": null
              },
              "TOKEN"
            ]
          }
        ]
      },
      "expected": [
        {
          "moved": 0,
          "records": {
            "github": {}
          }
        }
      ]
    },
    {
      "name": "a record that is text is read as its characters",
      "input": {
        "ops": [
          {
            "call": "adopt",
            "args": [
              {
                "svc": "ab"
              },
              ""
            ]
          }
        ]
      },
      "expected": [
        {
          "moved": 0,
          "records": {
            "svc": {
              "0": "a",
              "1": "b"
            }
          }
        }
      ]
    },
    {
      "name": "a record that is an array is read by its indices",
      "input": {
        "ops": [
          {
            "call": "adopt",
            "args": [
              {
                "svc": [
                  1,
                  2
                ]
              },
              ""
            ]
          }
        ]
      },
      "expected": [
        {
          "moved": 0,
          "records": {
            "svc": {
              "0": 1,
              "1": 2
            }
          }
        }
      ]
    },
    {
      "name": "a record that is a number or a boolean becomes an empty record",
      "input": {
        "ops": [
          {
            "call": "adopt",
            "args": [
              {
                "svc": 7,
                "other": false
              },
              "TOKEN"
            ]
          }
        ]
      },
      "expected": [
        {
          "moved": 0,
          "records": {
            "svc": {},
            "other": {}
          }
        }
      ]
    },
    {
      "name": "an env that is text moves its characters as secrets",
      "input": {
        "ops": [
          {
            "call": "adopt",
            "args": [
              {
                "github": {
                  "enabled": true,
                  "env": "ab"
                }
              },
              ""
            ]
          },
          {
            "call": "get",
            "args": [
              "github"
            ]
          }
        ]
      },
      "expected": [
        {
          "moved": 2,
          "records": {
            "github": {
              "enabled": true,
              "env": {}
            }
          }
        },
        {
          "0": "a",
          "1": "b"
        }
      ]
    },
    {
      "name": "an env that is an array moves its items by index and keeps the blank ones",
      "input": {
        "ops": [
          {
            "call": "adopt",
            "args": [
              {
                "github": {
                  "enabled": true,
                  "env": [
                    "x",
                    null,
                    "y"
                  ]
                }
              },
              ""
            ]
          },
          {
            "call": "get",
            "args": [
              "github"
            ]
          }
        ]
      },
      "expected": [
        {
          "moved": 2,
          "records": {
            "github": {
              "enabled": true,
              "env": {
                "1": null
              }
            }
          }
        },
        {
          "0": "x",
          "2": "y"
        }
      ]
    },
    {
      "name": "an env that is text is kept as it is when no field is a secret",
      "input": {
        "ops": [
          {
            "call": "adopt",
            "args": [
              {
                "svc": {
                  "env": "ab"
                }
              },
              "TOKEN"
            ]
          }
        ]
      },
      "expected": [
        {
          "moved": 0,
          "records": {
            "svc": {
              "env": "ab"
            }
          }
        }
      ]
    },
    {
      "name": "an env that is a number, a boolean or empty moves nothing",
      "input": {
        "ops": [
          {
            "call": "adopt",
            "args": [
              {
                "a": {
                  "env": 5
                },
                "b": {
                  "env": true
                },
                "c": {
                  "env": ""
                }
              },
              ""
            ]
          },
          {
            "call": "owners",
            "args": []
          }
        ]
      },
      "expected": [
        {
          "moved": 0,
          "records": {
            "a": {
              "env": 5
            },
            "b": {
              "env": true
            },
            "c": {
              "env": ""
            }
          }
        },
        []
      ]
    }
  ]
}
