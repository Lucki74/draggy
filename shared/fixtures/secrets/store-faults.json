{
  "area": "secrets",
  "description": "Ops over one store file where the file or the keystore misbehaves. The vault spec's encrypt and decrypt set to \"throws\" make the keystore refuse a write or a read. The makeDirectory op puts a directory where the store file would be. A store the keystore cannot decrypt reads empty and the next save replaces it. A refused write returns false and keeps the value for the run. Containers with line breaks or no base64 padding read as Node's base64 decoder reads them.",
  "cases": [
    {
      "name": "reads a store whose base64 holds line breaks",
      "input": {
        "container": "eyJnaXRodWIiOnsi\nR0lUSFVCX1RPS0VOIjoi\nZml4dHVyZS1zZWNyZXQtMDAwMSJ9fQ==\n",
        "ops": [
          {
            "call": "get",
            "args": [
              "github"
            ]
          }
        ]
      },
      "expected": [
        {
          "GITHUB_TOKEN": "fixture-secret-0001"
        }
      ]
    },
    {
      "name": "reads a store whose base64 has no padding",
      "input": {
        "container": "eyJnaXRodWIiOnsiR0lUSFVCX1RPS0VOIjoiZml4dHVyZS1zZWNyZXQtMDAwMSJ9fQ",
        "ops": [
          {
            "call": "get",
            "args": [
              "github"
            ]
          }
        ]
      },
      "expected": [
        {
          "GITHUB_TOKEN": "fixture-secret-0001"
        }
      ]
    },
    {
      "name": "a store the keystore cannot decrypt reads empty and the next save replaces it",
      "input": {
        "vault": {
          "decrypt": "throws"
        },
        "container": "eyJnaXRodWIiOnsiR0lUSFVCX1RPS0VOIjoiZml4dHVyZS1zZWNyZXQtMDAwMSJ9fQ==",
        "ops": [
          {
            "call": "get",
            "args": [
              "github"
            ]
          },
          {
            "call": "set",
            "args": [
              "svc",
              {
                "PORT": 8080
              }
            ]
          },
          {
            "call": "owners",
            "args": []
          }
        ]
      },
      "expected": [
        {},
        true,
        [
          "svc"
        ]
      ]
    },
    {
      "name": "a write the keystore refuses returns false, writes nothing, and keeps the value for the run",
      "input": {
        "vault": {
          "encrypt": "throws"
        },
        "ops": [
          {
            "call": "set",
            "args": [
              "github",
              {
                "GITHUB_TOKEN": "fixture-secret-0001"
              }
            ]
          },
          {
            "call": "container",
            "args": []
          },
          {
            "call": "get",
            "args": [
              "github"
            ]
          }
        ]
      },
      "expected": [
        false,
        null,
        {
          "GITHUB_TOKEN": "fixture-secret-0001"
        }
      ]
    },
    {
      "name": "a write to a store path that is a directory returns false and keeps the value for the run",
      "input": {
        "ops": [
          {
            "call": "makeDirectory",
            "args": []
          },
          {
            "call": "set",
            "args": [
              "github",
              {
                "GITHUB_TOKEN": "fixture-secret-0001"
              }
            ]
          },
          {
            "call": "get",
            "args": [
              "github"
            ]
          }
        ]
      },
      "expected": [
        null,
        false,
        {
          "GITHUB_TOKEN": "fixture-secret-0001"
        }
      ]
    }
  ]
}
