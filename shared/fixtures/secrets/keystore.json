{
  "area": "secrets",
  "description": "Ops over the store with a keystore that is unavailable, or that reports a basic_text or missing backend. Availability is the keystore's check plus its backend name, where basic_text means no keystore. An unavailable keystore reads an empty store but keeps writes in memory for the run. Same ops and expected shape as store.json.",
  "cases": [
    {
      "name": "refuses to write credentials when the keystore is unavailable, and keeps them in memory for the run",
      "input": {
        "vault": {
          "encryptionAvailable": false
        },
        "ops": [
          {
            "call": "set",
            "args": [
              "github",
              {
                "GITHUB_TOKEN": "fixture-secret-0001"
              }
            ]
          },
          {
            "call": "container",
            "args": []
          },
          {
            "call": "fileContains",
            "args": [
              "fixture-secret-0001"
            ]
          },
          {
            "call": "get",
            "args": [
              "github"
            ]
          },
          {
            "call": "reopen",
            "args": []
          },
          {
            "call": "get",
            "args": [
              "github"
            ]
          }
        ]
      },
      "expected": [
        false,
        null,
        false,
        {
          "GITHUB_TOKEN": "fixture-secret-0001"
        },
        null,
        {}
      ]
    },
    {
      "name": "reports unavailable when the keystore check throws",
      "input": {
        "vault": {
          "encryptionAvailable": "throws"
        },
        "ops": [
          {
            "call": "available",
            "args": []
          },
          {
            "call": "set",
            "args": [
              "github",
              {
                "GITHUB_TOKEN": "fixture-secret-0001"
              }
            ]
          },
          {
            "call": "container",
            "args": []
          }
        ]
      },
      "expected": [
        false,
        false,
        null
      ]
    },
    {
      "name": "counts the basic_text backend as no keystore",
      "input": {
        "vault": {
          "backend": "basic_text"
        },
        "ops": [
          {
            "call": "available",
            "args": []
          },
          {
            "call": "set",
            "args": [
              "provider:openai",
              {
                "apiKey": "fixture-secret-0012"
              }
            ]
          },
          {
            "call": "container",
            "args": []
          }
        ]
      },
      "expected": [
        false,
        false,
        null
      ]
    },
    {
      "name": "trusts a real keyring backend",
      "input": {
        "vault": {
          "backend": "gnome_libsecret"
        },
        "ops": [
          {
            "call": "available",
            "args": []
          },
          {
            "call": "set",
            "args": [
              "github",
              {
                "GITHUB_TOKEN": "fixture-secret-0001"
              }
            ]
          },
          {
            "call": "get",
            "args": [
              "github"
            ]
          }
        ]
      },
      "expected": [
        true,
        true,
        {
          "GITHUB_TOKEN": "fixture-secret-0001"
        }
      ]
    },
    {
      "name": "trusts a platform with no backend call",
      "input": {
        "vault": {},
        "ops": [
          {
            "call": "available",
            "args": []
          }
        ]
      },
      "expected": [
        true
      ]
    },
    {
      "name": "trusts a platform whose backend call throws",
      "input": {
        "vault": {
          "backend": "throws"
        },
        "ops": [
          {
            "call": "available",
            "args": []
          }
        ]
      },
      "expected": [
        true
      ]
    },
    {
      "name": "reads nothing from an unavailable keystore, even when a store exists",
      "input": {
        "vault": {
          "encryptionAvailable": false
        },
        "container": "eyJnaXRodWIiOnsiR0lUSFVCX1RPS0VOIjoiZml4dHVyZS1zZWNyZXQtMDAwMSJ9fQ==",
        "ops": [
          {
            "call": "get",
            "args": [
              "github"
            ]
          },
          {
            "call": "owners",
            "args": []
          }
        ]
      },
      "expected": [
        {},
        []
      ]
    },
    {
      "name": "reads a stored value again once the keystore is available",
      "input": {
        "container": "eyJnaXRodWIiOnsiR0lUSFVCX1RPS0VOIjoiZml4dHVyZS1zZWNyZXQtMDAwMSJ9fQ==",
        "ops": [
          {
            "call": "get",
            "args": [
              "github"
            ]
          }
        ]
      },
      "expected": [
        {
          "GITHUB_TOKEN": "fixture-secret-0001"
        }
      ]
    },
    {
      "name": "reads nothing from a basic_text keystore even when a store exists",
      "input": {
        "vault": {
          "backend": "basic_text"
        },
        "container": "eyJnaXRodWIiOnsiR0lUSFVCX1RPS0VOIjoiZml4dHVyZS1zZWNyZXQtMDAwMSJ9fQ==",
        "ops": [
          {
            "call": "get",
            "args": [
              "github"
            ]
          },
          {
            "call": "owners",
            "args": []
          }
        ]
      },
      "expected": [
        {},
        []
      ]
    },
    {
      "name": "writes nothing when removing from an unavailable keystore",
      "input": {
        "vault": {
          "encryptionAvailable": false
        },
        "ops": [
          {
            "call": "remove",
            "args": [
              "github"
            ]
          },
          {
            "call": "container",
            "args": []
          }
        ]
      },
      "expected": [
        false,
        null
      ]
    }
  ]
}
