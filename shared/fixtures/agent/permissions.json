            "target": "C:\\projects\\draggy"
          }
        ]
      },
      "expected": {
        "decision": "ask",
        "reason": "This changes something outside Draggy, so the user is asked first."
      }
    },
    {
      "name": "a grant of a bare slash covers every path (TS quirk)",
      "input": {
        "op": "decide",
        "mode": "ask",
        "tool": "write_file",
        "target": "D:\\anything.txt",
        "grants": [
          {
            "tool": "write_file",
            "target": "/"
          }
        ]
      },
      "expected": {
