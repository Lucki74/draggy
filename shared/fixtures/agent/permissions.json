{
  "area": "agent",
  "description": "The permission verdict for a tool call, grant coverage and merging, and what an approval remembers (permissions.rs). Stateless per case; the op names what is under test.",
  "cases": [
    {
      "name": "reading is allowed in plan mode",
      "input": {
        "op": "decide",
        "mode": "plan",
        "tool": "a_tool",
        "annotations": {
          "readOnly": true
        }
      },
      "expected": {
        "decision": "allow",
        "reason": "This tool only reads."
      }
    },
    {
      "name": "reading the web is allowed in every mode",
      "input": {
        "op": "decide",
        "mode": "ask",
        "tool": "a_tool",
        "annotations": {
          "readOnly": true,
          "openWorld": true
        }
      },
      "expected": {
        "decision": "allow",
        "reason": "This tool only reads."
      }
    },
    {
      "name": "reading is allowed in accept-edits mode",
      "input": {
        "op": "decide",
        "mode": "acceptEdits",
        "tool": "a_tool",
        "annotations": {
          "readOnly": true
        }
      },
      "expected": {
        "decision": "allow",
        "reason": "This tool only reads."
      }
    },
    {
      "name": "reading is allowed in auto mode",
      "input": {
        "op": "decide",
        "mode": "auto",
        "tool": "a_tool",
        "annotations": {
          "readOnly": true
        }
      },
      "expected": {
        "decision": "allow",
        "reason": "This tool only reads."
      }
    },
    {
      "name": "reading the web is allowed in plan mode",
      "input": {
        "op": "decide",
        "mode": "plan",
        "tool": "a_tool",
        "annotations": {
          "readOnly": true,
          "openWorld": true
        }
      },
      "expected": {
        "decision": "allow",
        "reason": "This tool only reads."
      }
    },
    {
      "name": "plan mode refuses an edit",
      "input": {
        "op": "decide",
        "mode": "plan",
        "tool": "a_tool",
        "annotations": {}
      },
      "expected": {
        "decision": "deny",
        "reason": "This conversation is in plan mode, which cannot change anything or run commands. Describe what you would do instead, and the user will decide."
      }
    },
    {
      "name": "plan mode refuses Draggy's own storage",
      "input": {
        "op": "decide",
        "mode": "plan",
        "tool": "a_tool",
        "annotations": {
          "sandboxed": true
        }
      },
      "expected": {
        "decision": "deny",
        "reason": "This conversation is in plan mode, which cannot change anything or run commands. Describe what you would do instead, and the user will decide."
      }
    },
    {
      "name": "plan mode refuses a deletion",
      "input": {
        "op": "decide",
        "mode": "plan",
        "tool": "a_tool",
        "annotations": {
          "destructive": true
        }
      },
      "expected": {
        "decision": "deny",
        "reason": "This conversation is in plan mode, which cannot change anything or run commands. Describe what you would do instead, and the user will decide."
      }
    },
    {
      "name": "plan mode refuses even an allowed tool",
      "input": {
        "op": "decide",
        "mode": "plan",
        "tool": "a_tool",
        "annotations": {},
        "grants": [
          {
            "tool": "a_tool"
          }
        ]
      },
      "expected": {
        "decision": "deny",
        "reason": "This conversation is in plan mode, which cannot change anything or run commands. Describe what you would do instead, and the user will decide."
      }
    },
    {
      "name": "draggy's own storage runs in ask mode",
      "input": {
        "op": "decide",
        "mode": "ask",
        "tool": "a_tool",
        "annotations": {
          "sandboxed": true
        }
      },
      "expected": {
        "decision": "allow",
        "reason": "This stays inside Draggy's own storage."
      }
    },
    {
      "name": "draggy's own storage runs in accept-edits mode",
      "input": {
        "op": "decide",
        "mode": "acceptEdits",
        "tool": "a_tool",
        "annotations": {
          "sandboxed": true
        }
      },
      "expected": {
        "decision": "allow",
        "reason": "This stays inside Draggy's own storage."
      }
    },
    {
      "name": "a sandboxed deletion still asks",
      "input": {
        "op": "decide",
        "mode": "ask",
        "tool": "a_tool",
        "annotations": {
          "sandboxed": true,
          "destructive": true
        }
      },
      "expected": {
        "decision": "ask",
        "reason": "This can lose work, so the user is asked first."
      }
    },
    {
      "name": "ask mode asks for an edit",
      "input": {
        "op": "decide",
        "mode": "ask",
        "tool": "a_tool",
        "annotations": {}
      },
      "expected": {
        "decision": "ask",
        "reason": "This changes something outside Draggy, so the user is asked first."
      }
    },
    {
      "name": "ask mode asks for a deletion",
      "input": {
        "op": "decide",
        "mode": "ask",
        "tool": "a_tool",
        "annotations": {
          "destructive": true
        }
      },
      "expected": {
        "decision": "ask",
        "reason": "This can lose work, so the user is asked first."
      }
    },
    {
      "name": "a granted tool is allowed in ask mode",
      "input": {
        "op": "decide",
        "mode": "ask",
        "tool": "a_tool",
        "annotations": {},
        "grants": [
          {
            "tool": "a_tool"
          }
        ]
      },
      "expected": {
        "decision": "allow",
        "reason": "The user has already allowed this."
      }
    },
    {
      "name": "another tool's grant does not cover this one",
      "input": {
        "op": "decide",
        "mode": "ask",
        "tool": "a_tool",
        "annotations": {},
        "grants": [
          {
            "tool": "other_tool"
          }
        ]
      },
      "expected": {
        "decision": "ask",
        "reason": "This changes something outside Draggy, so the user is asked first."
      }
    },
    {
      "name": "accept-edits lets an edit through",
      "input": {
        "op": "decide",
        "mode": "acceptEdits",
        "tool": "a_tool",
        "annotations": {}
      },
      "expected": {
        "decision": "allow",
        "reason": "Edits are accepted in this workspace."
      }
    },
    {
      "name": "accept-edits still asks for a deletion",
      "input": {
        "op": "decide",
        "mode": "acceptEdits",
        "tool": "a_tool",
        "annotations": {
          "destructive": true
        }
      },
      "expected": {
        "decision": "ask",
        "reason": "This can lose work, so the user is asked first."
      }
    },
    {
      "name": "accept-edits lets an allowed deletion through",
      "input": {
        "op": "decide",
        "mode": "acceptEdits",
        "tool": "a_tool",
        "annotations": {
          "destructive": true
        },
        "grants": [
          {
            "tool": "a_tool"
          }
        ]
      },
      "expected": {
        "decision": "allow",
        "reason": "The user has already allowed this."
      }
    },
    {
      "name": "auto runs an edit",
      "input": {
        "op": "decide",
        "mode": "auto",
        "tool": "a_tool",
        "annotations": {}
      },
      "expected": {
        "decision": "allow",
        "reason": "This workspace runs tools without asking."
      }
    },
    {
      "name": "auto runs a deletion",
      "input": {
        "op": "decide",
        "mode": "auto",
        "tool": "a_tool",
        "annotations": {
          "destructive": true
        }
      },
      "expected": {
        "decision": "allow",
        "reason": "This workspace runs tools without asking."
      }
    },
    {
      "name": "a command asks in ask mode",
      "input": {
        "op": "decide",
        "mode": "ask",
        "tool": "run_command",
        "annotations": {
          "executes": true,
          "openWorld": true
        },
        "target": "npm test"
      },
      "expected": {
        "decision": "ask",
        "reason": "This runs a command on the user's computer, so the user is asked first."
      }
    },
    {
      "name": "a command asks in accept-edits mode",
      "input": {
        "op": "decide",
        "mode": "acceptEdits",
        "tool": "run_command",
        "annotations": {
          "executes": true,
          "openWorld": true
        },
        "target": "git status"
      },
      "expected": {
        "decision": "ask",
        "reason": "This runs a command on the user's computer, so the user is asked first."
      }
    },
    {
      "name": "a command runs in auto mode",
      "input": {
        "op": "decide",
        "mode": "auto",
        "tool": "run_command",
        "annotations": {
          "executes": true,
          "openWorld": true
        },
        "target": "rm -rf build"
      },
      "expected": {
        "decision": "allow",
        "reason": "This workspace runs tools without asking."
      }
    },
    {
      "name": "a command is refused in plan mode even when allowed",
      "input": {
        "op": "decide",
        "mode": "plan",
        "tool": "run_command",
        "annotations": {
          "executes": true,
          "openWorld": true
        },
        "target": "npm test",
        "grants": [
          {
            "tool": "run_command",
            "target": "npm test"
          }
        ]
      },
      "expected": {
        "decision": "deny",
        "reason": "This conversation is in plan mode, which cannot change anything or run commands. Describe what you would do instead, and the user will decide."
      }
    },
    {
      "name": "an allowed command runs in accept-edits mode",
      "input": {
        "op": "decide",
        "mode": "acceptEdits",
        "tool": "run_command",
        "annotations": {
          "executes": true,
          "openWorld": true
        },
        "target": "npm test -- --watch",
        "grants": [
          {
            "tool": "run_command",
            "target": "npm test"
          }
        ]
      },
      "expected": {
        "decision": "allow",
        "reason": "The user has already allowed this command."
      }
    },
    {
      "name": "an allowed command with a chained one asks",
      "input": {
        "op": "decide",
        "mode": "ask",
        "tool": "run_command",
        "annotations": {
          "executes": true,
          "openWorld": true
        },
        "target": "git status && rm -rf .",
        "grants": [
          {
            "tool": "run_command",
            "target": "git status"
          }
        ]
      },
      "expected": {
        "decision": "ask",
        "reason": "This runs a command on the user's computer, so the user is asked first."
      }
    },
    {
      "name": "a command with no target asks",
      "input": {
        "op": "decide",
        "mode": "ask",
        "tool": "run_command",
        "annotations": {
          "executes": true,
          "openWorld": true
        },
        "grants": [
          {
            "tool": "run_command",
            "target": "git status"
          }
        ]
      },
      "expected": {
        "decision": "ask",
        "reason": "This runs a command on the user's computer, so the user is asked first."
      }
    },
    {
      "name": "a folder grant covers the folder itself",
      "input": {
        "op": "decide",
        "mode": "ask",
        "tool": "write_file",
        "target": "C:\\projects\\draggy",
        "grants": [
          {
            "tool": "write_file",
            "target": "C:\\projects\\draggy"
          }
        ]
      },
      "expected": {
        "decision": "allow",
        "reason": "The user has already allowed this."
      }
    },
    {
      "name": "a folder grant covers a file under it",
      "input": {
        "op": "decide",
        "mode": "ask",
        "tool": "write_file",
        "target": "C:\\projects\\draggy\\src\\App.tsx",
        "grants": [
          {
            "tool": "write_file",
            "target": "C:\\projects\\draggy"
          }
        ]
      },
      "expected": {
        "decision": "allow",
        "reason": "The user has already allowed this."
      }
    },
    {
      "name": "a sibling with a longer name is not covered",
      "input": {
        "op": "decide",
        "mode": "ask",
        "tool": "write_file",
        "target": "C:\\projects\\draggy-website\\index.html",
        "grants": [
          {
            "tool": "write_file",
            "target": "C:\\projects\\draggy"
          }
        ]
      },
      "expected": {
        "decision": "ask",
        "reason": "This changes something outside Draggy, so the user is asked first."
      }
    },
    {
      "name": "the folder above is not covered",
      "input": {
        "op": "decide",
        "mode": "ask",
        "tool": "write_file",
