    {
      "name": "a folder grant covers a path in a different case",
      "input": {
        "op": "grantCovers",
        "grant": {
          "tool": "write_file",
          "target": "C:\\projects\\draggy"
        },
        "tool": "write_file",
        "target": "c:\\PROJECTS\\Draggy\\x.ts"
      },
      "expected": true
    },
    {
      "name": "a grant for another tool does not cover",
      "input": {
        "op": "grantCovers",
        "grant": {
          "tool": "read_file"
        },
        "tool": "write_file",
        "target": "a"
      },
      "expected": false
    },
    {
      "name": "a grant with no target covers any target",
      "input": {
        "op": "grantCovers",
        "grant": {
          "tool": "write_file"
        },
        "tool": "write_file",
        "target": "C:\\anywhere"
      },
      "expected": true
    },
    {
      "name": "a grant with no target covers a call that names nothing",
      "input": {
        "op": "grantCovers",
        "grant": {
          "tool": "write_file"
        },
        "tool": "write_file",
        "target": null
      },
      "expected": true
    },
    {
      "name": "a grant with a target does not cover a call that names nothing",
      "input": {
        "op": "grantCovers",
        "grant": {
