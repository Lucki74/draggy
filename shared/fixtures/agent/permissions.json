        "reason": "The user has already allowed this."
      }
    },
    {
      "name": "a plain edit with no annotations asks",
      "input": {
        "op": "decide",
        "mode": "ask",
        "tool": "a_tool"
      },
      "expected": {
        "decision": "ask",
