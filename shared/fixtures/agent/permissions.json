    {
      "name": "a command grant with no target keeps nothing",
      "input": {
        "op": "grantsFor",
        "tool": "run_command",
        "target": null,
        "annotations": {
          "executes": true
        }
      },
      "expected": []
    },
    {
      "name": "a file grant keeps its path",
