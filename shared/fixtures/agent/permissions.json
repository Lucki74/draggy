    {
      "name": "a path key wins over a command key",
      "input": {
        "op": "targetFromArgs",
        "args": {
          "command": "ls",
          "path": "p.txt"
        }
      },
      "expected": "p.txt"
    },
    {
      "name": "a target with non-ASCII text",
      "input": {
        "op": "targetFromArgs",
        "args": {
          "file": " notes/日記.md "
        }
      },
      "expected": "notes/日記.md"
    },
    {
      "name": "no target when the call is about nothing",
      "input": {
        "op": "targetFromArgs",
        "args": {
          "query": "weather"
        }
      },
      "expected": null
    },
    {
      "name": "a blank target is no target",
      "input": {
        "op": "targetFromArgs",
        "args": {
          "path": "   "
        }
      },
      "expected": null
    },
    {
      "name": "a non-string target is no target",
      "input": {
        "op": "targetFromArgs",
        "args": {
          "path": 7
        }
      },
      "expected": null
    },
    {
      "name": "the command is what the user is asked about",
      "input": {
        "op": "targetFromArgs",
        "args": {
          "command": "gh pr list"
        }
      },
      "expected": "gh pr list"
    },
    {
      "name": "a refusal in the shape tools answer in",
      "input": {
        "op": "refusal",
        "tool": "write_file",
        "verdict": {
          "decision": "deny",
          "reason": "Because."
        }
      },
      "expected": "TOOL RESULT (write_file): Not allowed. Because."
    },
    {
      "name": "the user declined a tool",
      "input": {
        "op": "denied",
        "tool": "run_command"
      },
      "expected": "TOOL RESULT (run_command): The user declined this. Do not try it again; ask them what to do instead, or carry on without it."
    }
  ]
}
