{
  "area": "providers",
  "description": "The bundled provider catalog (electron/providers/catalog.cjs): one case per entry, the capability lookup by the first pattern that matches, and the bar a catalog entry must meet.",
  "cases": [
    {
      "name": "entry openai",
      "input": {
        "op": "entry",
        "id": "openai"
      },
      "expected": {
        "id": "openai",
        "name": "OpenAI",
        "kind": "cloud",
        "protocol": "openai",
        "baseUrl": "https://api.openai.com/v1",
        "keyUrl": "https://platform.openai.com/api-keys",
        "auth": "bearer",
        "capabilityPatterns": [
          {
            "match": "^(o\\d|gpt-5|gpt-6)",
            "capabilities": [
              "tools",
              "vision",
              "thinking"
            ]
          },
          {
            "match": "^gpt-4(o|\\.1)",
            "capabilities": [
              "tools",
              "vision"
            ]
          },
          {
            "match": "^gpt-",
            "capabilities": [
              "tools"
            ]
          }
        ],
        "defaultModels": [
          "gpt-5.5",
          "gpt-5-mini"
        ],
        "quirks": {
          "maxTokensField": "max_completion_tokens",
          "reasoningEffort": true
        },
        "vendor": "openai"
      }
    },
