{
  "area": "providers",
  "description": "gemini/process.cjs neutralPaths(), settingsFor(), geminiEnv() and constants (fn neutralPaths, settingsFor, geminiEnv, constants).",
  "cases": [
    {
      "name": "linux neutral paths hold no user name",
      "input": {
        "fn": "neutralPaths",
        "instanceId": "acct-1",
        "platformName": "linux",
        "env": {},
        "uid": 1000
      },
      "expected": {
        "link": "/tmp/draggy-1000-gemini-acct-1",
        "cwd": "/tmp/draggy-1000-gemini-acct-1-work"
      }
    },
    {
      "name": "windows neutral paths under ProgramData",
      "input": {
        "fn": "neutralPaths",
        "instanceId": "g1",
        "platformName": "win32",
        "env": {
          "ProgramData": "D:\\PD"
        }
      },
      "expected": {
        "link": "D:\\PD\\Draggy\\gemini-g1",
        "cwd": "D:\\PD\\Draggy\\gemini-g1-work"
      }
    },
    {
      "name": "settings with a model and the tool server",
      "input": {
        "fn": "settingsFor",
        "tools": [
          "read",
          "write"
        ],
        "model": "gemini-3-flash",
        "mcpUrl": "http://127.0.0.1:4000/mcp/abc"
      },
      "expected": {
        "tools": {
          "core": [
            "mcp_draggy_read",
            "mcp_draggy_write"
          ]
        },
        "model": {
          "name": "gemini-3-flash"
        },
        "context": {
          "includeDirectoryTree": false
        },
        "general": {
          "enableAutoUpdate": false,
          "enableAutoUpdateNotification": false,
          "checkpointing": {
            "enabled": false
          }
        },
        "privacy": {
          "usageStatisticsEnabled": false
        },
        "telemetry": {
          "enabled": false
        },
        "skills": {
          "enabled": false
        },
        "hooksConfig": {
          "enabled": false
        },
        "security": {
          "auth": {
            "selectedType": "oauth-personal"
          }
        },
        "mcpServers": {
          "draggy": {
            "httpUrl": "http://127.0.0.1:4000/mcp/abc",
            "timeout": 86400000
          }
        }
      }
    },
    {
      "name": "settings with no model and no tool server",
      "input": {
        "fn": "settingsFor",
        "tools": [],
        "model": "",
        "mcpUrl": ""
      },
      "expected": {
        "tools": {
          "core": []
        },
        "context": {
          "includeDirectoryTree": false
        },
        "general": {
          "enableAutoUpdate": false,
          "enableAutoUpdateNotification": false,
          "checkpointing": {
            "enabled": false
          }
        },
        "privacy": {
          "usageStatisticsEnabled": false
        },
        "telemetry": {
          "enabled": false
        },
        "skills": {
          "enabled": false
        },
        "hooksConfig": {
          "enabled": false
        },
        "security": {
          "auth": {
            "selectedType": "oauth-personal"
          }
        }
      }
    },
    {
      "name": "the environment for a start",
      "input": {
        "fn": "geminiEnv",
        "appData": "/data/Draggy",
        "instanceId": "acct-1",
        "parentEnv": {
          "PATH": "/usr/bin",
          "HOME": "/home/me",
          "GOOGLE_API_KEY": "shell"
        },
        "link": "/tmp/draggy-1000-gemini-acct-1",
        "files": {
          "settings": "/w/.gemini/settings.json",
          "system": "/w/.gemini/system.json",
          "systemDefaults": "/w/.gemini/system-defaults.json",
          "prompt": "/data/run/x.md"
        },
        "noBrowser": false
      },
      "expected": {
        "env": {
          "PATH": "/usr/bin",
          "ELECTRON_RUN_AS_NODE": "1",
          "GEMINI_FORCE_FILE_STORAGE": "true",
          "GEMINI_CLI_TRUST_WORKSPACE": "true",
          "GEMINI_CLI_CUSTOM_HEADERS": "User-Agent: Antigravity/1.15.0",
          "GEMINI_SYSTEM_MD": "/data/run/x.md",
          "GEMINI_CLI_SYSTEM_SETTINGS_PATH": "/w/.gemini/system.json",
          "GEMINI_CLI_SYSTEM_DEFAULTS_PATH": "/w/.gemini/system-defaults.json",
          "HOME": "/tmp/draggy-1000-gemini-acct-1",
          "USERPROFILE": "/tmp/draggy-1000-gemini-acct-1",
          "GEMINI_CLI_HOME": "/tmp/draggy-1000-gemini-acct-1"
        },
        "home": "/data/Draggy/gemini/acct-1"
      }
    },
    {
      "name": "the environment without a browser",
      "input": {
        "fn": "geminiEnv",
        "appData": "/data/Draggy",
        "instanceId": "acct-2",
        "parentEnv": {},
        "link": "/tmp/l",
        "files": null,
        "noBrowser": true
      },
      "expected": {
        "env": {
          "ELECTRON_RUN_AS_NODE": "1",
          "GEMINI_FORCE_FILE_STORAGE": "true",
          "GEMINI_CLI_TRUST_WORKSPACE": "true",
          "GEMINI_CLI_CUSTOM_HEADERS": "User-Agent: Antigravity/1.15.0",
          "NO_BROWSER": "true",
          "HOME": "/tmp/l",
          "USERPROFILE": "/tmp/l",
          "GEMINI_CLI_HOME": "/tmp/l"
        },
        "home": "/data/Draggy/gemini/acct-2"
      }
    },
    {
      "name": "the client handshake",
      "input": {
        "fn": "constants",
        "name": "CLIENT"
      },
      "expected": {
        "protocolVersion": 1,
        "clientCapabilities": {
          "fs": {
            "readTextFile": false,
            "writeTextFile": false
          },
          "terminal": false
        }
      }
    },
    {
      "name": "the start flags",
      "input": {
        "fn": "constants",
        "name": "FLAGS"
      },
      "expected": [
        "--acp",
        "--skip-trust"
      ]
    },
    {
      "name": "the node flags",
      "input": {
        "fn": "constants",
        "name": "NODE_FLAGS"
      },
      "expected": [
        "--use-system-ca"
      ]
    }
  ]
}
