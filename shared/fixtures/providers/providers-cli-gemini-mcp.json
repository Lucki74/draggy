{
  "area": "providers",
  "description": "gemini/mcpHttp.cjs: the tool server's answers to initialize, list, call and refusals, over loopback (fn mcpHttp, driven by a real loopback server in the generator; the route is /mcp/fixture in the fixture).",
  "cases": [
    {
      "name": "initialize answers with the protocol version",
      "input": {
        "fn": "mcpHttp",
        "method": "POST",
        "path": "/mcp/fixture",
        "origin": null,
        "body": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2025-06-18\"}}"
      },
      "expected": {
        "status": 200,
        "contentType": "application/json",
        "body": {
          "jsonrpc": "2.0",
          "id": 1,
          "result": {
            "protocolVersion": "2025-06-18",
            "capabilities": {
              "tools": {}
            },
            "serverInfo": {
              "name": "draggy",
              "version": "1"
            }
          }
        }
      }
    },
    {
      "name": "tools/list offers the endpoint's tools",
      "input": {
        "fn": "mcpHttp",
        "method": "POST",
        "path": "/mcp/fixture",
        "origin": null,
        "body": "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/list\"}"
      },
      "expected": {
        "status": 200,
        "contentType": "application/json",
        "body": {
          "jsonrpc": "2.0",
          "id": 2,
          "result": {
            "tools": [
              {
                "name": "echo",
                "description": "Echoes",
                "inputSchema": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "string"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "name": "tools/call answers over SSE",
      "input": {
        "fn": "mcpHttp",
        "method": "POST",
        "path": "/mcp/fixture",
        "origin": null,
        "body": "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"tools/call\",\"params\":{\"name\":\"echo\",\"arguments\":{\"x\":\"hi\"}}}"
      },
      "expected": {
        "status": 200,
        "contentType": "text/event-stream",
        "body": {
          "event": "message",
          "data": {
            "jsonrpc": "2.0",
            "id": 3,
            "result": {
              "content": [
                {
                  "type": "text",
                  "text": "echo:hi"
                }
              ]
            }
          }
        }
      }
    },
    {
      "name": "a failing call is an error result, not a crash",
      "input": {
        "fn": "mcpHttp",
        "method": "POST",
        "path": "/mcp/fixture",
        "origin": null,
        "body": "{\"jsonrpc\":\"2.0\",\"id\":4,\"method\":\"tools/call\",\"params\":{\"name\":\"boom\",\"arguments\":{}}}"
      },
      "expected": {
        "status": 200,
        "contentType": "text/event-stream",
        "body": {
          "event": "message",
          "data": {
            "jsonrpc": "2.0",
            "id": 4,
            "result": {
              "content": [
                {
                  "type": "text",
                  "text": "The call failed."
                }
              ],
              "isError": true
            }
          }
        }
      }
    },
    {
      "name": "a notification gets 202 and no body",
      "input": {
        "fn": "mcpHttp",
        "method": "POST",
        "path": "/mcp/fixture",
        "origin": null,
        "body": "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}"
      },
      "expected": {
        "status": 202,
        "contentType": "application/json",
        "body": null
      }
    },
    {
      "name": "an unknown method answers an empty result",
      "input": {
        "fn": "mcpHttp",
        "method": "POST",
        "path": "/mcp/fixture",
        "origin": null,
        "body": "{\"jsonrpc\":\"2.0\",\"id\":5,\"method\":\"resources/list\"}"
      },
      "expected": {
        "status": 200,
        "contentType": "application/json",
        "body": {
          "jsonrpc": "2.0",
          "id": 5,
          "result": {}
        }
      }
    },
    {
      "name": "a body that is not JSON is a parse error",
      "input": {
        "fn": "mcpHttp",
        "method": "POST",
        "path": "/mcp/fixture",
        "origin": null,
        "body": "{nope"
      },
      "expected": {
        "status": 400,
        "contentType": "application/json",
        "body": {
          "jsonrpc": "2.0",
          "id": null,
          "error": {
            "code": -32700,
            "message": "Parse error"
          }
        }
      }
    },
    {
      "name": "a browser origin is refused",
      "input": {
        "fn": "mcpHttp",
        "method": "POST",
        "path": "/mcp/fixture",
        "origin": "https://evil.example",
        "body": "{\"jsonrpc\":\"2.0\",\"id\":6,\"method\":\"tools/list\"}"
      },
      "expected": {
        "status": 403,
        "contentType": "application/json",
        "body": null
      }
    },
    {
      "name": "another route is not found",
      "input": {
        "fn": "mcpHttp",
        "method": "POST",
        "path": "/mcp/other",
        "origin": null,
        "body": "{}"
      },
      "expected": {
        "status": 404,
        "contentType": "application/json",
        "body": null
      }
    },
    {
      "name": "a GET on the route is not allowed",
      "input": {
        "fn": "mcpHttp",
        "method": "GET",
        "path": "/mcp/fixture",
        "origin": null,
        "body": null
      },
      "expected": {
        "status": 405,
        "contentType": "application/json",
        "body": null
      }
    }
  ]
}
