{
  "area": "providers",
  "description": "adapters/geminiCli.cjs toPrompt() and turnFailure() (fn toPrompt, turnFailure).",
  "cases": [
    {
      "name": "earlier turns as text, then input text and image",
      "input": {
        "fn": "toPrompt",
        "history": [
          {
            "role": "user",
            "content": "before",
            "draggy_ref": {
              "id": "u0",
              "hash": "h-before"
            }
          }
        ],
        "input": {
          "role": "user",
          "content": [
            {
              "type": "text",
              "text": "now"
            },
            {
              "type": "image_url",
              "image_url": {
                "url": "data:image/jpeg;base64,RkZG"
              }
            }
          ]
        }
      },
      "expected": [
        {
          "type": "text",
          "text": "<conversation_so_far>\nUser: before\n</conversation_so_far>"
        },
        {
          "type": "text",
          "text": "now"
        },
        {
          "type": "image",
          "mimeType": "image/jpeg",
          "data": "RkZG"
        }
      ]
    },
    {
      "name": "an image-only input",
      "input": {
        "fn": "toPrompt",
        "history": [],
        "input": {
          "role": "user",
          "content": [
            {
              "type": "image_url",
              "image_url": {
                "url": "data:image/png;base64,QUJD"
              }
            }
          ]
        }
      },
      "expected": [
        {
          "type": "image",
          "mimeType": "image/png",
          "data": "QUJD"
        }
      ]
    },
    {
      "name": "no input and no history is an empty prompt",
      "input": {
        "fn": "toPrompt",
        "history": [],
        "input": null
      },
      "expected": []
    },
    {
      "name": "quota words are a limit",
      "input": {
        "fn": "turnFailure",
        "error": {
          "message": "RESOURCE_EXHAUSTED: quota"
        }
      },
      "expected": {
        "kind": "account-limit-reached",
        "status": 0,
        "message": "RESOURCE_EXHAUSTED: quota",
        "providerMessage": "RESOURCE_EXHAUSTED: quota"
      }
    },
    {
      "name": "a 429 in the data is a limit",
      "input": {
        "fn": "turnFailure",
        "error": {
          "message": "x",
          "data": "429 retry"
        }
      },
      "expected": {
        "kind": "account-limit-reached",
        "status": 0,
        "message": "x 429 retry",
        "providerMessage": "x 429 retry"
      }
    },
    {
      "name": "unauthenticated is a sign-out, detail taken from data.details",
      "input": {
        "fn": "turnFailure",
        "error": {
          "message": "Unauthenticated",
          "data": {
            "details": "login"
          }
        }
      },
      "expected": {
        "kind": "account-signed-out",
        "status": 0,
        "message": "Unauthenticated login",
        "providerMessage": "Unauthenticated login"
      }
    },
    {
      "name": "overloaded is rate limited",
      "input": {
        "fn": "turnFailure",
        "error": {
          "message": "503 overloaded"
        }
      },
      "expected": {
        "kind": "provider-rate-limited",
        "status": 0,
        "message": "503 overloaded",
        "providerMessage": "503 overloaded"
      }
    },
    {
      "name": "anything else is unknown",
      "input": {
        "fn": "turnFailure",
        "error": {
          "message": "boom"
        }
      },
      "expected": {
        "kind": "provider-unknown-error",
        "status": 0,
        "message": "boom",
        "providerMessage": "boom"
      }
    },
    {
      "name": "no error says the turn failed",
      "input": {
        "fn": "turnFailure",
        "error": {}
      },
      "expected": {
        "kind": "provider-unknown-error",
        "status": 0,
        "message": "The turn failed.",
        "providerMessage": "The turn failed."
      }
    }
  ]
}
