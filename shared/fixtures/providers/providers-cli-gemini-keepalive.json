{
  "area": "providers-cli-gemini-keepalive",
  "description": "gemini/mcpHttp.cjs call stream (fn mcpStream): the head goes out with the call, a keep-alive comment every 30 s while it runs, the answer when it settles, and a client that leaves while it runs is told. Each step is one clock move, settle or close, in order.",
  "cases": [
    {
      "name": "a call answered at once writes the answer and no keep-alive",
      "input": {
        "fn": "mcpStream",
        "request": {
          "method": "POST",
          "path": "/mcp/fixture",
          "origin": null,
          "body": "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"tools/call\",\"params\":{\"name\":\"echo\",\"arguments\":{\"x\":\"hi\"}}}"
        },
        "steps": [
          {
            "settle": {
              "result": {
                "content": [
                  {
                    "type": "text",
                    "text": "hi"
                  }
                ]
              }
            }
          }
        ]
      },
      "expected": {
        "status": 200,
        "contentType": "text/event-stream",
        "frames": [
          "event: message\ndata: {\"jsonrpc\":\"2.0\",\"id\":3,\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"hi\"}]}}\n\n"
        ],
        "closedSignalled": false
      }
    },
    {
      "name": "a call still running gets a keep-alive every thirty seconds",
      "input": {
        "fn": "mcpStream",
        "request": {
          "method": "POST",
          "path": "/mcp/fixture",
          "origin": null,
          "body": "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"tools/call\",\"params\":{\"name\":\"echo\",\"arguments\":{\"x\":\"hi\"}}}"
        },
        "steps": [
          {
            "advance": 30000
          },
          {
            "advance": 30000
          },
          {
            "advance": 30000
          },
          {
            "settle": {
              "result": {
                "content": [
                  {
                    "type": "text",
                    "text": "hi"
                  }
                ]
              }
            }
          }
        ]
      },
      "expected": {
        "status": 200,
        "contentType": "text/event-stream",
        "frames": [
          ": keep-alive\n\n",
          ": keep-alive\n\n",
          ": keep-alive\n\n",
          "event: message\ndata: {\"jsonrpc\":\"2.0\",\"id\":3,\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"hi\"}]}}\n\n"
        ],
        "closedSignalled": false
      }
    },
    {
      "name": "a wait that spans two thirty-second marks writes two keep-alives at once",
      "input": {
        "fn": "mcpStream",
        "request": {
          "method": "POST",
          "path": "/mcp/fixture",
          "origin": null,
          "body": "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"tools/call\",\"params\":{\"name\":\"echo\",\"arguments\":{\"x\":\"hi\"}}}"
        },
        "steps": [
          {
            "advance": 65000
          },
          {
            "settle": {
              "result": {
                "content": [
                  {
                    "type": "text",
                    "text": "hi"
                  }
                ]
              }
            }
          }
        ]
      },
      "expected": {
        "status": 200,
        "contentType": "text/event-stream",
        "frames": [
          ": keep-alive\n\n",
          ": keep-alive\n\n",
          "event: message\ndata: {\"jsonrpc\":\"2.0\",\"id\":3,\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"hi\"}]}}\n\n"
        ],
        "closedSignalled": false
      }
    },
    {
      "name": "a call that fails answers with the call failed result after its keep-alives",
      "input": {
        "fn": "mcpStream",
        "request": {
          "method": "POST",
          "path": "/mcp/fixture",
          "origin": null,
          "body": "{\"jsonrpc\":\"2.0\",\"id\":4,\"method\":\"tools/call\",\"params\":{\"name\":\"echo\",\"arguments\":{\"x\":\"hi\"}}}"
        },
        "steps": [
          {
            "advance": 30000
          },
          {
            "settle": {
              "error": "boom"
            }
          }
        ]
      },
      "expected": {
        "status": 200,
        "contentType": "text/event-stream",
        "frames": [
          ": keep-alive\n\n",
          "event: message\ndata: {\"jsonrpc\":\"2.0\",\"id\":4,\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"The call failed.\"}],\"isError\":true}}\n\n"
        ],
        "closedSignalled": false
      }
    },
    {
      "name": "a client that leaves while the call runs is told, and nothing more is written",
      "input": {
        "fn": "mcpStream",
        "request": {
          "method": "POST",
          "path": "/mcp/fixture",
          "origin": null,
          "body": "{\"jsonrpc\":\"2.0\",\"id\":5,\"method\":\"tools/call\",\"params\":{\"name\":\"echo\",\"arguments\":{\"x\":\"hi\"}}}"
        },
        "steps": [
          {
            "advance": 30000
          },
          {
            "close": true
          }
        ]
      },
      "expected": {
        "status": 200,
        "contentType": "text/event-stream",
        "frames": [
          ": keep-alive\n\n"
        ],
        "closedSignalled": true
      }
    },
    {
      "name": "a client that leaves after the answer is not reported as a cancel",
      "input": {
        "fn": "mcpStream",
        "request": {
          "method": "POST",
          "path": "/mcp/fixture",
          "origin": null,
          "body": "{\"jsonrpc\":\"2.0\",\"id\":6,\"method\":\"tools/call\",\"params\":{\"name\":\"echo\",\"arguments\":{\"x\":\"hi\"}}}"
        },
        "steps": [
          {
            "settle": {
              "result": {
                "content": [
                  {
                    "type": "text",
                    "text": "hi"
                  }
                ]
              }
            }
          },
          {
            "close": true
          }
        ]
      },
      "expected": {
        "status": 200,
        "contentType": "text/event-stream",
        "frames": [
          "event: message\ndata: {\"jsonrpc\":\"2.0\",\"id\":6,\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"hi\"}]}}\n\n"
        ],
        "closedSignalled": false
      }
    }
  ]
}
