          "data: {\"choices\":[{\"index\":0,\"delta\":{\"tool_calls\":[{\"index\":0,\"id\":\"a\",\"type\":\"function\",\"function\":{\"name\":\"read_file\",\"arguments\":\"{\\\"path\\\":\"}}]},\"finish_reason\":null}]}\n\n",
          "data: {\"choices\":[{\"index\":0,\"delta\":{\"tool_calls\":[{\"index\":1,\"id\":\"b\",\"type\":\"function\",\"function\":{\"name\":\"list_dir\",\"arguments\":\"{}\"}}]},\"finish_reason\":null}]}\n\n",
          "data: {\"choices\":[{\"index\":0,\"delta\":{\"tool_calls\":[{\"index\":0,\"function\":{\"arguments\":\"\\\"x\\\"}\"}}]},\"finish_reason\":null}]}\n\n",
          "data: {\"choices\":[{\"index\":0,\"delta\":{},\"finish_reason\":\"tool_calls\"}]}\n\n",
          "data: [DONE]\n\n"
        ]
      },
      "expected": [
        {
          "type": "tool_call_delta",
          "index": 0,
          "id": "a",
          "name": "read_file",
          "arguments": "{\"path\":"
        },
        {
          "type": "tool_call_delta",
          "index": 1,
          "id": "b",
          "name": "list_dir",
          "arguments": "{}"
        },
        {
          "type": "tool_call_delta",
          "index": 0,
          "arguments": "\"x\"}"
        },
        {
          "type": "finish",
          "reason": "tool_calls",
          "usage": {
            "prompt_tokens": 0,
            "output_tokens": 0
          }
        }
      ]
    },
