{
  "area": "providers",
  "description": "Upstream stream into neutral events (adapters/*.cjs translateStream). The input chunks are read as the reference reads them, so a case can split a line or a UTF-8 character across reads. Each event is what the reference handed to its writer; an error ends the list.",
  "cases": [
    {
      "name": "OpenAI: text and reasoning, then the upstream counts",
      "input": {
        "protocol": "openai",
        "chunks": [
          "data: {\"choices\":[{\"index\":0,\"delta\":{\"reasoning_content\":\"think \"},\"finish_reason\":null}]}\n\n",
          "data: {\"choices\":[{\"index\":0,\"delta\":{\"content\":\"Hel\"},\"finish_reason\":null}]}\n\n",
          "data: {\"choices\":[{\"index\":0,\"delta\":{\"content\":\"lo\"},\"finish_reason\":\"stop\"}]}\n\n",
          "data: {\"choices\":[],\"usage\":{\"prompt_tokens\":9,\"completion_tokens\":2}}\n\n",
          "data: [DONE]\n\n"
        ]
      },
      "expected": [
        {
          "type": "reasoning_delta",
          "text": "think "
        },
        {
          "type": "text_delta",
          "text": "Hel"
        },
        {
          "type": "text_delta",
          "text": "lo"
        },
        {
          "type": "finish",
          "reason": "stop",
          "usage": {
            "prompt_tokens": 9,
            "output_tokens": 2
          }
        }
      ]
    },
    {
      "name": "OpenAI: parallel tool calls arrive whole, each once",
      "input": {
        "protocol": "openai",
