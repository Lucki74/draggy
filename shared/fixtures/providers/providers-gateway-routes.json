        "request": {
          "origin": "app://draggy",
          "body": "{\"model\":\"@ollama/qwen3:8b\",\"stream\":true,\"options\":{\"num_ctx\":8192},\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}]}"
        }
      },
      "expected": {
        "status": 200,
        "contentType": "text/event-stream",
        "allowOrigin": "app://draggy",
        "frames": [
          {
            "choices": [
              {
                "index": 0,
                "delta": {
                  "content": "ok"
                },
                "finish_reason": null
              }
            ]
          },
          {
            "choices": [
              {
                "index": 0,
                "delta": {},
                "finish_reason": "stop"
              }
            ],
            "usage": {
              "prompt_tokens": 0,
              "completion_tokens": 0,
              "total_tokens": 0
            }
          },
          "[DONE]"
        ],
        "upstream": [
          {
            "url": "http://127.0.0.1:11434/api/chat",
            "headers": {
              "content-type": "application/json"
            },
            "body": {
              "model": "qwen3:8b",
              "messages": [
                {
                  "role": "user",
                  "content": "hi"
                }
              ],
              "stream": true,
              "options": {
                "num_ctx": 8192
              }
            }
          }
        ],
        "accountCalls": []
