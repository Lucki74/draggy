    {
      "name": "a rate limit is retried, reported with each wait, then streamed",
      "input": {
        "fn": "gatewayRoutes",
        "allowedOrigin": "app://draggy",
        "instances": [
          {
            "type": "custom",
            "baseUrl": "http://up.test/v1",
            "key": "sk-test"
          }
        ],
        "upstream": [
          {
            "status": 429,
            "body": "{\"error\":{\"message\":\"Rate limit reached\"}}",
            "headers": {
              "Retry-After": "0"
            }
          },
          {
            "status": 503,
            "body": "{\"error\":{\"message\":\"busy\"}}",
            "headers": {
              "Retry-After": "0"
            }
          },
          {
            "contentType": "text/event-stream",
            "body": "data: {\"choices\":[{\"index\":0,\"delta\":{\"content\":\"Hello\"},\"finish_reason\":\"stop\"}]}\n\ndata: [DONE]\n\n"
          }
        ],
        "request": {
          "origin": "app://draggy",
          "body": "{\"model\":\"@custom/m\",\"stream\":true,\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}]}"
        }
      },
      "expected": {
        "status": 200,
        "contentType": "text/event-stream",
        "allowOrigin": "app://draggy",
        "frames": [
          {
            "draggy_retry": {
              "attempt": 1,
              "of": 2,
              "retryAfterMs": 0
            }
          },
          {
            "draggy_retry": {
              "attempt": 2,
              "of": 2,
              "retryAfterMs": 0
            }
          },
          {
            "choices": [
              {
                "index": 0,
                "delta": {
                  "content": "Hello"
                },
                "finish_reason": null
              }
            ]
          },
          {
            "choices": [
              {
                "index": 0,
