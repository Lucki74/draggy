{
  "area": "providers",
  "description": "gateway.cjs createGateway(): refusals, routing of provider models to each adapter, retries, failures and both answer forms, driven against a scripted fetch. Stream bodies are SSE frames with the timings field removed (fn gatewayRoutes).",
  "cases": [
    {
      "name": "refuses a foreign origin before anything else",
      "input": {
        "fn": "gatewayRoutes",
        "allowedOrigin": "app://draggy",
        "instances": [],
        "request": {
          "origin": "https://evil.example",
          "body": "{}"
        }
      },
      "expected": {
        "status": 403,
        "contentType": "application/json",
        "allowOrigin": null,
        "json": {
          "error": {
            "kind": "provider-unknown-error",
            "message": "This origin may not use the gateway."
          }
        },
        "upstream": [],
        "accountCalls": []
      }
    },
    {
      "name": "refuses the null origin",
      "input": {
        "fn": "gatewayRoutes",
        "allowedOrigin": "app://draggy",
        "instances": [],
        "request": {
          "origin": "null",
          "body": "{}"
        }
      },
      "expected": {
        "status": 403,
        "contentType": "application/json",
        "allowOrigin": null,
        "json": {
          "error": {
            "kind": "provider-unknown-error",
            "message": "This origin may not use the gateway."
          }
        },
        "upstream": [],
        "accountCalls": []
      }
    },
    {
      "name": "answers the preflight for its own origin",
      "input": {
        "fn": "gatewayRoutes",
        "allowedOrigin": "app://draggy",
        "instances": [],
        "request": {
          "origin": "app://draggy",
          "method": "OPTIONS"
        }
      },
      "expected": {
        "status": 204,
        "contentType": null,
        "allowOrigin": "app://draggy",
        "text": "",
        "upstream": [],
        "accountCalls": []
      }
    },
    {
      "name": "answers an unknown method on the chat endpoint with 404",
      "input": {
        "fn": "gatewayRoutes",
        "allowedOrigin": "app://draggy",
        "instances": [],
        "request": {
          "origin": "app://draggy",
          "method": "GET",
          "body": null
        }
      },
      "expected": {
        "status": 404,
        "contentType": "application/json",
        "allowOrigin": "app://draggy",
        "json": {
          "error": {
            "kind": "provider-unknown-error",
            "message": "Unknown gateway endpoint."
          }
        },
        "upstream": [],
        "accountCalls": []
      }
    },
    {
      "name": "answers an unknown endpoint with 404",
      "input": {
        "fn": "gatewayRoutes",
        "allowedOrigin": "app://draggy",
        "instances": [],
        "request": {
          "origin": "app://draggy",
          "url": "draggy-ai://models",
          "body": "{}"
        }
      },
      "expected": {
        "status": 404,
        "contentType": "application/json",
        "allowOrigin": "app://draggy",
        "json": {
          "error": {
            "kind": "provider-unknown-error",
            "message": "Unknown gateway endpoint."
          }
        },
        "upstream": [],
        "accountCalls": []
      }
    },
    {
      "name": "a provider model with no instance set up is refused, nothing sent",
      "input": {
        "fn": "gatewayRoutes",
        "allowedOrigin": "app://draggy",
        "instances": [],
        "request": {
          "origin": "app://draggy",
          "body": "{\"model\":\"@anthropic/claude-x\"}"
        }
      },
      "expected": {
        "status": 404,
        "contentType": "application/json",
        "allowOrigin": "app://draggy",
        "json": {
          "error": {
            "kind": "provider-unknown-error",
            "message": "No enabled provider is set up for @anthropic/claude-x."
          }
        },
        "upstream": [],
        "accountCalls": []
      }
    },
    {
      "name": "a reference with no model part is refused",
      "input": {
