          {
            "type": "custom",
            "baseUrl": "http://up.test/v1",
            "key": "k"
          }
        ],
        "request": {
          "origin": "app://draggy",
          "body": "{\"model\":\"@custom\"}"
        }
      },
      "expected": {
        "status": 404,
        "contentType": "application/json",
        "allowOrigin": "app://draggy",
        "json": {
          "error": {
            "kind": "provider-unknown-error",
            "message": "No enabled provider is set up for @custom."
          }
        },
        "upstream": [],
        "accountCalls": []
      }
    },
    {
      "name": "a switched-off instance is refused, nothing sent",
      "input": {
        "fn": "gatewayRoutes",
        "allowedOrigin": "app://draggy",
        "instances": [
