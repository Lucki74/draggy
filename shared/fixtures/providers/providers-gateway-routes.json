          "origin": "app://draggy",
          "body": "{\"model\":\"@ollama/qwen3:8b\"}"
        }
      },
      "expected": {
        "status": 404,
        "contentType": "application/json",
        "allowOrigin": "app://draggy",
        "json": {
          "error": {
            "kind": "provider-unknown-error",
            "message": "No enabled provider is set up for @ollama/qwen3:8b."
          }
        },
        "upstream": [],
        "accountCalls": []
      }
    },
    {
      "name": "an OpenAI-compatible instance: its own address, Draggy's fields left behind, streamed back",
      "input": {
        "fn": "gatewayRoutes",
        "allowedOrigin": "app://draggy",
        "instances": [
          {
            "type": "custom",
            "baseUrl": "http://up.test/v1",
            "key": "sk-test"
          }
        ],
        "upstream": [
          {
            "contentType": "text/event-stream",
            "body": "data: {\"choices\":[{\"index\":0,\"delta\":{\"content\":\"Hello\"},\"finish_reason\":null}]}\n\ndata: {\"choices\":[{\"index\":0,\"delta\":{},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":4,\"completion_tokens\":1}}\n\ndata: [DONE]\n\n"
          }
        ],
        "request": {
          "origin": "app://draggy",
          "body": "{\"model\":\"@custom/some/model\",\"stream\":true,\"think\":true,\"options\":{\"num_ctx\":8192,\"num_predict\":-1},\"messages\":[{\"role\":\"user\",\"content\":\"hi\",\"draggy_ref\":{\"id\":\"u1\",\"hash\":\"h\"}}]}"
        }
      },
      "expected": {
        "status": 200,
        "contentType": "text/event-stream",
        "allowOrigin": "app://draggy",
        "frames": [
          {
            "choices": [
              {
                "index": 0,
                "delta": {
                  "content": "Hello"
                },
                "finish_reason": null
              }
            ]
          },
          {
            "choices": [
              {
                "index": 0,
                "delta": {},
                "finish_reason": "stop"
              }
            ],
            "usage": {
              "prompt_tokens": 4,
              "completion_tokens": 1,
              "total_tokens": 5
            }
          },
          "[DONE]"
        ],
        "upstream": [
          {
            "url": "http://up.test/v1/chat/completions",
            "headers": {
              "content-type": "application/json",
              "authorization": "Bearer sk-test"
            },
            "body": {
              "model": "some/model",
              "messages": [
                {
                  "role": "user",
                  "content": "hi"
                }
              ],
              "stream": true,
              "stream_options": {
                "include_usage": true
              }
            }
          }
        ],
        "accountCalls": []
      }
    },
    {
      "name": "a request id travels upstream",
      "input": {
        "fn": "gatewayRoutes",
        "allowedOrigin": "app://draggy",
        "instances": [
          {
            "type": "custom",
            "baseUrl": "http://up.test/v1",
            "key": "sk-test"
          }
        ],
        "upstream": [
          {
            "contentType": "text/event-stream",
            "body": "data: {\"choices\":[{\"index\":0,\"delta\":{\"content\":\"ok\"},\"finish_reason\":\"stop\"}]}\n\ndata: [DONE]\n\n"
          }
        ],
        "request": {
          "origin": "app://draggy",
          "requestId": "cid-7",
          "body": "{\"model\":\"@custom/m\",\"stream\":true,\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}]}"
        }
      },
      "expected": {
        "status": 200,
        "contentType": "text/event-stream",
        "allowOrigin": "app://draggy",
        "frames": [
          {
            "choices": [
              {
                "index": 0,
                "delta": {
                  "content": "ok"
                },
                "finish_reason": null
              }
            ]
          },
          {
            "choices": [
              {
                "index": 0,
                "delta": {},
                "finish_reason": "stop"
              }
            ],
            "usage": {
              "prompt_tokens": 0,
              "completion_tokens": 0,
              "total_tokens": 0
            }
          },
          "[DONE]"
        ],
        "upstream": [
          {
            "url": "http://up.test/v1/chat/completions",
            "headers": {
              "x-request-id": "cid-7",
              "content-type": "application/json",
              "authorization": "Bearer sk-test"
            },
            "body": {
              "model": "m",
              "messages": [
                {
                  "role": "user",
                  "content": "hi"
                }
              ],
              "stream": true,
              "stream_options": {
                "include_usage": true
              }
            }
          }
        ],
        "accountCalls": []
      }
    },
    {
