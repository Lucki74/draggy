{
  "area": "providers",
  "description": "claude/binary.cjs assetFor() and installDir(): the pinned build per platform, musl included (fn assetFor, installDir).",
  "cases": [
    {
      "name": "linux x64 glibc",
      "input": {
        "fn": "assetFor",
        "platformName": "linux",
        "arch": "x64",
        "musl": false
      },
      "expected": {
        "name": "claude",
        "url": "https://downloads.claude.ai/claude-code-releases/2.1.284/linux-x64/claude",
        "sha256": "5cd90aabd83f8a15136c35aa37bb1d92b348993573316643dc3fe4e04afbf88f",
        "size": 243059896
      }
    },
    {
      "name": "linux x64 musl",
      "input": {
        "fn": "assetFor",
        "platformName": "linux",
        "arch": "x64",
        "musl": true
      },
      "expected": {
        "name": "claude",
        "url": "https://downloads.claude.ai/claude-code-releases/2.1.284/linux-x64-musl/claude",
        "sha256": "1c5e4d7431c1e70c45efdce69ea74c2c9a2ad309f16555f7dc563f4743d978a0",
        "size": 236810328
      }
    },
    {
      "name": "linux arm64 musl",
      "input": {
        "fn": "assetFor",
        "platformName": "linux",
        "arch": "arm64",
        "musl": true
      },
      "expected": {
        "name": "claude",
        "url": "https://downloads.claude.ai/claude-code-releases/2.1.284/linux-arm64-musl/claude",
        "sha256": "d8bce5724ecd1e6930ddf5f4cef7cebb0cd3e50b4f5d5158b30a53f81824f982",
        "size": 234764096
      }
    },
    {
      "name": "windows names the exe",
      "input": {
        "fn": "assetFor",
        "platformName": "win32",
        "arch": "x64",
        "musl": false
      },
      "expected": {
        "name": "claude.exe",
        "url": "https://downloads.claude.ai/claude-code-releases/2.1.284/win32-x64/claude.exe",
        "sha256": "0416631e846f743110da5282409776fa1313e65f33a588aae066eaf8db0fda7d",
        "size": 246480032
      }
    },
    {
      "name": "musl only changes linux",
      "input": {
        "fn": "assetFor",
        "platformName": "win32",
        "arch": "x64",
        "musl": true
      },
      "expected": {
        "name": "claude.exe",
        "url": "https://downloads.claude.ai/claude-code-releases/2.1.284/win32-x64/claude.exe",
        "sha256": "0416631e846f743110da5282409776fa1313e65f33a588aae066eaf8db0fda7d",
        "size": 246480032
      }
    },
    {
      "name": "darwin arm64",
      "input": {
        "fn": "assetFor",
        "platformName": "darwin",
        "arch": "arm64",
        "musl": false
      },
      "expected": {
        "name": "claude",
        "url": "https://downloads.claude.ai/claude-code-releases/2.1.284/darwin-arm64/claude",
        "sha256": "50a14c2f50f56668380fdda490167f1d3630d5cc18fb8aed3073c2c7ea7314fe",
        "size": 226563088
      }
    },
    {
      "name": "a platform with no build",
      "input": {
        "fn": "assetFor",
        "platformName": "freebsd",
        "arch": "x64",
        "musl": false
      },
      "expected": null
    },
    {
      "name": "the install folder is under the pinned version",
      "input": {
        "fn": "installDir",
        "appData": "/data/Draggy"
      },
      "expected": "/data/Draggy/claude/bin/2.1.284"
    }
