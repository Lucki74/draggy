    {
      "name": "an instance id may not leave the app folder",
      "input": {
        "fn": "privateHome",
        "runtime": "codex",
        "appData": "/data/Draggy",
        "instanceId": "../../.codex"
      },
      "expected": {
        "error": "An instance id names one folder, nothing more"
      }
    },
    {
      "name": "an empty instance id is refused",
      "input": {
        "fn": "privateHome",
        "runtime": "codex",
        "appData": "/data/Draggy",
