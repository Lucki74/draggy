    {
      "name": "an unknown runtime is refused",
      "input": {
        "fn": "privateHome",
        "runtime": "other",
        "appData": "/data/Draggy",
        "instanceId": "a"
      },
      "expected": {
        "error": "Unknown account runtime: other"
      }
    },
    {
      "name": "a private home is one folder per runtime and instance",
      "input": {
        "fn": "privateHome",
        "runtime": "gemini",
        "appData": "/data/Draggy",
        "instanceId": "acct-9"
      },
      "expected": {
        "home": "/data/Draggy/gemini/acct-9"
