{
  "area": "providers",
  "description": "account/env.cjs accountEnv() and privateHome(): the environment a runtime starts with, or the error it throws (fn accountEnv, privateHome).",
  "cases": [
    {
      "name": "keeps only what a runtime needs to start",
      "input": {
        "fn": "accountEnv",
        "runtime": "codex",
        "appData": "/data/Draggy",
        "instanceId": "acct-1",
        "parent": {
          "Path": "C:\\Windows\\system32",
          "SystemRoot": "C:\\Windows",
          "TEMP": "C:\\Temp",
          "TMP": "C:\\Temp",
          "USERPROFILE": "C:\\Users\\me",
          "HOME": "C:\\Users\\me",
          "CODEX_HOME": "C:\\Users\\me\\.codex",
          "CLAUDE_CONFIG_DIR": "C:\\Users\\me\\.claude",
          "GEMINI_CLI_HOME": "C:\\Users\\me",
          "HTTPS_PROXY": "http://proxy:8080",
          "http_proxy": "http://proxy:8080",
          "ALL_PROXY": "socks5://proxy:1080",
          "NO_PROXY": "localhost",
          "NODE_OPTIONS": "--require evil.js",
          "OPENAI_API_KEY": "from-the-shell",
          "OPENAI_BASE_URL": "from-the-shell",
          "CODEX_API_KEY": "from-the-shell",
          "ANTHROPIC_API_KEY": "from-the-shell",
          "ANTHROPIC_AUTH_TOKEN": "from-the-shell",
          "ANTHROPIC_BASE_URL": "from-the-shell",
          "CLAUDE_CODE_USE_BEDROCK": "from-the-shell",
          "CLAUDE_CODE_USE_VERTEX": "from-the-shell",
          "CLAUDE_CODE_OAUTH_TOKEN": "from-the-shell",
          "CLAUDE_SECURESTORAGE_CONFIG_DIR": "from-the-shell",
          "GEMINI_API_KEY": "from-the-shell",
          "GOOGLE_API_KEY": "from-the-shell",
          "GOOGLE_GENAI_USE_VERTEXAI": "from-the-shell",
          "GOOGLE_CLOUD_PROJECT": "from-the-shell",
          "GOOGLE_APPLICATION_CREDENTIALS": "from-the-shell"
        }
      },
      "expected": {
        "env": {
          "PATH": "C:\\Windows\\system32",
          "SystemRoot": "C:\\Windows",
          "TEMP": "C:\\Temp",
          "TMP": "C:\\Temp",
          "HOME": "/data/Draggy/codex/acct-1",
          "USERPROFILE": "/data/Draggy/codex/acct-1",
          "CODEX_HOME": "/data/Draggy/codex/acct-1"
        },
        "home": "/data/Draggy/codex/acct-1"
      }
    },
