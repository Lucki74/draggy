{
  "area": "documents",
  "description": "officeStyle.cjs: the unit helpers pt and twips (JavaScript Math.round, which rounds halves up), the typeface and colour constants, the docx style and numbering templates, and the table border. Heading templates are checked through DOCX_STYLES.",
  "cases": [
    {
      "name": "pt is half points",
      "input": {
        "fn": "pt",
        "args": [
          9.5
        ]
      },
      "expected": 19
    },
    {
      "name": "pt of a whole size",
      "input": {
        "fn": "pt",
        "args": [
          11
        ]
      },
      "expected": 22
    },
    {
      "name": "pt of zero",
      "input": {
        "fn": "pt",
        "args": [
          0
        ]
      },
      "expected": 0
    },
    {
      "name": "twips of spacing",
      "input": {
        "fn": "twips",
        "args": [
          8
        ]
      },
      "expected": 160
    },
    {
      "name": "twips of a fraction",
      "input": {
        "fn": "twips",
        "args": [
          1.25
        ]
      },
      "expected": 25
    },
    {
      "name": "twips rounds a negative half toward plus infinity",
      "input": {
        "fn": "twips",
        "args": [
          -0.125
        ]
      },
      "expected": -2
    },
    {
      "name": "twips rounds a positive half up",
      "input": {
        "fn": "twips",
        "args": [
          0.025
        ]
      },
      "expected": 1
    },
    {
      "name": "constants",
      "input": {
        "fn": "constants",
        "args": []
      },
      "expected": {
        "BODY_FONT": "Aptos",
        "HEADING_FONT": "Aptos Display",
        "SHEET_FONT": "Aptos Narrow",
        "MONO_FONT": "Cascadia Mono",
        "HEADING_COLOR": "000000"
      }
    },
