      }
    },
    {
      "name": "a workbook keeps numbers as numbers",
      "input": {
        "fn": "writeGeneratedFile",
        "args": [
          "book.xlsx",
          "name,amount\nrent,1200.5\n,-3\n"
        ]
      },
      "expected": {
        "parts": [
          "[Content_Types].xml",
          "_rels/.rels",
          "xl/workbook.xml",
          "xl/_rels/workbook.xml.rels",
          "xl/styles.xml",
          "xl/worksheets/sheet1.xml"
        ],
        "sheets": [
          {
            "name": "Sheet1",
            "rows": [
              [
                {
                  "v": "name",
                  "bold": true,
                  "font": "Aptos Narrow"
                },
                {
                  "v": "amount",
                  "bold": true,
                  "font": "Aptos Narrow"
                }
              ],
              [
                {
                  "v": "rent",
                  "bold": false,
                  "font": "Aptos Narrow"
                },
                {
                  "v": 1200.5,
                  "bold": false,
                  "font": "Aptos Narrow"
                }
              ],
              [
                {
                  "v": "",
                  "bold": false,
                  "font": "Aptos Narrow"
                },
                {
                  "v": -3,
                  "bold": false,
                  "font": "Aptos Narrow"
                }
              ]
            ]
          }
        ]
      }
    },
    {
      "name": "a deck is built from markdown slides",
      "input": {
        "fn": "writeGeneratedFile",
        "args": [
          "deck.pptx",
          "# Plan\n\n- one\n- two\n\n# Next\n\nReview on Friday"
        ]
      },
      "expected": {
        "parts": [
          "[Content_Types].xml",
          "_rels/.rels",
          "ppt/presentation.xml",
          "ppt/_rels/presentation.xml.rels",
          "ppt/theme/theme1.xml",
          "ppt/slideMasters/slideMaster1.xml",
          "ppt/slideLayouts/slideLayout1.xml",
          "ppt/slides/slide1.xml",
          "ppt/slides/slide2.xml",
          "ppt/slides/_rels/slide1.xml.rels",
          "ppt/slides/_rels/slide2.xml.rels"
        ],
        "slides": [
          {
            "shapes": [
              {
                "box": [
                  0.5,
                  0.4,
                  9,
                  0.8
                ],
                "anchor": "t",
                "size": 28,
                "bold": true,
                "font": "Aptos Display",
                "color": "000000",
                "text": [
                  "Plan"
                ]
              },
              {
                "box": [
                  0.5,
                  1.4,
                  9,
                  3.7
                ],
                "anchor": "t",
                "size": 16,
                "bold": false,
                "font": "Aptos",
                "color": "000000",
                "text": [
                  "• one",
                  "• two"
                ]
              }
            ]
          },
          {
            "shapes": [
              {
                "box": [
                  0.5,
                  0.4,
                  9,
                  0.8
                ],
                "anchor": "t",
                "size": 28,
                "bold": true,
                "font": "Aptos Display",
                "color": "000000",
                "text": [
                  "Next"
                ]
              },
              {
                "box": [
                  0.5,
                  1.4,
                  9,
                  3.7
                ],
                "anchor": "t",
                "size": 16,
                "bold": false,
                "font": "Aptos",
                "color": "000000",
                "text": [
                  "Review on Friday"
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "name": "a written docx reads back as its text",
      "input": {
        "fn": "writeThenRead",
        "args": [
          "report.docx",
          "# Title\n\nSome **bold** text.\n\n- one"
        ]
      },
      "expected": "Title\n\nSome bold text.\n\none\n"
    },
    {
      "name": "a written deck reads back slide by slide",
      "input": {
        "fn": "writeThenRead",
        "args": [
          "deck.pptx",
          "# Plan\n\n- one\n- two\n\n# Next\n\nReview on Friday"
        ]
      },
      "expected": "--- Slide 1 ---\nPlan\n• one\n• two\n\n--- Slide 2 ---\nNext\nReview on Friday"
    },
    {
      "name": "a written workbook reads back as csv",
      "input": {
        "fn": "writeThenRead",
        "args": [
          "book.xlsx",
          "name,amount\nrent,1200.5\n,-3"
        ]
      },
      "expected": "--- Sheet: Sheet1 ---\nname,amount\nrent,1200.5\n,-3"
    },
    {
      "name": "cells with commas and quotes read back quoted",
      "input": {
        "fn": "writeThenRead",
        "args": [
          "book.xlsx",
          "\"x,y\",plain\n"
        ]
      },
      "expected": "--- Sheet: Sheet1 ---\n\"x,y\",plain"
    },
    {
      "name": "a text file has no reader",
      "input": {
        "fn": "writeThenRead",
        "args": [
          "notes.txt",
          "hello"
        ]
      },
      "expected": {
        "error": "Unsupported document type"
      }
    }
  ]
}
