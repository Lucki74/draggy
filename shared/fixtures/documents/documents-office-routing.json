{
  "area": "documents-office-routing",
  "description": "Writes through the extension routing and reads them back. writeGeneratedFile reduces an Office file to its structure, as the writer cases do, and keeps other files as text. writeThenRead writes a file, then extracts its text.",
  "cases": [
    {
      "name": "markup in a markdown file is written as the text it is",
      "input": {
        "fn": "writeGeneratedFile",
        "args": [
          "notes.md",
          "# Title\n\n**bold** & <b>raw</b>"
        ]
      },
      "expected": "# Title\n\n**bold** & <b>raw</b>"
    },
    {
      "name": "a csv file is written as the text it is",
      "input": {
        "fn": "writeGeneratedFile",
        "args": [
          "data.csv",
          "a,b\n1,2\n"
        ]
      },
      "expected": "a,b\n1,2\n"
    },
    {
      "name": "an extension is matched whatever its case",
      "input": {
        "fn": "writeGeneratedFile",
        "args": [
          "REPORT.DOCX",
          "# Title\n\nBody text."
        ]
      },
      "expected": {
        "parts": [
          "[Content_Types].xml",
          "_rels/.rels",
          "word/document.xml",
          "word/styles.xml",
          "word/numbering.xml",
          "word/_rels/document.xml.rels"
        ],
        "body": {
          "font": "Aptos",
          "size": 22,
          "color": "000000",
          "after": 160,
          "line": 276
        },
        "styles": {
          "Title": {
            "font": "Aptos Display",
            "size": 56,
            "bold": true,
            "color": "000000",
            "before": null,
            "after": 240
          },
          "Heading1": {
            "font": "Aptos Display",
            "size": 40,
            "bold": true,
            "color": "000000",
            "before": 320,
            "after": 80
          },
          "Heading2": {
            "font": "Aptos Display",
            "size": 32,
            "bold": true,
            "color": "000000",
            "before": 280,
            "after": 80
          },
          "Heading3": {
            "font": "Aptos Display",
            "size": 28,
            "bold": true,
            "color": "000000",
            "before": 240,
            "after": 80
          },
          "Heading4": {
            "font": "Aptos Display",
            "size": 24,
            "bold": true,
            "color": "000000",
            "before": 200,
            "after": 80
          },
          "Heading5": {
            "font": "Aptos Display",
            "size": 22,
            "bold": true,
            "color": "000000",
            "before": 200,
            "after": 80
          },
          "Heading6": {
            "font": "Aptos Display",
            "size": 22,
            "bold": true,
            "color": "000000",
            "before": 200,
            "after": 80
          }
        },
        "paragraphs": [
          {
            "text": "Title",
            "style": "Heading1",
            "list": null,
            "border": false,
            "runs": [
              {
                "text": "Title",
                "bold": false,
                "italic": false,
                "font": null
              }
            ]
          },
          {
            "text": "",
            "style": null,
            "list": null,
            "border": false,
            "runs": [
              {
                "text": "",
                "bold": false,
                "italic": false,
                "font": null
              }
            ]
          },
          {
            "text": "Body text.",
            "style": null,
            "list": null,
            "border": false,
            "runs": [
              {
                "text": "Body text.",
                "bold": false,
                "italic": false,
                "font": null
              }
            ]
          }
        ]
      }
    },
