                  {
                    "type": "text",
                    "text": "a"
                  }
                ]
              }
            ]
          },
          {
            "type": "element",
            "tag": "section",
            "attrs": {},
            "style": {},
            "children": [
              {
                "type": "text",
                "text": "b"
              }
            ]
          }
        ]
      }
    },
    {
      "name": "rule closes an open list item",
      "input": {
        "fn": "parseHtml",
        "args": [
