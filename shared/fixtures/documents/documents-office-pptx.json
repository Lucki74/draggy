{
  "area": "documents",
  "description": "writePptx: markdown in, the structure of the generated .pptx out (parts, slides with text boxes, geometry and first run style). Compared by structure, not bytes.",
  "cases": [
    {
      "name": "a slide starts at each heading",
      "input": {
        "fn": "writePptx",
        "args": [
          "# One\nbody a\n\n# Two\nbody b"
        ]
      },
      "expected": {
        "parts": [
          "[Content_Types].xml",
          "_rels/.rels",
          "ppt/presentation.xml",
          "ppt/_rels/presentation.xml.rels",
          "ppt/theme/theme1.xml",
          "ppt/slideMasters/slideMaster1.xml",
          "ppt/slideLayouts/slideLayout1.xml",
          "ppt/slides/slide1.xml",
          "ppt/slides/slide2.xml",
          "ppt/slides/_rels/slide1.xml.rels",
          "ppt/slides/_rels/slide2.xml.rels"
        ],
        "slides": [
          {
            "shapes": [
              {
                "box": [
                  0.5,
                  0.4,
                  9,
                  0.8
                ],
                "anchor": "t",
                "size": 28,
                "bold": true,
                "font": "Aptos Display",
                "color": "000000",
                "text": [
                  "One"
                ]
              },
              {
                "box": [
                  0.5,
                  1.4,
                  9,
                  3.7
                ],
                "anchor": "t",
                "size": 16,
                "bold": false,
                "font": "Aptos",
                "color": "000000",
                "text": [
                  "body a"
                ]
              }
            ]
          },
          {
            "shapes": [
              {
                "box": [
                  0.5,
                  0.4,
                  9,
                  0.8
                ],
                "anchor": "t",
                "size": 28,
                "bold": true,
                "font": "Aptos Display",
                "color": "000000",
                "text": [
                  "Two"
                ]
              },
              {
                "box": [
                  0.5,
                  1.4,
                  9,
                  3.7
                ],
                "anchor": "t",
                "size": 16,
                "bold": false,
                "font": "Aptos",
                "color": "000000",
                "text": [
                  "body b"
                ]
              }
            ]
          }
        ]
      }
    },
    {
